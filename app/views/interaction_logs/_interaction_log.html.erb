<div id="<%= dom_id(interaction_log) %>" class="flex gap-3 border-b border-[#E9EBED] px-5 py-4 last:border-b-0 dark:border-white/10">
  <%= image_tag user_avatar_url(interaction_log.user, size: 64), size: 32,
      class: "h-8 w-8 shrink-0 rounded-full object-cover", alt: interaction_log.user.full_name,
      title: "Logged by #{interaction_log.user.full_name}" %>

  <div class="min-w-0 flex-1">
    <div class="flex items-center justify-between gap-2">
      <p class="flex min-w-0 items-center gap-1.5 text-[13px]">
        <span class="truncate font-semibold"><%= interaction_log.user.full_name %></span>
        <span class="shrink-0 text-[#c3c9c5]">·</span>
        <span class="shrink-0 tabular-nums text-[#8a938d] dark:text-[#9AA6A0]"><%= time_ago_in_words(interaction_log.created_at) %> ago</span>
      </p>
      <% if can_edit_log?(interaction_log) %>
        <span class="flex shrink-0 items-center gap-1">
          <%= link_to edit_interaction_log_path(interaction_log), data: { turbo_frame: "modal" }, title: "Edit", class: "flex h-8 w-8 items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-[#E9EBED] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:bg-white/10 dark:hover:text-[#E7ECE9]" do %><%= icon("pen", css: "h-4 w-4") %><% end %>
          <%= link_to confirm_delete_interaction_log_path(interaction_log), data: { turbo_frame: "modal" }, title: "Delete", class: "flex h-8 w-8 items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-red-50 hover:text-red-700 dark:text-[#9AA6A0] dark:hover:bg-red-500/10 dark:hover:text-red-400" do %><%= icon("trash-2", css: "h-4 w-4") %><% end %>
        </span>
      <% end %>
    </div>

    <% if interaction_log.follow_up_task&.invitation&.event %>
      <%= link_to event_path(interaction_log.follow_up_task.invitation.event), data: { turbo_frame: "_top" },
          class: "mt-1.5 inline-flex items-center gap-1 rounded-full border border-[#A2E494] bg-algae-50 px-2.5 py-0.5 text-xs font-semibold text-algae-900 hover:underline dark:bg-algae-600/15 dark:text-algae-300" do %>
        <%= icon("calendar-range", css: "h-3 w-3") %><%= interaction_log.follow_up_task.invitation.event.name %>
      <% end %>
    <% end %>

    <p class="mt-1.5 whitespace-pre-wrap break-words text-sm leading-relaxed"><%= interaction_log.note %></p>
  </div>
</div>
