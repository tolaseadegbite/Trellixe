<div id="<%= dom_id(interaction_log) %>" class="flex gap-3 p-4 border-be hover:bg-surface transition">
  <%# 1. Avatar of the Team Member who logged it %>
  <div class="flex flex-item-no-shrink items-center justify-center font-bold text-xs text-reversed rounded-full bg-teal-600" 
       style="inline-size: 2rem; block-size: 2rem;"
       title="Logged by <%= interaction_log.user.full_name %>">
    <%= interaction_log.user.initials %>
  </div>

  <div class="flex flex-col gap-1 i-full">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="font-semibold text-sm"><%= interaction_log.user.full_name %></span>
        <span class="text-xs text-subtle">•</span>
        <span class="text-xs text-subtle"><%= time_ago_in_words(interaction_log.created_at) %> ago</span>
      </div>
      
      <%# Context Badge (e.g. "Lagos Tech Summit") %>
      <% if interaction_log.follow_up_task&.invitation&.event %>
        <span class="text-xs bg-shade pi-2 pb-1 rounded-md border border-main text-subtle">
          <%= interaction_log.follow_up_task.invitation.event.name %>
        </span>
      <% end %>
    </div>

    <%# The Note Content %>
    <div class="text-sm text-primary whitespace-pre-wrap"><%= interaction_log.note %></div>
  </div>
</div>