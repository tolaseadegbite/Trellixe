<%= turbo_stream.remove @follow_up_task %>

<%= turbo_stream.replace dom_id(@follow_up_task, :past) do %>
  <%= render "follow_up_tasks/past_task", task: @follow_up_task %>
<% end %>

<% invitation = @follow_up_task.invitation %>
<%= turbo_stream.prepend dom_id(invitation, :logs) do %>
  <%= render "log_invitation_row", log: @interaction_log, prefix: :desktop %>
<% end %>

<%= turbo_stream.prepend "flash", partial: "shared/flash", locals: { notice: "Follow-up successfully logged!" } %>

<%# When logging from the follow-up queue, advance it in place. %>
<% if @queue %>
  <%= turbo_stream.replace "follow_up_queue", partial: "follow_up_tasks/queue", locals: { queue: @queue, pagy: @pagy, context: @queue_context } %>
<% end %>
