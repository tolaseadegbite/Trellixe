<div id="<%= dom_id(log, local_assigns[:prefix] || :desktop) %>" class="flex items-start gap-2.5 py-2.5">
  <%= image_tag user_avatar_url(log.user, size: 40), size: 20, class: "mt-0.5 h-5 w-5 shrink-0 rounded-full object-cover", alt: log.user.full_name %>

  <div class="min-w-0 flex-1">
    <p class="flex flex-wrap items-baseline gap-x-1.5 text-[13px]">
      <span class="font-semibold text-algae-900 dark:text-algae-300"><%= log.user.full_name %></span>
      <span class="text-[#8a938d] dark:text-[#9AA6A0]">followed up with</span>
      <%= link_to log.contact.full_name, contact_path(log.contact), class: "font-semibold text-algae-900 hover:underline dark:text-algae-300", data: { turbo_frame: "_top" } %>
      <span class="text-xs tabular-nums text-[#8a938d] dark:text-[#9AA6A0]">· <%= time_ago_in_words(log.created_at) %> ago</span>
    </p>
    <div class="mt-1 flex items-start justify-between gap-2">
      <p class="min-w-0 flex-1 whitespace-pre-wrap break-words text-sm leading-relaxed"><%= log.note %></p>
      <% if log.user == current_user %>
        <span class="flex shrink-0 items-center">
          <%= link_to edit_interaction_log_path(log), data: { turbo_frame: "modal" }, title: "Edit", class: "flex h-7 w-7 items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-[#E9EBED] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:bg-white/10 dark:hover:text-[#E7ECE9]" do %><%= icon("pen", css: "h-3.5 w-3.5") %><% end %>
          <%= link_to confirm_delete_interaction_log_path(log), data: { turbo_frame: "modal" }, title: "Delete", class: "flex h-7 w-7 items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-red-50 hover:text-red-700 dark:text-[#9AA6A0] dark:hover:bg-red-500/10 dark:hover:text-red-400" do %><%= icon("trash-2", css: "h-3.5 w-3.5") %><% end %>
        </span>
      <% end %>
    </div>
  </div>
</div>
