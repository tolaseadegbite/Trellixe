<%= form_with(model: local_assigns[:follow_up_task] ? [follow_up_task, interaction_log] : interaction_log) do |form| %>
  <% if interaction_log.errors.any? %>
    <div class="alert alert--negative flex flex-col gap-half mbe-4" role="alert">
      <h2 class="font-medium leading-none"><%= pluralize(interaction_log.errors.count, "error") %> prohibited this log from being saved:</h2>
      <ul class="mis-3" style="list-style: disc">
        <% interaction_log.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex flex-col items-start gap-half mbe-4">
    <%= form.label :note, "Note", class: "font-medium leading-none" %>
    <%= form.text_area :note, rows: 5, class: "input i-full", placeholder: "e.g., 'Called them, had a great chat...'" %>
  </div>

  <div class="inline-flex items-center mbs-2 mie-1 i-full">
    <%= form.submit class: "btn btn--primary i-full" %>
  </div>
<% end %>
