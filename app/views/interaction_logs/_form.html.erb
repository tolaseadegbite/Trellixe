<%= form_with(model: local_assigns[:follow_up_task] ? [ follow_up_task, interaction_log ] : interaction_log, url: local_assigns[:url]) do |form| %>
  <% if interaction_log.errors.any? %>
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-300" role="alert">
      <p class="font-semibold"><%= pluralize(interaction_log.errors.count, "error") %> stopped this log from saving:</p>
      <ul class="mt-1 list-disc pl-5"><% interaction_log.errors.each do |error| %><li><%= error.full_message %></li><% end %></ul>
    </div>
  <% end %>

  <div>
    <%= form.label :note, "What happened?", class: "mb-1 block text-[13px] font-semibold" %>
    <%= form.text_area :note, rows: 5, placeholder: "Called, had a great chat — invited to Sunday, needs a ride.",
        class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm outline-none transition placeholder:text-[#a7b0aa] focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]" %>
  </div>
  <%= form.submit interaction_log.persisted? ? "Save changes" : "Save log",
      class: "mt-5 w-full cursor-pointer rounded-lg bg-algae-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#0f5c3e]" %>
<% end %>
