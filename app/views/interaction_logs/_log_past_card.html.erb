<div id="<%= dom_id(log, :past) %>" class="mt-2 rounded-xl bg-[#F6F9F7] p-3 dark:bg-white/[0.03]">
  <p class="whitespace-pre-wrap break-words text-sm leading-relaxed"><%= log.note %></p>
  <div class="mt-2 flex items-center justify-between gap-2">
    <span class="text-xs tabular-nums text-[#8a938d] dark:text-[#9AA6A0]"><%= time_ago_in_words(log.created_at) %> ago · by <%= log.user.full_name %></span>
    <span class="flex shrink-0 items-center gap-1">
      <% if log.user == current_user %>
        <%= link_to edit_interaction_log_path(log), data: { turbo_frame: "modal" }, title: "Edit", class: "flex h-7 w-7 items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-[#E9EBED] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:bg-white/10 dark:hover:text-[#E7ECE9]" do %><%= icon("pen", css: "h-3.5 w-3.5") %><% end %>
        <%= link_to confirm_delete_interaction_log_path(log), data: { turbo_frame: "modal" }, title: "Delete", class: "flex h-7 w-7 items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-red-50 hover:text-red-700 dark:text-[#9AA6A0] dark:hover:bg-red-500/10 dark:hover:text-red-400" do %><%= icon("trash-2", css: "h-3.5 w-3.5") %><% end %>
      <% end %>
      <%= link_to "Log follow-up", new_follow_up_task_interaction_log_path(log.follow_up_task), data: { turbo_frame: "modal" },
          class: "rounded-lg border border-[#D9DDE0] bg-white px-2.5 py-1 text-xs font-semibold transition hover:border-[#A2E494] hover:text-algae-900 dark:border-white/10 dark:bg-[#131B17] dark:hover:text-algae-300" %>
    </span>
  </div>
</div>
