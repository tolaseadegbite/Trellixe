<% content_for :title, "Forgot password" %>
<%= render layout: "shared/auth_shell", locals: { title: "Reset your password", subtitle: "Enter the email you signed up with and we'll send a reset link." } do %>
  <%= form_with(url: identity_password_reset_path, class: "space-y-4") do |form| %>
    <div>
      <%= form.label :email, class: "mb-1.5 block text-[13px] font-semibold" %>
      <%= form.email_field :email, required: true, autofocus: true, placeholder: "you@example.com",
          class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3.5 py-2.5 text-[14.5px] outline-none transition placeholder:text-[#a7b0aa] focus:border-algae-600 focus:ring-2 focus:ring-algae-300/50 dark:bg-night dark:border-white/10" %>
    </div>
    <%= form.submit "Send reset link", class: "w-full cursor-pointer rounded-lg bg-algae-900 px-4 py-2.5 text-[14.5px] font-semibold text-white transition hover:bg-pine" %>
  <% end %>
  <p class="mt-6 text-center text-[13.5px] text-[#5b6660] dark:text-fog">
    <%= link_to "Back to sign in", sign_in_path, class: "font-semibold text-algae-900 hover:underline dark:text-algae-300" %> · <%= link_to "Sign up", sign_up_path, class: "font-semibold text-algae-900 hover:underline dark:text-algae-300" %>
  </p>
<% end %>
