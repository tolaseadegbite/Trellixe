<% content_for :title, "Choose a new password" %>
<%= render layout: "shared/auth_shell", locals: { title: "Choose a new password", subtitle: "Pick something strong and unique — 12 characters minimum." } do %>
  <%= form_with(url: identity_password_reset_path, method: :patch, class: "space-y-4") do |form| %>
    <% if @user.errors.any? %>
      <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:bg-red-500/10 dark:border-red-500/30 dark:text-red-300" role="alert">
        <p class="font-semibold">Couldn't reset your password.</p>
        <ul class="mt-1 list-disc pl-5">
          <% @user.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <%= form.hidden_field :sid, value: params[:sid] %>
    <div>
      <%= form.label :password, "New password", class: "mb-1.5 block text-[13px] font-semibold" %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password",
          class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3.5 py-2.5 text-[14.5px] outline-none transition focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:bg-[#0C1210] dark:border-white/10" %>
    </div>
    <div>
      <%= form.label :password_confirmation, "Confirm new password", class: "mb-1.5 block text-[13px] font-semibold" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
          class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3.5 py-2.5 text-[14.5px] outline-none transition focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:bg-[#0C1210] dark:border-white/10" %>
    </div>
    <%= form.submit "Save new password", class: "w-full cursor-pointer rounded-lg bg-algae-900 px-4 py-2.5 text-[14.5px] font-semibold text-white transition hover:bg-[#0f5c3e]" %>
  <% end %>
<% end %>
