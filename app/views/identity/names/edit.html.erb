<% content_for :title, "Edit name" %>
<% content_for :page_header, "Edit name" %>

<%= turbo_frame_tag "settings_content" do %>
  <div class="p-4">

    <%# --- MOBILE-ONLY BACK BUTTON --- %>
    <%= render "shared/settings_back_button" %>

    <div class="w-full max-w-3xl">
      <h1 class="mb-4 text-2xl font-bold">Change your name</h1>
      <p class="mb-2 text-[#6b7672] dark:text-[#9AA6A0]">Add/Edit your name below</p>

      <div id="edit_name_form">
        <%= render 'form', user: @user %>
      </div>
    </div>
  </div>
<% end %>
