<% content_for :title, "Profile Photo" %>
<% content_for :page_header, "Profile Photo" %>

<%= turbo_frame_tag "settings_content" do %>
  <div class="p-4">
    <%= render "shared/settings_back_button" %>

    <div class="max-i-full" style="max-width: 48rem;">
      <h1 class="font-bold text-2xl mbe-4">Profile Photo</h1>
      <p class="text-subtle mbe-6">Upload a photo to personalize your account.</p>

      <div id="edit_avatar_form">
        <%= render "form", user: @user %>
      </div>
    </div>
  </div>
<% end %>
