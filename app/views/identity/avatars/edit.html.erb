<% content_for :title, "Profile Photo" %>
<% content_for :page_header, "Profile Photo" %>

<%= turbo_frame_tag "settings_content" do %>
  <div class="p-4">
    <%= render "shared/settings_back_button" %>

    <div class="w-full max-w-3xl">
      <h1 class="mb-4 text-2xl font-bold">Profile Photo</h1>
      <p class="mb-6 text-[#6b7672] dark:text-[#9AA6A0]">Upload a photo to personalize your account.</p>

      <div id="edit_avatar_form">
        <%= render "form", user: @user %>
      </div>
    </div>
  </div>
<% end %>
