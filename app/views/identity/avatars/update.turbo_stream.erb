<%= turbo_stream.update "flash_messages", partial: "shared/flash" %>

<%= turbo_stream.update "header_avatar" do %>
  <div class="avatar" style="--avatar-size: 2rem;">
    <%= image_tag user_avatar_url(current_user, size: 32), alt: current_user.name %>
  </div>
<% end %>

<%= turbo_stream.update "sidebar_avatar_compact" do %>
  <div class="flex shrink-0 overflow-hidden rounded-full bg-highlight" style="padding: .1rem;">
    <%= image_tag user_avatar_url(current_user, size: 32), size: 32, alt: current_user.name, class: "rounded-full" %>
  </div>
<% end %>

<%= turbo_stream.update "sidebar_avatar_full" do %>
  <div class="flex shrink-0 overflow-hidden rounded-full bg-highlight" style="padding: .1rem;">
    <%= image_tag user_avatar_url(current_user, size: 32), size: 32, alt: current_user.name, class: "rounded-full" %>
  </div>
<% end %>

<%= turbo_stream.update "edit_avatar_form" do %>
  <%= render "form", user: current_user %>
<% end %>
