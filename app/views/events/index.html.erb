<% content_for :title, "Events" %>
<% content_for :page_header do %>
  <h4 class="font-semibold">Events (<%= @pagy.count %>)</h4>
<% end %>

<% content_for :header_action_buttons do %>
      
  <%= link_to new_event_path,
                    class: "btn btn--icon btn--primary",
                    data: { turbo_frame: "modal" } do %>
    <span class="icon icon--calendar-plus"></span>
  <% end %>
<% end %>

<div class="absolute hide@md" style="bottom: 4rem; right: 1rem; z-index: 9999">
  <%= link_to new_event_path, class: "btn btn--primary p-5 rounded-full", data: { turbo_frame: "modal" } do %>
    <span class="icon icon--calendar-range"></span>
  <% end %>
</div>

<div id="events-page" class="flex flex-col container p-4 i-full">
  <%= turbo_frame_tag :events_table do %>
    <div class="flex items-center justify-between flex-wrap gap mbe-4">

      <%# Main view tabs: List vs Calendar (This is the LEFT side) %>
      <nav class="tabs__list border" aria-label="Events list and calendar">
        <%= link_to "Events list",
                    events_path(view: 'events-list', q: params.permit(q: [:name_cont, :starts_at_gteq, :starts_at_lteq, :invited_contacts_id_eq])),
                    class: "btn tabs__button",
                    **(params[:view] != 'calendar' ? { aria: { current: "page" } } : {}) %>
        <%= link_to "Calendar", 
                    events_path(view: 'calendar'), 
                    class: "btn tabs__button", 
                    **(params[:view] == 'calendar' ? { aria: { current: "page" } } : {}) %>
        <%= link_to "Series", 
                    event_series_index_path, 
                    class: "btn tabs__button",
                    data: { turbo_frame: "_top" } %>
      </nav>

      <% if params[:view] != 'calendar' %>
        <div class="flex items-center gap">
          <%= link_to "Upcoming", 
                      events_path(view: 'events-list', scope: 'upcoming'), 
                      class: "btn btn--subtle " + (@scope == 'upcoming' ? 'font-bold text-primary' : 'text-subtle') %>

          <%= link_to "Past", 
                      events_path(view: 'events-list', scope: 'past'), 
                      class: "btn btn--subtle " + (@scope == 'past' ? 'font-bold text-primary' : 'text-subtle') %>
        </div>
      <% end %>

    </div>

    <%= turbo_frame_tag "event_view" do %>
      <% if params[:view] == 'calendar' %>
        <%= render 'events/calendar' %>
      <% else %>
        <%= render 'events/events-list' %>
      <% end %>
    <% end %>
    
  <% end %>

</div>
