<%= tag.div id: dom_id(event), class: "rounded-2xl border border-[#D9DDE0] bg-white p-4 transition hover:border-[#A2E494] dark:border-white/10 dark:bg-[#131B17]" do %>
  <div class="flex items-start justify-between gap-2">
    <%= link_to event, data: { turbo_frame: "_top" }, class: "min-w-0 flex-1 font-semibold leading-snug hover:text-algae-900 hover:underline dark:hover:text-algae-300" do %>
      <h3 class="break-words text-[15px]"><%= event.name %></h3>
    <% end %>
    <span data-controller="popover" data-popover-placement-value="bottom-end" data-action="click@window->popover#clickOutside" class="relative shrink-0">
      <button type="button" class="flex h-8 w-8 items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-[#E9EBED] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:bg-white/10 dark:hover:text-[#E7ECE9]" popovertarget="popover-<%= event.id %>" data-popover-target="trigger" aria-haspopup="true"><%= icon("ellipsis", css: "h-4 w-4") %></button>
      <%= tag.div popover: "auto", id: "popover-#{event.id}", class: "tlx-popover w-36 p-1.5", data: { popover_target: "content" } do %>
        <%= link_to "Edit", edit_event_path(event), data: { turbo_frame: "modal" }, class: "flex rounded-lg px-2.5 py-2 text-[13px] hover:bg-[#F1F4F2] dark:hover:bg-white/5" %>
        <% delete_trigger = button_tag "Delete", type: "button", class: "flex w-full rounded-lg px-2.5 py-2 text-left text-[13px] text-red-700 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-500/10", data: { action: "dialog#showModal" } %>
        <%= modal_dialog delete_trigger, size: "450px", title: "Delete '#{event.name}'?" do %>
          <p class="text-sm text-[#6b7672] dark:text-[#9AA6A0]">This permanently deletes this event and its guest list. This can't be undone.</p>
          <div class="mt-5 flex justify-end gap-2">
            <button type="button" class="rounded-lg border border-[#D9DDE0] px-4 py-2 text-sm font-semibold dark:border-white/10" data-action="click->dialog#close">Cancel</button>
            <%= button_to "Delete", event, method: :delete, class: "rounded-lg bg-red-700 px-4 py-2 text-sm font-semibold text-white" %>
          </div>
        <% end %>
      <% end %>
    </span>
  </div>

  <div class="mt-2">
    <% if event.ends_at < Time.current %>
      <span class="rounded-full bg-[#E9EBED] px-2.5 py-0.5 text-xs font-semibold text-[#6b7672] dark:bg-white/10 dark:text-[#9AA6A0]">Past</span>
    <% elsif event.starts_at > Time.current %>
      <span class="rounded-full border border-[#A2E494] bg-algae-50 px-2.5 py-0.5 text-xs font-semibold text-algae-900 dark:bg-algae-600/15 dark:text-algae-300">Upcoming</span>
    <% else %>
      <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-semibold text-amber-800">Live</span>
    <% end %>
  </div>

  <p class="mt-2 flex items-center gap-1.5 text-sm text-[#6b7672] dark:text-[#9AA6A0]">
    <%= icon("calendar-range", css: "h-4 w-4 shrink-0 text-[#8a938d] dark:text-[#9AA6A0]") %>
    <span class="tabular-nums">
      <% if event.starts_at.to_date == event.ends_at.to_date %>
        <strong class="font-medium text-[#1c2420] dark:text-[#E7ECE9]"><%= event.starts_at.strftime("%a, %b %d") %></strong>
        <%= event.starts_at.strftime("%l:%M %p").strip %> – <%= event.ends_at.strftime("%l:%M %p").strip %>
      <% else %>
        <%= event.starts_at.strftime("%b %d") %> – <%= event.ends_at.strftime("%b %d") %>
      <% end %>
      <span class="text-xs font-medium <%= event.starts_at > Time.current ? 'text-algae-900 dark:text-algae-300' : 'text-[#8a938d] dark:text-[#9AA6A0]' %>">
        <%= event.starts_at > Time.current ? "in #{distance_of_time_in_words(Time.current, event.starts_at)}" : "#{time_ago_in_words(event.ends_at)} ago" %>
      </span>
    </span>
  </p>

  <% stats = event.invitation_summary %>
  <% if stats[:total] > 0 %>
    <div class="mt-3 flex items-center gap-4 rounded-xl border border-[#E9EBED] bg-[#F6F9F7] px-3 py-2 dark:border-white/10 dark:bg-white/[0.03]">
      <span class="flex items-center gap-1.5 text-xs font-medium text-[#6b7672] dark:text-[#9AA6A0]" title="Total guests">
        <%= icon("user", css: "h-3.5 w-3.5") %> <span class="tabular-nums">Total: <%= stats[:total] %></span>
      </span>
      <% if stats[:attended] > 0 %>
        <span class="flex items-center gap-1.5 text-xs font-semibold" title="Attended">
          <%= icon("user-check", css: "h-3.5 w-3.5 text-algae-900 dark:text-algae-300") %> <span class="tabular-nums">Attended: <%= stats[:attended] %></span>
        </span>
      <% end %>
    </div>
  <% else %>
    <div class="mt-3 rounded-xl border border-[#E9EBED] bg-[#F6F9F7] px-3 py-2 dark:border-white/10 dark:bg-white/[0.03]">
      <span class="text-xs text-[#8a938d] dark:text-[#9AA6A0]">No guests yet — invite contacts</span>
    </div>
  <% end %>
<% end %>
