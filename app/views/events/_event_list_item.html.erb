<%# Event card — date-forward list item. Locals: event. Optional block
    renders attached meta content inside the card (e.g. per-invitation
    status on the contact history tab). Contract frozen:
    dom_id(event), rendered by the events list, the series show page, and
    the generate-occurrence stream. Same actions, new presentation. %>
<% live = event.starts_at <= Time.current && event.ends_at >= Time.current %>
<% upcoming = event.starts_at > Time.current %>
<% stats = event.invitation_summary %>
<% pct = stats[:total].positive? ? (stats[:attended] * 100.0 / stats[:total]).round : 0 %>
<%= tag.div id: dom_id(event),
    class: "rounded-2xl border bg-white p-4 transition hover:border-[#A2E494] dark:bg-[#131B17] #{live ? 'border-algae-600 shadow-[0_0_0_1px_var(--color-algae-600)]' : 'border-[#D9DDE0] dark:border-white/10'}" do %>
  <div class="flex items-start gap-3.5">
    <% if live %>
      <span class="flex h-12 w-12 shrink-0 flex-col items-center justify-center rounded-xl bg-algae-900 text-white">
        <span class="h-2 w-2 animate-pulse rounded-full bg-white" aria-hidden="true"></span>
        <span class="mt-1 text-[10px] font-bold uppercase tracking-wide">Live</span>
      </span>
    <% else %>
      <span class="flex h-12 w-12 shrink-0 flex-col items-center justify-center rounded-xl <%= upcoming ? 'bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300' : 'bg-[#F1F4F2] text-[#6b7672] dark:bg-white/5 dark:text-[#9AA6A0]' %>">
        <span class="text-[10px] font-bold uppercase tracking-wide"><%= event.starts_at.strftime("%b") %></span>
        <span class="font-display text-lg font-bold leading-none tabular-nums"><%= event.starts_at.strftime("%-d") %></span>
      </span>
    <% end %>
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-2">
        <%= link_to event, data: { turbo_frame: "_top" }, class: "min-w-0 flex-1 font-semibold leading-snug hover:text-algae-900 hover:underline dark:hover:text-algae-300" do %>
          <h3 class="break-words text-[15px]"><%= event.name %></h3>
        <% end %>
        <span data-controller="popover" data-popover-placement-value="bottom-end" data-action="click@window->popover#clickOutside" class="relative shrink-0">
          <button type="button" class="flex h-8 w-8 items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-[#E9EBED] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:bg-white/10 dark:hover:text-[#E7ECE9]" popovertarget="popover-<%= event.id %>" data-popover-target="trigger" aria-haspopup="true"><%= icon("ellipsis", css: "h-4 w-4") %></button>
          <%= tag.div popover: "auto", id: "popover-#{event.id}", class: "tlx-popover w-36 p-1.5", data: { popover_target: "content" } do %>
            <%= link_to "Edit", edit_event_path(event), class: "flex rounded-lg px-2.5 py-2 text-[13px] hover:bg-[#F1F4F2] dark:hover:bg-white/5" %>
            <% delete_trigger = button_tag "Delete", type: "button", class: "flex w-full rounded-lg px-2.5 py-2 text-left text-[13px] text-red-700 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-500/10", data: { action: "dialog#showModal" } %>
            <%= modal_dialog delete_trigger, size: "450px", title: "Delete '#{event.name}'?" do %>
              <p class="text-sm text-[#6b7672] dark:text-[#9AA6A0]">This permanently deletes this event and its guest list. This can't be undone.</p>
              <div class="mt-5 flex justify-end gap-2">
                <button type="button" class="rounded-lg border border-[#D9DDE0] px-4 py-2 text-sm font-semibold dark:border-white/10" data-action="click->dialog#close">Cancel</button>
                <%= button_to "Delete", event, method: :delete, class: "rounded-lg bg-red-700 px-4 py-2 text-sm font-semibold text-white" %>
              </div>
            <% end %>
          <% end %>
        </span>
      </div>
      <p class="mt-1 text-[13px] tabular-nums text-[#6b7672] dark:text-[#9AA6A0]">
        <% if event.starts_at.to_date == event.ends_at.to_date %>
          <% if live %>
            <span class="font-semibold text-algae-900 dark:text-algae-300">Happening now</span> · ends <%= event.ends_at.strftime("%-l:%M %p").strip %>
          <% elsif upcoming %>
            <%= event.starts_at.strftime("%a") %> · <%= event.starts_at.strftime("%-l:%M %p").strip %> · <span class="font-medium text-algae-900 dark:text-algae-300">in <%= distance_of_time_in_words(Time.current, event.starts_at) %></span>
          <% else %>
            <%= event.starts_at.strftime("%a, %b %-d") %> · <%= time_ago_in_words(event.ends_at) %> ago
          <% end %>
        <% else %>
          <%= event.starts_at.strftime("%b %-d") %> → <%= event.ends_at.strftime("%b %-d") %>
        <% end %>
      </p>
    </div>
  </div>

  <% if stats[:total] > 0 %>
    <div class="mt-3 flex items-center gap-2.5">
      <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-[#E9EBED] dark:bg-white/10" role="progressbar"
           aria-valuenow="<%= stats[:attended] %>" aria-valuemin="0" aria-valuemax="<%= stats[:total] %>" aria-label="Guests checked in">
        <div class="h-full rounded-full bg-algae-600" style="width: <%= pct %>%"></div>
      </div>
      <span class="shrink-0 text-xs font-semibold tabular-nums text-[#6b7672] dark:text-[#9AA6A0]"><%= stats[:attended] %>/<%= stats[:total] %></span>
    </div>
  <% else %>
    <p class="mt-3 text-[13px] text-[#8a938d] dark:text-[#9AA6A0]">No guests yet — <%= link_to "invite contacts", event_path(event), data: { turbo_frame: "_top" }, class: "font-semibold text-algae-900 hover:underline dark:text-algae-300" %></p>
  <% end %>
  <%= yield if block_given? %>
<% end %>
