<% content_for :title, "Edit Event" %>
<% content_for :page_header, "Edit event" %>

<div class="mx-auto w-full max-w-2xl">
  <%= render "shared/breadcrumb", trail: [ { label: @event.name, path: event_path(@event) }, { label: "Edit" } ] %>

  <div class="mt-3 rounded-2xl border border-[#D9DDE0] bg-white p-6 dark:border-white/10 dark:bg-card sm:p-8">
    <h1 class="font-display text-xl font-bold tracking-tight">Edit <%= @event.name %></h1>
    <p class="mt-1 text-sm leading-relaxed text-[#6b7672] dark:text-fog">Unchecking a guest removes them from this event.</p>
    <div class="mt-6">
      <%= render "form", event: @event %>
    </div>
  </div>
</div>
