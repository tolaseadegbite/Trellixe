<% content_for :title, "Edit Event" %>
<% content_for :page_header, "Edit event" %>

<div class="mx-auto w-full max-w-2xl">
  <%= link_to "‹ Back to event", event_path(@event), class: "inline-flex items-center gap-1 rounded-lg px-2 py-1 text-sm font-semibold text-[#3d4742] transition hover:bg-[#E9EBED] dark:text-[#C6CFC9] dark:hover:bg-white/5" %>

  <div class="mt-3 rounded-2xl border border-[#D9DDE0] bg-white p-6 dark:border-white/10 dark:bg-[#131B17] sm:p-8">
    <h1 class="font-display text-xl font-bold tracking-tight">Edit <%= @event.name %></h1>
    <p class="mt-1 text-sm leading-relaxed text-[#6b7672] dark:text-[#9AA6A0]">Unchecking a guest removes them from this event.</p>
    <div class="mt-6">
      <%= render "form", event: @event %>
    </div>
  </div>
</div>
