<%= form_with(model: event, html: { contents: true }) do |form| %>
  <% if event.errors.any? %>
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:bg-red-500/10 dark:border-red-500/30 dark:text-red-300" role="alert">
      <p class="font-semibold"><%= pluralize(event.errors.count, "error") %> stopped this event from saving:</p>
      <ul class="mt-1 list-disc pl-5"><% event.errors.each do |error| %><li><%= error.full_message %></li><% end %></ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "mb-1 block text-[13px] font-semibold" %>
    <%= form.text_field :name, autofocus: true, placeholder: "e.g. Sunday Service",
        class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm outline-none transition focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]" %>
  </div>

  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    <div>
      <%= form.label :starts_at, class: "mb-1 block text-[13px] font-semibold" %>
      <%= form.datetime_field :starts_at,
          class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm tabular-nums outline-none transition focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]" %>
    </div>
    <div>
      <%= form.label :duration_in_minutes, class: "mb-1 block text-[13px] font-semibold" %>
      <%= form.number_field :duration_in_minutes, placeholder: "e.g. 60",
          class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm tabular-nums outline-none transition focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]" %>
    </div>
  </div>

  <div class="mt-3">
    <%= form.label :contact_ids, "Invite contacts (optional)", class: "mb-1 block text-[13px] font-semibold" %>
    <%= form.collection_select :contact_ids, Current.account.contacts.order(:first_name), :id, :full_name, {},
        { multiple: true, class: "w-full", data: { controller: "combobox" } } %>
    <p class="mt-1 text-xs text-[#8a938d] dark:text-[#9AA6A0]">Hold Ctrl (or Cmd on Mac) to select multiple people.</p>
  </div>

  <%= form.submit event.persisted? ? "Save changes" : "Create event",
      class: "mt-5 w-full cursor-pointer rounded-lg bg-algae-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#0f5c3e]" %>
<% end %>
