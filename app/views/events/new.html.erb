<% content_for :title, "New Event" %>
<% content_for :page_header, "New event" %>

<div class="mx-auto w-full max-w-2xl">
  <%= render "shared/breadcrumb", trail: [ { label: "Events", path: events_path }, { label: "New event" } ] %>

  <div class="mt-3 rounded-2xl border border-[#D9DDE0] bg-white p-6 dark:border-white/10 dark:bg-[#131B17] sm:p-8">
    <h1 class="font-display text-xl font-bold tracking-tight">Create an event</h1>
    <p class="mt-1 text-sm leading-relaxed text-[#6b7672] dark:text-[#9AA6A0]">Name it, pick a time, invite a few people — guests can be checked in from here on event day.</p>
    <div class="mt-6">
      <%= render "form", event: @event %>
    </div>
  </div>
</div>
