<%# Check-in mode: door-speed attendance. Locals: event, invitations, pagy, search, summary %>
<div class="space-y-4">
  <%= render "events/checkin_counter", summary: summary %>

  <% if event.starts_at > Time.current %>
    <p class="rounded-xl border border-dashed border-[#D9DDE0] px-4 py-3 text-center text-[13px] leading-relaxed text-[#6b7672] dark:border-white/15 dark:text-[#9AA6A0]">
      Check-in opens when the event starts (<%= event.starts_at.strftime("%a, %b %-d") %>) — the guest list can be managed anytime.
    </p>
  <% end %>

  <div class="rounded-2xl border border-[#D9DDE0] bg-white p-4 dark:border-white/10 dark:bg-[#131B17]">
    <%= form_with url: event_path(event, mode: "checkin"), method: :get,
        data: { turbo_frame: "checkin_list", turbo_action: "advance", controller: "debounce" },
        html: { class: "flex min-w-0 items-center gap-2" } do %>
      <%# mode travels as a field: browsers drop action-URL query strings on
          GET submit, and without it the response renders manage view with no
          checkin_list frame (Turbo "Content missing"). %>
      <%= hidden_field_tag :mode, "checkin" %>
      <span class="relative min-w-0 flex-1">
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[#8a938d] dark:text-[#9AA6A0]"><%= icon("search", css: "h-4 w-4") %></span>
        <%= search_field_tag "q[contact_first_name_or_contact_last_name_or_contact_email_cont]",
            params.dig(:q, :contact_first_name_or_contact_last_name_or_contact_email_cont),
            placeholder: "Type a name…",
            class: "w-full rounded-lg border border-[#D9DDE0] bg-[#F6F9F7] py-3 pl-9 pr-3 text-[16px] outline-none transition placeholder:text-[#a7b0aa] focus:border-[#3AB67D] focus:bg-white focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-white/[0.03] dark:focus:bg-[#0C1210]",
            data: { action: "input->debounce#submit" } %>
      </span>
    <% end %>
  </div>

  <%= turbo_frame_tag "checkin_list", class: "block space-y-3" do %>
    <% if invitations.any? %>
      <%= render partial: "events/checkin_row", collection: invitations, as: :invitation %>
    <% else %>
      <% if params[:q].present? %>
        <%= render "shared/empty_state", title: "No matches", body: "No guests match that search.", icon_name: "search" %>
      <% else %>
        <%= render "shared/empty_state", title: "No guests yet", body: "Invite guests in Manage mode, then check them in here.", icon_name: "calendar-range" %>
      <% end %>
    <% end %>
    <div class="pt-1"><%= render "shared/pagination", pagy: pagy %></div>
  <% end %>
</div>
