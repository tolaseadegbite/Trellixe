<div id="<%= dom_id(event, :show_header) %>">
  <div class="overflow-hidden rounded-2xl border border-[#D9DDE0] bg-white p-6 dark:border-white/10 dark:bg-[#131B17]">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0 flex-1">
        <h1 class="break-words font-display text-2xl font-bold tracking-tight"><%= event.name %></h1>
        <p class="mt-1.5 text-sm tabular-nums text-[#6b7672] dark:text-[#9AA6A0]">
          <%= format_full_event_datetime_range(event) rescue l(event.starts_at, format: :long) %>
        </p>
      </div>
      <%= link_to edit_event_path(event), data: { turbo_frame: "modal" }, title: "Edit",
          class: "flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-algae-900 text-white transition hover:bg-[#0f5c3e]" do %>
        <%= icon("pen", css: "h-4 w-4") %>
      <% end %>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-8 rounded-xl border border-[#E9EBED] bg-[#F6F9F7] p-4 dark:border-white/10 dark:bg-white/[0.03]">
      <% stats = event.invitation_summary %>
      <div class="flex flex-col">
        <span class="mb-1 text-[11px] font-semibold uppercase tracking-wide text-[#8a938d] dark:text-[#9AA6A0]">Total guests</span>
        <span class="text-2xl font-bold tabular-nums"><%= stats[:total] %></span>
      </div>
      <div class="flex flex-col">
        <span class="mb-1 text-[11px] font-semibold uppercase tracking-wide text-algae-900 dark:text-algae-300">Attended</span>
        <div class="flex items-center gap-1.5">
          <%= icon("user-check", css: "h-4 w-4 text-algae-900 dark:text-algae-300") %>
          <span class="text-2xl font-bold tabular-nums"><%= stats[:attended] %></span>
        </div>
      </div>
      <div class="flex flex-col">
        <span class="mb-1 text-[11px] font-semibold uppercase tracking-wide text-red-700 dark:text-red-400">Declined</span>
        <div class="flex items-center gap-1.5">
          <%= icon("user-x", css: "h-4 w-4 text-red-700 dark:text-red-400") %>
          <span class="text-2xl font-bold tabular-nums"><%= stats[:declined] %></span>
        </div>
      </div>
    </div>
  </div>
</div>
