<div id="<%= dom_id(event, :show_header) %>">
  <div class="overflow-hidden rounded-2xl border border-[#D9DDE0] bg-white dark:border-white/10 dark:bg-[#131B17]">
    <div class="flex items-start gap-4 p-6">
      <% live = event.starts_at <= Time.current && event.ends_at >= Time.current %>
      <% if live %>
        <span class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-2xl bg-algae-900 text-white">
          <span class="h-2 w-2 animate-pulse rounded-full bg-white" aria-hidden="true"></span>
          <span class="mt-1.5 text-[10px] font-bold uppercase tracking-wide">Live</span>
        </span>
      <% else %>
        <span class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-2xl bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300">
          <span class="text-xs font-bold uppercase tracking-wide"><%= event.starts_at.strftime("%b") %></span>
          <span class="font-display text-2xl font-bold leading-none tabular-nums"><%= event.starts_at.strftime("%-d") %></span>
        </span>
      <% end %>
      <div class="min-w-0 flex-1">
        <h1 class="break-words font-display text-2xl font-bold tracking-tight"><%= event.name %></h1>
        <p class="mt-1.5 text-sm tabular-nums text-[#6b7672] dark:text-[#9AA6A0]">
          <%= format_full_event_datetime_range(event) rescue l(event.starts_at, format: :long) %>
        </p>
        <% if event.event_series %>
          <p class="mt-1 text-[13px] text-[#8a938d] dark:text-[#9AA6A0]">
            Part of <%= link_to event.event_series.name, event_series_path(event.event_series), data: { turbo_frame: "_top" }, class: "font-semibold text-algae-900 hover:underline dark:text-algae-300" %>
          </p>
        <% end %>
      </div>
      <% unless local_assigns[:checkin] %>
      <%= link_to edit_event_path(event), title: "Edit",
          class: "flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-algae-900 text-white transition hover:bg-[#0f5c3e]" do %>
        <%= icon("pen", css: "h-4 w-4") %>
      <% end %>
      <% end %>
    </div>

    <% stats = event.invitation_summary %>
    <div class="flex items-center gap-4 border-t border-[#E9EBED] bg-[#F6F9F7] px-6 py-4 dark:border-white/10 dark:bg-white/[0.03]">
      <div class="min-w-0 flex-1">
        <div class="flex items-baseline justify-between gap-3">
          <p class="text-sm font-semibold tabular-nums">
            <%= stats[:attended] %> <span class="font-medium text-[#8a938d] dark:text-[#9AA6A0]">of <%= stats[:total] %> checked in</span>
          </p>
          <% if stats[:declined] > 0 %>
            <p class="text-[13px] tabular-nums text-[#8a938d] dark:text-[#9AA6A0]"><%= stats[:declined] %> declined</p>
          <% end %>
        </div>
        <div class="mt-2 h-2 overflow-hidden rounded-full bg-[#E9EBED] dark:bg-white/10" role="progressbar"
             aria-valuenow="<%= stats[:attended] %>" aria-valuemin="0" aria-valuemax="<%= stats[:total] %>" aria-label="Guests checked in">
          <div class="h-full rounded-full bg-algae-600 transition-all" style="width: <%= stats[:total].positive? ? (stats[:attended] * 100.0 / stats[:total]).round : 0 %>%"></div>
        </div>
      </div>
      <% unless local_assigns[:checkin] %>
        <%= link_to "Check in", event_path(event, mode: "checkin"), class: "shrink-0 rounded-lg bg-algae-900 px-4 py-2 text-[13px] font-semibold text-white transition hover:bg-[#0f5c3e]" %>
      <% end %>
    </div>
  </div>
</div>
