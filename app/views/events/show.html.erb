<% content_for :title, @event.name %>

<% content_for :page_header do %>
  <%= render "shared/breadcrumb", trail: [ { label: "Events", path: events_path }, { label: @event.name } ] %>
<% end %>

<div class="space-y-5">
  <%= render "events/show_header", event: @event, checkin: @checkin_mode %>

  <nav class="flex gap-1 rounded-xl border border-[#D9DDE0] bg-white p-1 self-start dark:border-white/10 dark:bg-[#131B17]" aria-label="Guest list mode">
    <%= link_to "Manage", event_path(@event),
        class: "rounded-lg px-4 py-1.5 text-[13px] font-semibold transition #{@checkin_mode ? 'text-[#6b7672] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:text-[#E7ECE9]' : 'bg-algae-900 text-white'}",
        **(@checkin_mode ? {} : { aria: { current: "page" } }) %>
    <%= link_to "Check in", event_path(@event, mode: "checkin"),
        class: "rounded-lg px-4 py-1.5 text-[13px] font-semibold transition #{@checkin_mode ? 'bg-algae-900 text-white' : 'text-[#6b7672] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:text-[#E7ECE9]' }",
        **(@checkin_mode ? { aria: { current: "page" } } : {}) %>
  </nav>

  <% if @checkin_mode %>
    <%= render "events/checkin", event: @event, invitations: @invitations,
        pagy: @pagy, search: @invitations_search, summary: @checkin_summary %>
  <% else %>
  <div class="rounded-2xl border border-[#D9DDE0] bg-white p-6 dark:border-white/10 dark:bg-[#131B17]">
    <h3 class="font-display text-[15px] font-semibold">Invite contacts</h3>
    <%= turbo_frame_tag "new_invitation_form" do %>
      <div class="mt-3">
        <%= render "invitations/form", event: @event, invitation: @new_invitation %>
      </div>
    <% end %>
  </div>

  <div>
    <h2 class="mb-2 font-display text-[15px] font-semibold">Guest list</h2>

    <div class="rounded-2xl border border-[#D9DDE0] bg-white p-4 dark:border-white/10 dark:bg-[#131B17]">
      <%= render "invitations/search_form" %>
    </div>

    <%= turbo_frame_tag "guest_list", class: "mt-4 block" do %>
      <%= form_with url: bulk_update_invitations_path, method: :patch, id: "invitations-bulk-form",
          data: { controller: "check-all", action: "reset-bulk-ui->check-all#deselectAll" } do |form| %>

        <div id="bulk_actions_bar">
          <div id="bulk_actions_bar_inner" data-check-all-target="actionBar"
              class="action-bar border border-[#1c2420] bg-[#1c2420] p-2 rounded-xl shadow-xl text-white">
            <span class="pl-2 text-sm font-semibold tabular-nums" data-check-all-target="count">0 selected</span>
            <div class="flex items-center gap-2">
              <%= form.button "Mark Attended", name: "status", value: "attended",
                    class: "cursor-pointer rounded-md bg-algae-900 px-3 py-1.5 text-xs font-semibold text-white" %>
              <%= form.button "Mark Declined", name: "status", value: "declined",
                    class: "cursor-pointer rounded-md bg-red-700 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-red-800" %>
              <%= form.button "Reset", name: "status", value: "invited",
                    class: "cursor-pointer rounded-md bg-white px-3 py-1.5 text-xs font-semibold text-[#1c2420] dark:bg-white/5 dark:text-[#E7ECE9]" %>
            </div>
          </div>
        </div>

        <div class="overflow-hidden rounded-2xl border border-[#D9DDE0] bg-white dark:border-white/10 dark:bg-[#131B17]">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#E9EBED] px-4 py-2.5 dark:border-white/10">
            <label class="flex cursor-pointer items-center gap-2 text-[13px] font-medium text-[#3d4742] dark:text-[#C6CFC9]">
              <%= check_box_tag :check_all, nil, false, class: "h-4 w-4 cursor-pointer accent-[#13714C]", data: { action: "check-all#check", check_all_target: "dependee" } %>
              Select all
            </label>
            <p class="text-[13px] tabular-nums text-[#8a938d] dark:text-[#9AA6A0]"><%= @pagy.count %> <%= "guest".pluralize(@pagy.count) %></p>
          </div>
          <div id="invitations-list" class="divide-y divide-[#E9EBED] dark:divide-white/10">
            <% if @invitations.any? %>
              <%= render partial: "invitations/invitation_row", collection: @invitations, as: :invitation %>
            <% else %>
              <div id="no-invitations-row" class="px-4 py-8"><%= render "shared/empty_state", title: "No invitations yet", body: "Invite contacts above and they will appear here.", icon_name: "mail" %></div>
            <% end %>
          </div>
        </div>

        <div class="mt-4">
          <%= render "shared/pagination", pagy: @pagy %>
        </div>
      <% end %>
    <% end %>
  </div>
  <% end %>
</div>
