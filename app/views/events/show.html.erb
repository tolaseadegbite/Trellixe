<% content_for :title, @event.name %>

<% content_for :page_header do %>
  <span class="flex min-w-0 items-center gap-2 text-sm">
    <%= link_to "javascript:history.back()", class: "flex shrink-0 items-center text-[#8a938d] transition hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:text-[#E7ECE9]" do %>
      <%= icon("chevron-left", css: "h-5 w-5") %>
    <% end %>
    <span class="text-[#8a938d] dark:text-[#9AA6A0]">/</span>
    <span class="truncate font-medium"><%= @event.name %></span>
  </span>
<% end %>

<div class="space-y-5">
  <%= render "events/show_header", event: @event %>

  <div class="rounded-2xl border border-[#D9DDE0] bg-white p-6 dark:border-white/10 dark:bg-[#131B17]">
    <h3 class="font-display text-[15px] font-semibold">Invite contacts</h3>
    <%= turbo_frame_tag "new_invitation_form" do %>
      <div class="mt-3">
        <%= render "invitations/form", event: @event, invitation: @new_invitation %>
      </div>
    <% end %>
  </div>

  <div>
    <h2 class="mb-2 font-display text-[15px] font-semibold">Guest list</h2>

    <div class="rounded-2xl border border-[#D9DDE0] bg-white p-4 dark:border-white/10 dark:bg-[#131B17]">
      <%= render "invitations/search_form" %>
    </div>

    <%= turbo_frame_tag "guest_list", class: "mt-4 block" do %>
      <%= form_with url: bulk_update_invitations_path, method: :patch, id: "invitations-bulk-form",
          data: { controller: "check-all", action: "reset-bulk-ui->check-all#deselectAll" } do |form| %>

        <div id="bulk_actions_bar">
          <div id="bulk_actions_bar_inner" data-check-all-target="actionBar"
              class="action-bar border border-[#1c2420] bg-[#1c2420] p-2 rounded-xl shadow-xl text-white">
            <span class="pl-2 text-sm font-semibold tabular-nums" data-check-all-target="count">0 selected</span>
            <div class="flex items-center gap-2">
              <%= form.button "Mark Attended", name: "status", value: "attended",
                    class: "cursor-pointer rounded-md bg-algae-900 px-3 py-1.5 text-xs font-semibold text-white" %>
              <%= form.button "Mark Declined", name: "status", value: "declined",
                    class: "cursor-pointer rounded-md bg-red-700 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-red-800" %>
              <%= form.button "Reset", name: "status", value: "invited",
                    class: "cursor-pointer rounded-md bg-white px-3 py-1.5 text-xs font-semibold text-[#1c2420] dark:bg-white/5 dark:text-[#E7ECE9]" %>
            </div>
          </div>
        </div>

        <div class="hidden overflow-hidden rounded-2xl border border-[#D9DDE0] bg-white md:block dark:border-white/10 dark:bg-[#131B17]">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead>
                <tr class="border-b border-[#E9EBED] bg-[#F6F9F7] text-xs uppercase tracking-wide text-[#6b7672] dark:border-white/10 dark:bg-white/[0.03] dark:text-[#9AA6A0]">
                  <th class="w-10 px-4 py-3">
                    <%= check_box_tag :check_all, nil, false, class: "h-4 w-4 accent-[#13714C]", data: { action: "check-all#check", check_all_target: "dependee" } %>
                  </th>
                  <th class="px-3 py-3 font-semibold">Name</th>
                  <th class="px-3 py-3 font-semibold">Status</th>
                  <th class="px-3 py-3 font-semibold">Notes</th>
                  <th class="px-4 py-3 text-right font-semibold">Actions</th>
                </tr>
              </thead>
              <tbody id="invitations-table" class="divide-y divide-[#E9EBED] dark:divide-white/10">
                <% if @invitations.any? %>
                  <%= render @invitations %>
                <% else %>
                  <tr id="no-invitations-row"><td colspan="5" class="px-4 py-8"><%= render "shared/empty_state", title: "No invitations yet", body: "Invite contacts above and they will appear here.", icon_name: "mail" %></td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="space-y-2.5 md:hidden">
          <label class="flex items-center gap-2 px-1 text-sm font-medium">
            <%= check_box_tag "check_all_mobile", nil, false, class: "h-4 w-4 accent-[#13714C]", data: { action: "check-all#check", check_all_target: "dependee" } %> Select all
          </label>
          <div id="invitations-cards" class="space-y-2.5">
            <% if @invitations.any? %>
              <%= render partial: "invitations/invitation_card", collection: @invitations, as: :invitation %>
            <% else %>
              <%= render "shared/empty_state", title: "No invitations yet", body: "Invite contacts above and they will appear here.", icon_name: "mail" %>
            <% end %>
          </div>
        </div>

        <div class="mt-4">
          <%= render "shared/pagination", pagy: @pagy %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
