<% content_for :title, @event.name %>

<% content_for :page_header do %>
  <div class="flex items-center gap text-sm i-full">
    <%= link_to sanitize("&larr; Back"), events_path, class: "text-subtle hover:text-primary no-underline" %>
    <span class="text-subtle mi-2">/</span>
    <span class="text-primary font-medium"><%= @event.name %></span>
  </div>
<% end %>

<div class="flex flex-col gap p-4">

  <%# --- HEADER CARD --- %>
  <div class="card p-3 bg-surface border rounded-md shadow-sm overflow-hidden">
    
    <%# Top Section: Title %>
    <div class="p-3">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold mbe-1"><%= @event.name %></h1>
          <p class="text-subtle text-sm">
            <%= format_full_event_datetime_range(@event) %>
          </p>
        </div>
        <div>
          <%= link_to "Edit Event", edit_event_path(@event), class: "btn bg-blue-600 hover:bg-blue-700 border-0 text-gray-50 i-full", data: { turbo_frame: "modal" } %>
        </div>
      </div>
    </div>

    <%# Bottom Section: Stats Dashboard %>
    <div class="bg-shade border rounded-md p-3 flex flex-wrap items-center gap-8">
  
      <div class="flex flex-col">
        <span class="text-xs uppercase font-bold text-subtle mbe-1">Total Guests</span>
        <span class="text-2xl font-bold text-primary"><%= @stats[:total] %></span>
      </div>

      <div class="flex flex-col">
        <span class="text-xs uppercase font-bold text-green-500 mbe-1">Attended</span>
        <div class="flex items-center gap-half">
          <span class="icon icon--user-check text-green-500" aria-hidden="true"></span>
          <span class="text-2xl font-bold text-primary"><%= @stats[:attended] %></span>
        </div>
      </div>

    </div>
  </div>

  <%# --- CONTENT GRID --- %>
  <div class="flex flex-col gap-6 mbs-4">
    
    <%# 1. Invite New Contacts Form %>
    <div class="card bg-surface border rounded-md p-5 shadow-sm">
      <h3 class="text-lg font-semibold">Invite Contacts</h3>
      <%= turbo_frame_tag "new_invitation_form" do %>
        <%= render "invitations/form", event: @event, invitation: @new_invitation, available_contacts: @available_contacts %>
      <% end %>
    </div>

    <%# 2. Invitation List %>
    <div>
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold">Guest List (<%= @pagy.count %>)</h2>
        <%# Optional: Add an export button here later %>
      </div>

      <%= render "invitations/search_form", q: @invitations_search %>

      <%= turbo_frame_tag "guest_list" do %>
        <div class="flex flex-col gap-2">
          <% if @invitations.any? %>
            <% @invitations.each do |invitation| %>
              <%# Assuming you have a _invitation.html.erb partial %>
              <%= render invitation %>
            <% end %>
          <% else %>
            <div class="p-8 text-center border border-dashed border-main rounded-md">
              <p class="text-subtle">No guests found matching your criteria.</p>
            </div>
          <% end %>
        </div>

        <div class="mbs-4">
          <%= render "shared/pagination", pagy: @pagy %>
        </div>
      <% end %>
    </div>
  </div>
</div>