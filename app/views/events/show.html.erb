<% content_for :title, @event.name %>

<% content_for :page_header do %>
  <div class="flex items-center gap text-sm i-full">
    <%= link_to "javascript:history.back()", class: "flex items-center text-subtle hover:text-primary no-underline" do %>
      <span class="icon icon--chevron-left" style="--icon-size: 1.25rem" aria-hidden="true"></span>
    <% end %>
    <span class="text-subtle mi-2">/</span>
    <span class="text-primary font-medium"><%= @event.name %></span>
  </div>
<% end %>

<div class="flex flex-col gap p-2">

  <%# --- HEADER CARD --- %>
  <div class="card p-3 bg-surface border border-main rounded-md shadow-sm overflow-hidden">
    
    <%# Top Section: Title %>
    <div class="p-3">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold mbe-1"><%= @event.name %></h1>
          <p class="text-subtle text-sm">
            <%# Assuming you have this helper, otherwise use l(@event.starts_at) %>
            <%= format_full_event_datetime_range(@event) rescue l(@event.starts_at, format: :long) %>
          </p>
        </div>
        <div>
          <%= link_to "Edit Event", edit_event_path(@event), class: "btn bg-blue-600 hover:bg-blue-700 border-0 text-gray-50 i-full", data: { turbo_frame: "modal" } %>
        </div>
      </div>
    </div>

    <%# Bottom Section: Stats Dashboard %>
    <div class="bg-shade border border-main rounded-md p-3 flex flex-wrap items-center gap-8">
  
      <div class="flex flex-col">
        <span class="text-xs uppercase font-bold text-subtle mbe-1">Total Guests</span>
        <span class="text-2xl font-bold text-primary"><%= @stats[:total] %></span>
      </div>

      <div class="flex flex-col">
        <span class="text-xs uppercase font-bold text-green-500 mbe-1">Attended</span>
        <div class="flex items-center gap-half">
          <span class="icon icon--user-check text-green-500" aria-hidden="true"></span>
          <span class="text-2xl font-bold text-primary"><%= @stats[:attended] %></span>
        </div>
      </div>

    </div>
  </div>

  <%# --- CONTENT GRID --- %>
  <div class="flex flex-col gap-6 mbs-4">
    
    <%# 1. Invite New Contacts Form %>
    <div class="card bg-surface border border-main rounded-md p-5 shadow-sm">
      <h3 class="text-lg font-semibold mbe-4">Invite Contacts</h3>
      <%= turbo_frame_tag "new_invitation_form" do %>
        <%= render "invitations/form", event: @event, invitation: @new_invitation %>
      <% end %>
    </div>

    <%# 2. Invitation List (With Bulk Actions) %>
    <div class="mbe-4">
      <h2 class="font-bold text-lg mbe-2">Guest List</h2>
      
      <%# WRAP TABLE IN FORM %>
      <%= form_with url: bulk_update_invitations_path, method: :patch, id: "invitations-bulk-form", data: { controller: "check-all", action: "reset-bulk-ui->check-all#deselectAll" } do |form| %>

        <%# --- BULK ACTION BAR --- %>
        <div id="bulk_actions_bar_inner" data-check-all-target="actionBar" 
            class="bg-black text-reversed p-2 rounded-md shadow-lg items-center justify-between border" 
            style="position: fixed; display: none; bottom: 2rem; inline-size: calc(100% - 2rem); max-inline-size: 600px; left: 50%; transform: translateX(-50%); z-index: 10000;">
          
          <div class="flex items-center gap">
            <span class="font-bold text-sm mis-2" data-check-all-target="count">0 selected</span>
          </div>

          <div class="flex items-center gap">
            <%# Mark Attended %>
            <%= form.button "Mark Attended", 
                  name: "status",
                  value: "attended",
                  class: "btn bg-teal-600 hover:bg-teal-700 text-gray-50 text-xs",
                  style: "padding: 0.25rem 0.75rem;" %>

            <%# NEW: Mark Declined %>
            <%= form.button "Mark Declined", 
                  name: "status",
                  value: "declined",
                  class: "btn bg-red-600 hover:bg-red-700 text-gray-50 text-xs",
                  style: "padding: 0.25rem 0.75rem;" %>

            <%# Reset %>
            <%= form.button "Reset", 
                  name: "status",
                  value: "invited",
                  class: "btn btn--subtle text-xs mis-2" %>
          </div>
        </div>

        <%# --- DESKTOP TABLE --- %>
        <div class="show@md">
          <div class="relative i-full overflow-x-auto border border-main rounded-md">
            <table class="table">
              <thead class="bg-shade font-semibold text-xs uppercase text-subtle">
                <tr>
                  <%# Select All Checkbox %>
                  <th class="p-3">
                    <%= check_box_tag :check_all, nil, false, class: "input cursor-pointer", data: { action: "check-all#check", check_all_target: "dependee" } %>
                  </th>
                  <th class="p-3">Name</th>
                  <th class="p-3">Status</th>
                  <th class="p-3">Notes</th>
                  <th class="p-3 text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="invitations-table">
                <% if @invitations.any? %>
                  <%= render @invitations %>
                <% else %>
                  <tr id="no-invitations-row"><td colspan="5" class="p-8 text-center text-subtle">No invitations yet.</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <%# --- MOBILE CARDS --- %>
        <div class="hide@md flex flex-col gap">
          <div class="flex items-center gap pb-2 pi-1">
            <%= check_box_tag "check_all_mobile", nil, false, class: "input cursor-pointer", data: { action: "check-all#check", check_all_target: "dependee" } %>
            <label for="check_all_mobile" class="font-medium cursor-pointer text-sm">Select all</label>
          </div>
          <div id="invitations-cards" class="flex flex-col gap">
            <% if @invitations.any? %>
              <%= render partial: "invitations/invitation_card", collection: @invitations, as: :invitation %>
            <% else %>
              <div class="p-8 text-center text-subtle text-sm">No invitations yet.</div>
            <% end %>
          </div>
        </div>
        
        <div class="mbs-4">
          <%= render "shared/pagination", pagy: @pagy %>
        </div>

      <% end %> <%# End Form %>
    </div>
    
    <%# 3. Follow-up Activity %>
    <div class="mbe-8">
      <h2 class="font-bold text-lg mbe-2">Follow-up Activity</h2>

      <div class="border border-main rounded-lg bg-surface overflow-hidden">
        <% if @event_logs.any? %>
          <% @event_logs.each do |log| %>
            <div class="flex items-start gap-3 p-4 border-b border-main last:border-0 hover:bg-highlight transition">
              <div class="flex flex-item-no-shrink items-center justify-center font-bold text-xs text-reversed rounded-full bg-black"
                   style="inline-size: 2rem; block-size: 2rem;">
                <%= log.user.initials %>
              </div>

              <div class="flex flex-col gap-1 i-full min-w-0">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <div class="flex items-center gap-2 min-w-0">
                    <span class="font-semibold text-sm text-emerald-600 shrink-0"><%= log.user.full_name %></span>
                    <span class="text-xs text-subtle shrink-0">followed up with</span>
                    <%= link_to log.contact.full_name, contact_path(log.contact), class: "font-semibold text-sm text-emerald-600 hover:underline truncate", data: { turbo_frame: "_top" } %>
                  </div>
                  <span class="text-xs text-subtle shrink-0"><%= time_ago_in_words(log.created_at) %> ago</span>
                </div>

                <div class="flex items-start justify-between gap-2 mbs-1">
                  <div class="text-sm text-primary whitespace-pre-wrap"><%= log.note %></div>
                  <% if log.user == current_user %>
                    <div class="flex gap-1 shrink-0">
                      <%= link_to edit_interaction_log_path(log), class: "btn btn--icon btn--subtle", style: "block-size: 1.5rem; inline-size: 1.5rem;", data: { turbo_frame: "_top" } do %>
                        <span class="icon icon--pen" style="--icon-size: 0.75rem" aria-hidden="true"></span>
                      <% end %>
                      <%= button_to interaction_log_path(log), method: :delete, class: "btn btn--icon btn--subtle", style: "block-size: 1.5rem; inline-size: 1.5rem;", data: { turbo_confirm: "Delete this log?" } do %>
                        <span class="icon icon--trash-2" style="--icon-size: 0.75rem" aria-hidden="true"></span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="p-8 text-center text-subtle">
            <p>No follow-ups logged yet.</p>
            <p class="text-xs mt-1">Mark guests as "Attended" to trigger reminders for your team.</p>
          </div>
        <% end %>
      </div>
    </div>
    
  </div>
</div>