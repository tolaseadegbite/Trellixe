<% content_for :title, @event.name %>

<% content_for :page_header do %>
  <div class="flex items-center gap text-sm i-full">
    <%= link_to sanitize("&larr;"), :back %>
    <%#= link_to "Events", events_path, class: "text-subtle hover:text-primary" %>
    <%# <span class="text-subtle">/</span> %>
    <span class="text-primary"><%= @event.name %></span>
  </div>
<% end %>

<%# --- Main Page Container --- %>
<div class="flex flex-col gap p-4">

  <%# --- Event Header Section --- %>
  <div class="flex items-start justify-between gap-5 border-be border-main pbe-6">
    <div>
      <h1 class="text-2xl font-semibold mbe-1" style="max-width: 50dvw"><%= @event.name %></h1>
      <p class="text-sm text-subtle"><%= @event.starts_at.strftime("%A, %B %d, %Y from %I:%M %p") %> to <%= @event.ends_at.strftime("%I:%M %p") %></p>
    </div>
    <%# --- At-a-Glance Stats --- %>
    <div class="flex flex-wrap items-center justify-center gap text-center">
      <div>
        <p class="text-xl font-semibold"><%= @stats[:total] %></p>
        <p class="text-xs uppercase text-subtle">Invited</p>
      </div>
      <div>
        <p class="text-xl font-semibold text-blue-400"><%= @stats[:accepted] %></p>
        <p class="text-xs uppercase text-blue-400">Accepted</p>
      </div>
      <div>
        <p class="text-xl font-semibold text-green-400"><%= @stats[:attended] %></p>
        <p class="text-xs uppercase text-green-400">Attended</p>
      </div>
      <div>
        <p class="text-xl font-semibold text-red-400"><%= @stats[:declined] %></p>
        <p class="text-xs uppercase text-red-400">Declined</p>
      </div>
    </div>
  </div>

  <%# --- Main Content Area: Invitation List and Invite Form --- %>
  <div class="flex flex-col gap">
    
    <div class="mbe-5">
      <h3 class="text-lg font-semibold">Invite Contacts</h3>
      <%= turbo_frame_tag "new_invitation_form" do %>
        <%= render "invitations/form", event: @event, invitation: @new_invitation %>
      <% end %>
    </div>

    <%# --- Invitation List Section --- %>
    <div>
      <h2 class="text-xl font-semibold mbe-4">Invitation List Management</h2>

      <%= render "invitations/search_form" %>

      <%= turbo_frame_tag "guest_list" do %>
        <% if @invitations.any? %>
          <% @invitations.each do |invitation| %>
            <%= render invitation %>
          <% end %>
        <% else %>
          <p class="text-sm text-subtle text-center p-8">No guests match your search criteria.</p>
        <% end %>

        <%= render "shared/pagination", pagy: @pagy %>
      <% end %>
    </div>
  </div>
</div>