<% content_for :title, "Workspace Settings" %>

<% content_for :page_header do %>
  <h4 class="font-semibold">Workspace settings</h4>
<% end %>

<div class="container p-4 i-full mi-auto">
  
  <div class="mbe-8">
    <h1 class="text-2xl font-bold mbe-2">General Settings</h1>
    <p class="text-subtle">Manage your workspace identity.</p>
  </div>

  <%# --- RENAME CARD --- %>
  <div class="border border-main rounded-lg bg-main mbe-10 overflow-hidden">
    <div class="p-6 border-be border-main">
      <h3 class="font-bold text-lg mbe-1">Workspace Name</h3>
      <p class="text-sm text-subtle">This name is visible to all team members.</p>
    </div>

    <div class="p-6">
      <%= form_with(model: @account, url: account_path(@account), method: :patch) do |form| %>
        <% if @account.errors.any? %>
          <div class="text-negative text-sm mbe-4">
            <%= @account.errors.full_messages.to_sentence %>
          </div>
        <% end %>

        <div class="flex flex-col gap-1 mbe-6">
          <%= form.label :name, "Display Name", class: "text-sm font-medium" %>
          <%= form.text_field :name, required: true, placeholder: "e.g. Acme Corp", class: "input" %>
        </div>

        <div class="flex items-center justify-end">
          <%= form.submit "Save Changes", class: "btn btn--primary" %>
        </div>
      <% end %>
    </div>
  </div>

  <%# --- DANGER ZONE --- %>
  <div class="border rounded-lg bg-main overflow-hidden" style="border-color: var(--color-negative);">
    <div class="p-6 border-be" style="border-color: var(--color-negative);">
      <h3 class="font-bold text-lg text-red-600 mbe-1">Danger Zone</h3>
      <p class="text-sm text-subtle">Irreversible actions for this workspace.</p>
    </div>

    <div class="p-6 flex items-center justify-between gap-4 flex-wrap">
      <div class="flex flex-col">
        <span class="font-bold text-sm">Delete Workspace</span>
        <span class="text-xs text-subtle">Permanently remove this workspace and all associated data.</span>
      </div>

      <% delete_trigger = button_tag "Delete Workspace", type: "button", class: "btn font-bold text-gray-50 border-0 flex", style: "background-color: var(--color-negative);", data: { action: "dialog#showModal" } %>
      
      <%= modal_dialog delete_trigger, size: "450px", title: "Delete #{@account.name}?" do %>
        
        <%= form_with url: account_path(@account), method: :delete, class: "flex flex-col gap-4" do |f| %>
          
          <p class="text-sm text-subtle">
            Are you sure you want to delete <strong><%= @account.name %></strong>? 
            <br><br>
            All contacts, events, and team memberships will be permanently destroyed. 
            This action <strong>cannot</strong> be undone.
          </p>

          <%# PASSWORD CHALLENGE %>
          <div class="p-3 rounded-md border" style="background-color: rgb(from var(--color-negative) r g b / 0.05); border-color: rgb(from var(--color-negative) r g b / 0.2);">
            <%= f.label :password_challenge, "Enter your password to confirm", class: "block text-xs font-bold text-negative mbe-2" %>
            <%= f.password_field :password_challenge, required: true, class: "input i-full", style: "border-color: var(--color-negative);", placeholder: "Your password" %>
          </div>
          
          <div class="flex items-center justify-end gap-2 mts-2">
            <button type="button" class="btn" data-action="click->dialog#close">Cancel</button>
            
            <%= f.submit "I understand, delete it", class: "btn text-gray-50 border-0 font-semibold", style: "background-color: var(--color-negative);" %>
          </div>

        <% end %>
      <% end %>
    </div>
  </div>

</div>