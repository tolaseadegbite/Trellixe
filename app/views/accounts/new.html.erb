<%= render "shared/modal" do %>
  <div data-action="turbo:submit-end->modal#submitEnd">
    <h3 class="font-display text-lg font-semibold tracking-tight">Create new workspace</h3>
    <p class="mt-1 text-[13px] text-[#6b7672] dark:text-[#9AA6A0]">A fresh home for contacts, events, and follow-ups.</p>

    <%= form_with(model: @account, url: accounts_path, class: "mt-4") do |form| %>
      <% if @account.errors.any? %>
        <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-300" role="alert">
          <%= @account.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div>
        <%= form.label :name, "Workspace name", class: "mb-1 block text-[13px] font-semibold" %>
        <%= form.text_field :name, required: true, autofocus: true, placeholder: "e.g. Acme Corp",
            class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm outline-none transition placeholder:text-[#a7b0aa] focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]" %>
      </div>

      <div class="mt-5 flex justify-end gap-2">
        <%# Cancel takes them back to dashboard (effectively closing modal if navigated away) %>
        <%= link_to "Cancel", root_path, class: "rounded-lg border border-[#D9DDE0] px-4 py-2 text-sm font-semibold transition hover:border-[#A2E494] dark:border-white/10" %>
        <%# turbo_frame: "_top" ensures the redirect to the new workspace reloads the full page context %>
        <%= form.submit "Create workspace", class: "cursor-pointer rounded-lg bg-algae-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#0f5c3e]", data: { turbo_frame: "_top" } %>
      </div>
    <% end %>
  </div>
<% end %>
