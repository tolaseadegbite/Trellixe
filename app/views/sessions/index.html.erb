<% content_for :title, "Settings" %>
<% content_for :page_header, "Settings" %>

<%= turbo_frame_tag "settings_content" do %>
  <div class="p-4">

    <%# --- MOBILE-ONLY BACK BUTTON --- %>
    <%= render "shared/settings_back_button" %>

    <div class="w-full max-w-3xl">
      <div class="mb-6">
        <h1 class="mb-2 text-2xl font-bold">Devices & Sessions</h1>
        <p class="text-[#6b7672] dark:text-[#9AA6A0]">
          This is a list of devices that have logged into your account. For your security, revoke any sessions that you do not recognize.
        </p>
      </div>

      <div id="sessions" class="flex flex-col gap-2.5">
        <% @sessions.each do |session| %>
          <div id="<%= dom_id session %>" class="rounded-2xl border border-[#D9DDE0] bg-white dark:border-white/10 dark:bg-[#131B17]">
            <div class="flex items-center justify-between gap-3 p-4">

              <%# Session Information %>
              <div class="flex min-w-0 flex-col gap-1">
                <div class="flex flex-wrap items-center gap-2">
                  <%# "Current Session" Badge %>
                  <% if session == Current.session %>
                    <span class="inline-flex items-center rounded-full border border-[#A2E494] bg-algae-50 px-2.5 py-0.5 text-xs font-semibold text-algae-900 dark:bg-algae-600/15 dark:text-algae-300">
                      Current session
                    </span>
                  <% end %>
                  <p class="font-semibold tabular-nums"><%= session.ip_address %></p>
                </div>

                <p class="truncate text-sm text-[#6b7672] dark:text-[#9AA6A0]"><%= session.user_agent %></p>
                <p class="text-xs tabular-nums text-[#8a938d] dark:text-[#9AA6A0]">Last seen: <%= time_ago_in_words(session.created_at) %> ago</p>
              </div>

              <%# Action Button %>
              <% if session != Current.session %>
                <div class="shrink-0">
                  <%= button_to "Log out", session, method: :delete, class: "cursor-pointer rounded-lg bg-red-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-800" %>
                </div>
              <% end %>

            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
