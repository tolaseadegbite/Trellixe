<% content_for :title, "Follow Ups" %>

<% content_for :page_header do %>
  <h4 class="font-semibold">Follow Up Tasks (<%= @pagy.count %>)</h4>
<% end %>

<div class="flex flex-col i-full p-3">

  <%= turbo_frame_tag :tasks_table do %>

    <div class="flex items-center justify-between flex-wrap gap mbe-4">
      <nav class="tabs__list border" aria-label="Task filters">
        <%= link_to "Pending",
                    follow_up_tasks_path(scope: "pending"),
                    class: "btn tabs__button",
                    **(params[:scope] != "past" ? { aria: { current: "page" } } : {}) %>
        <%= link_to "Past",
                    follow_up_tasks_path(scope: "past"),
                    class: "btn tabs__button",
                    **(params[:scope] == "past" ? { aria: { current: "page" } } : {}) %>
      </nav>
    </div>

    <% if @scope == "pending" %>

      <%# --- BULK FORM WRAPPER --- %>
      <%= form_with url: bulk_update_follow_up_tasks_path,
                    method: :patch,
                    id: "tasks-bulk-form",
                    data: {
                      controller: "check-all",
                      action: "reset-bulk-ui->check-all#deselectAll"
                    } do |form| %>

        <%# --- ACTION BAR --- %>
        <div id="bulk_actions_bar_inner" data-check-all-target="actionBar"
                class="bg-black text-reversed p-2 rounded-md shadow-lg items-center justify-between border"
                style="position: fixed; display: none; bottom: 2rem; inline-size: calc(100% - 2rem); max-inline-size: 600px; left: 50%; transform: translateX(-50%); z-index: 10000;">

          <div class="flex items-center gap">
            <span class="font-bold text-sm mis-2" data-check-all-target="count">0 selected</span>
          </div>

          <div class="flex items-center gap">
            <%= form.submit "Snooze 24h",
                  class: "btn bg-surface text-primary border border-main text-xs font-semibold rounded-sm",
                  style: "padding: 0.25rem 0.75rem;" %>

            <%= form.submit "Mark Complete",
                  class: "btn bg-green-600 text-reversed border-0 text-xs font-semibold rounded-sm mis-2",
                  style: "padding: 0.25rem 0.75rem;",
                  data: { turbo_confirm: "Mark selected tasks as complete?" } %>
          </div>
        </div>

        <%# --- DESKTOP TABLE --- %>
        <div class="show@md">
          <div class="relative i-full overflow-x-auto border border-main rounded-lg">
            <table class="table i-full text-left">
              <thead class="bg-shade font-semibold text-xs uppercase text-subtle">
                <tr>
                  <th class="p-3 w-8">
                    <%= check_box_tag :check_all, nil, false, class: "input cursor-pointer", data: { action: "check-all#check", check_all_target: "dependee" } %>
                  </th>
                  <th class="p-3">Contact</th>
                  <th class="p-3">Event</th>
                  <th class="p-3">Due</th>
                  <th class="p-3 text-end">Action</th>
                </tr>
              </thead>
              <tbody id="tasks-list">
                <% if @follow_up_tasks.any? %>
                  <%= render partial: "follow_up_tasks/follow_up_task", collection: @follow_up_tasks, as: :task %>
                <% else %>
                  <tr><td colspan="5" class="p-8 text-center text-subtle text-sm">No pending tasks. Good job!</td></tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <%# --- MOBILE CARDS --- %>
        <div class="hide@md flex flex-col gap">
          <div class="flex items-center gap pb-2 pi-1">
            <%= check_box_tag "check_all_mobile", nil, false, class: "input cursor-pointer", data: { action: "check-all#check", check_all_target: "dependee" } %>
            <label for="check_all_mobile" class="font-medium cursor-pointer text-sm">Select all</label>
          </div>

          <div id="tasks-cards">
            <% if @follow_up_tasks.any? %>
              <%= render partial: "follow_up_tasks/task_card", collection: @follow_up_tasks, as: :task %>
            <% else %>
              <div class="p-8 text-center text-subtle text-sm">No pending tasks. Good job!</div>
            <% end %>
          </div>
        </div>

        <div class="mbs-4">
          <%= render "shared/pagination", pagy: @pagy %>
        </div>

      <% end %>

    <% else %>

      <%# --- PAST (COMPLETED) TASKS --- %>
      <div class="border border-main rounded-lg bg-surface overflow-hidden">
        <% if @follow_up_tasks.any? %>
          <% @follow_up_tasks.each do |task| %>
            <div class="flex items-start gap-3 p-4 border-b border-main last:border-0 hover:bg-highlight transition">
              <div class="flex flex-item-no-shrink items-center justify-center font-bold text-xs text-reversed rounded-full bg-teal-600"
                   style="inline-size: 2rem; block-size: 2rem;">
                <%= task.contact.full_name.split.first(2).map(&:first).join.upcase %>
              </div>
              <div class="flex flex-col gap-1 i-full min-w-0">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <div class="flex items-center gap-2 min-w-0">
                    <%= link_to task.contact.full_name, contact_path(task.contact), class: "font-semibold text-sm text-emerald-600 hover:underline truncate", data: { turbo_frame: "_top" } %>
                    <span class="text-xs text-subtle shrink-0">from</span>
                    <%= link_to task.event.name, event_path(task.event), class: "text-sm text-emerald-600 hover:underline truncate", data: { turbo_frame: "_top" } %>
                  </div>
                  <span class="text-xs text-subtle shrink-0">Completed <%= time_ago_in_words(task.completed_at) %> ago</span>
                </div>
                <% if (log = task.interaction_logs.last) %>
                  <div class="flex items-start justify-between gap-2 mbs-1">
                    <div class="text-sm text-primary whitespace-pre-wrap"><%= log.note %></div>
                    <% if log.user == current_user %>
                      <div class="flex gap-1 shrink-0">
                        <%= link_to edit_interaction_log_path(log), class: "btn btn--icon btn--subtle", style: "block-size: 1.5rem; inline-size: 1.5rem;", data: { turbo_frame: "_top" } do %>
                          <span class="icon icon--pen" style="--icon-size: 0.75rem" aria-hidden="true"></span>
                        <% end %>
                        <%= button_to interaction_log_path(log), method: :delete, class: "btn btn--icon btn--subtle", style: "block-size: 1.5rem; inline-size: 1.5rem;", data: { turbo_confirm: "Delete this log?" } do %>
                          <span class="icon icon--trash-2" style="--icon-size: 0.75rem" aria-hidden="true"></span>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="p-8 text-center text-subtle">
            <p>No completed follow-ups yet.</p>
            <p class="text-xs mt-1">Complete a task to see it here.</p>
          </div>
        <% end %>
      </div>

      <div class="mbs-4">
        <%= render "shared/pagination", pagy: @pagy %>
      </div>

    <% end %>
  <% end %>
</div>
