<%# Sequential work queue. Locals: queue (FollowUpQueue::QueueState), pagy, context ({scope:, q?}) %>
<div class="mx-auto w-full max-w-2xl space-y-4">
  <div class="flex items-end justify-between gap-3 px-1">
    <div>
      <p class="font-display text-[26px] font-bold tabular-nums leading-none tracking-tight">
        <%= queue.total %> <span class="text-base font-semibold text-[#8a938d] dark:text-[#9AA6A0]"><%= "task".pluralize(queue.total) %> left</span>
      </p>
      <% if queue.overdue > 0 %>
        <p class="mt-1.5 inline-flex items-center gap-1.5 rounded-full bg-red-700 px-2.5 py-0.5 text-xs font-bold text-white">
          <%= queue.overdue %> overdue
        </p>
      <% else %>
        <p class="mt-1.5 text-[13px] text-[#8a938d] dark:text-[#9AA6A0]">Nothing overdue — nice.</p>
      <% end %>
    </div>
    <% if params[:q].present? %>
      <p class="text-sm text-[#8a938d] dark:text-[#9AA6A0]">Filtered view</p>
    <% end %>
  </div>

  <% if queue.current %>
    <%= render "follow_up_tasks/queue_current", task: queue.current, context: context, queue: queue %>

    <% if queue.up_next.any? %>
      <section aria-label="Up next">
        <p class="px-1 pb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-[#8a938d] dark:text-[#9AA6A0]">Up next</p>
        <div class="space-y-2">
          <%= render partial: "follow_up_tasks/queue_up_next_row", collection: queue.up_next, as: :task, locals: { context: context } %>
        </div>
      </section>
    <% end %>
  <% else %>
    <%= render "shared/empty_state", title: "All caught up", body: "Mark Sunday guests as attended and Monday's calls will queue here.", icon_name: "list-checks" %>
  <% end %>

  <div class="pt-1"><%= render "shared/pagination", pagy: pagy %></div>
</div>
