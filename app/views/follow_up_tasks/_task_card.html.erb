<% overdue = task.due_at < Time.current %>
<div id="<%= dom_id(task, :card) %>" class="flex items-center gap-3 rounded-2xl border border-[#D9DDE0] bg-white p-3.5 dark:border-white/10 dark:bg-[#131B17]">
  <%= check_box_tag "task_ids[]", task.id, false, class: "h-4 w-4 shrink-0 accent-[#13714C]", data: { action: "check-all#check", check_all_target: "dependant" } %>
  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-algae-900 text-sm font-bold text-white">
    <%= task.contact.full_name.split.first(2).map(&:first).join.upcase %>
  </span>
  <div class="min-w-0 flex-1">
    <div class="flex items-center justify-between gap-2">
      <%= link_to task.contact.full_name, contact_path(task.contact), class: "truncate text-[14.5px] font-semibold hover:text-algae-900 dark:hover:text-algae-300", data: { turbo_frame: "_top" } %>
      <%= link_to "Log it", new_follow_up_task_interaction_log_path(task), data: { turbo_frame: "modal" },
          class: "shrink-0 rounded-lg px-3 py-1.5 text-xs font-semibold transition #{overdue ? 'bg-algae-900 text-white hover:bg-[#0f5c3e]' : 'border border-[#D9DDE0] hover:border-[#A2E494] hover:text-algae-900 dark:border-white/10 dark:hover:text-algae-300'}" %>
    </div>
    <p class="truncate text-[13px] text-[#8a938d] dark:text-[#9AA6A0]">from <%= task.event.name %></p>
    <p class="mt-0.5 text-xs tabular-nums <%= overdue ? 'font-semibold text-red-700 dark:text-red-400' : 'text-[#8a938d] dark:text-[#9AA6A0]' %>">
      <% if overdue %>
        Overdue · <%= time_ago_in_words(task.due_at) %> ago
      <% else %>
        Due <%= l(task.due_at, format: :short) %>
      <% end %>
    </p>
  </div>
</div>
