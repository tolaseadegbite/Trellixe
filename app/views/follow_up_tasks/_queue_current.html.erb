<%# Current queue card. Locals: task, context ({scope:, q?}), queue (for position) %>
<% contact = task.invitation.contact %>
<% event = task.invitation.event %>
<% overdue = task.due_at < Time.current %>
<% last_log = task.interaction_logs.max_by(&:created_at) %>

<div id="<%= dom_id(task) %>" class="overflow-hidden rounded-2xl border border-[#D9DDE0] bg-white dark:border-white/10 dark:bg-[#131B17]">
  <div class="h-1.5 <%= overdue ? 'bg-red-500' : 'bg-algae-500' %>" aria-hidden="true"></div>

  <div class="p-5 sm:p-6">
    <div class="flex items-center justify-between gap-2">
      <p class="text-xs font-semibold tabular-nums text-[#8a938d] dark:text-[#9AA6A0]">
        <%= queue.position %> of <%= queue.total %>
      </p>
      <% if queue.prev_id %>
        <%= link_to "← Previous", follow_up_tasks_path(context.merge(focus: queue.prev_id)),
            class: "rounded-lg px-2 py-1 text-[13px] font-semibold text-algae-900 transition hover:bg-algae-50 hover:underline dark:text-algae-300 dark:hover:bg-white/5" %>
      <% end %>
    </div>
    <div class="mt-2 flex items-start gap-3.5">
      <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-algae-900 text-lg font-bold text-white">
        <%= (contact.full_name&.first || contact.first_name&.first || "?").upcase %>
      </span>
      <div class="min-w-0 flex-1">
        <h2 class="break-words font-display text-xl font-bold tracking-tight"><%= contact.full_name %></h2>
        <p class="mt-0.5 truncate text-[13.5px] text-[#8a938d] dark:text-[#9AA6A0]">from <%= event.name %></p>
      </div>
      <% if overdue %>
        <span class="shrink-0 rounded-full bg-red-700 px-2.5 py-1 text-xs font-bold text-white">Overdue · <%= time_ago_in_words(task.due_at) %></span>
      <% else %>
        <span class="shrink-0 rounded-full border border-[#A2E494] bg-algae-50 px-2.5 py-1 text-xs font-semibold text-algae-900 dark:bg-algae-600/15 dark:text-algae-300">Due <%= task.due_at.today? ? "today" : l(task.due_at, format: :short) %></span>
      <% end %>
    </div>

    <div class="mt-4 rounded-xl bg-[#F6F9F7] p-4 dark:bg-white/[0.03]">
      <p class="text-[11px] font-semibold uppercase tracking-wide text-[#8a938d] dark:text-[#9AA6A0]">What you know</p>
      <p class="mt-1 text-[14.5px] leading-relaxed"><%= contact.how_we_met.presence || "No context yet — ask how they found you." %></p>
      <% if last_log %>
        <p class="mt-2 border-t border-[#E9EBED] pt-2 text-[13px] text-[#6b7672] dark:border-white/10 dark:text-[#9AA6A0]">
          Last touch <%= time_ago_in_words(last_log.created_at) %> ago: <%= truncate(last_log.note, length: 110) %>
        </p>
      <% end %>
    </div>

    <%= link_to "Log follow-up", new_follow_up_task_interaction_log_path(task, from: "queue", scope: context[:scope], q: context[:q]),
        data: { turbo_frame: "modal" },
        class: "mt-4 flex min-h-12 w-full items-center justify-center rounded-xl bg-algae-900 px-4 py-3 text-[15px] font-semibold text-white transition hover:bg-[#0f5c3e]" %>

    <div class="mt-2 grid grid-cols-2 gap-2">
      <%= form_with url: bulk_update_follow_up_tasks_path(scope: context[:scope], q: context[:q]), method: :patch do %>
        <%= hidden_field_tag "task_ids[]", task.id %>
        <%= submit_tag "Done", class: "w-full cursor-pointer rounded-xl border border-[#D9DDE0] bg-white px-4 py-2.5 text-sm font-semibold transition hover:border-[#A2E494] hover:text-algae-900 dark:border-white/10 dark:bg-white/5 dark:hover:text-algae-300" %>
      <% end %>
      <%= form_with url: bulk_update_follow_up_tasks_path(scope: context[:scope], q: context[:q]), method: :patch do %>
        <%= hidden_field_tag "task_ids[]", task.id %>
        <%= submit_tag "Snooze 24h", class: "w-full cursor-pointer rounded-xl border border-[#D9DDE0] bg-white px-4 py-2.5 text-sm font-semibold transition hover:border-[#A2E494] hover:text-algae-900 dark:border-white/10 dark:bg-white/5 dark:hover:text-algae-300" %>
      <% end %>
    </div>

    <div class="mt-3 text-center">
      <%= link_to "Full history", contact_path(contact), data: { turbo_frame: "_top" }, class: "text-[13px] font-medium text-[#8a938d] hover:text-algae-900 hover:underline dark:text-[#9AA6A0] dark:hover:text-algae-300" %>
    </div>
  </div>
</div>
