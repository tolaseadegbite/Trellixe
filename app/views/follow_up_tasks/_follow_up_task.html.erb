<% overdue = task.due_at < Time.current %>
<tr id="<%= dom_id(task) %>" class="transition hover:bg-[#F6F9F7] dark:hover:bg-white/[0.04]">
  <td class="px-4 py-3">
    <%= check_box_tag "task_ids[]", task.id, false, class: "h-4 w-4 accent-[#13714C]", data: { action: "check-all#check", check_all_target: "dependant" } %>
  </td>
  <td class="px-3 py-3">
    <span class="flex items-center gap-2.5">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-algae-900 text-[13px] font-bold text-white">
        <%= (task.contact.full_name&.first || "?").upcase %>
      </span>
      <%= link_to task.contact.full_name, contact_path(task.contact), class: "font-semibold hover:text-algae-900 hover:underline dark:hover:text-algae-300", data: { turbo_frame: "_top" } %>
    </span>
  </td>
  <td class="px-3 py-3 text-[#6b7672] dark:text-[#9AA6A0]">
    <%= link_to task.event.name, event_path(task.event), class: "hover:text-algae-900 hover:underline dark:hover:text-algae-300", data: { turbo_frame: "_top" } %>
  </td>
  <td class="px-3 py-3 text-sm tabular-nums <%= overdue ? 'font-semibold text-red-700 dark:text-red-400' : 'text-[#6b7672] dark:text-[#9AA6A0]' %>">
    <% if overdue %>
      Overdue · <%= time_ago_in_words(task.due_at) %> ago
    <% else %>
      <%= l(task.due_at, format: :short) %>
    <% end %>
  </td>
  <td class="px-4 py-3 text-right">
    <%= link_to "Log it", new_follow_up_task_interaction_log_path(task), data: { turbo_frame: "modal" },
        class: "inline-block rounded-lg px-3 py-1.5 text-[13px] font-semibold transition #{overdue ? 'bg-algae-900 text-white hover:bg-[#0f5c3e]' : 'border border-[#D9DDE0] hover:border-[#A2E494] hover:text-algae-900 dark:border-white/10 dark:hover:text-algae-300'}" %>
  </td>
</tr>
