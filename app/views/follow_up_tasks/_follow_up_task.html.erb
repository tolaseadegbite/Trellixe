<tr id="<%= dom_id(task) %>" class="border-b border-main last:border-0 hover:bg-highlight transition">
  <td class="p-3">
    <%= check_box_tag "task_ids[]", task.id, false, class: "input cursor-pointer", data: { action: "check-all#check", check_all_target: "dependant" } %>
  </td>
  
  <td class="p-3 font-medium">
    <%= link_to task.contact.full_name, contact_path(task.contact), class: "text-primary hover:underline", data: { turbo_frame: "_top" } %>
  </td>

  <td class="p-3 text-sm text-subtle">
    <%= task.event.name %>
  </td>

  <td class="p-3 text-sm <%= task.due_at < Time.current ? 'text-red-600 font-bold' : 'text-subtle' %>">
    <% if task.due_at < Time.current %>
      Overdue (<%= time_ago_in_words(task.due_at) %> ago)
    <% else %>
      <%= l(task.due_at, format: :short) %>
    <% end %>
  </td>

  <td class="p-3 text-end">
    <%= link_to new_follow_up_task_interaction_log_path(task), class: "btn btn--primary text-sm", data: { turbo_frame: "_top" } do %>
      Log it
    <% end %>
  </td>
</tr>