<% content_for :title, "Notifications" %>
<% content_for :page_header, "Notifications" %>

<div class="mx-auto w-full max-w-3xl space-y-4">
  <div class="flex items-center justify-between px-1">
    <h2 class="font-display text-[15px] font-semibold">All notifications</h2>
    <%= link_to "Mark all as read", mark_all_as_read_notifications_path,
        data: { turbo_method: :post },
        class: "text-[13px] font-semibold text-algae-900 hover:underline dark:text-algae-300" %>
  </div>

  <div class="overflow-hidden rounded-2xl border border-[#D9DDE0] bg-white dark:border-white/10 dark:bg-[#131B17]">
    <div id="notifications-list">
      <% if @notifications.any? %>
        <%= render partial: "notifications/notification", collection: @notifications, as: :notification %>
      <% else %>
        <%= render "shared/empty_state", title: "You're all caught up", body: "New invites, mentions, and follow-up reminders will land here.", icon_name: "bell" %>
      <% end %>
    </div>
  </div>
</div>
