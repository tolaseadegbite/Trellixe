<%# Opening a notification marks it read (NotificationsController#show),
    so prefetch is disabled: Turbo prefetches hovered links with real GETs,
    and a hover must never flip read state. %>
<%= link_to notification_path(notification),
    id: dom_id(notification),
    class: "block border-b border-[#E9EBED] px-4 py-3 transition last:border-0 hover:bg-[#F6F9F7] dark:border-white/10 dark:hover:bg-white/[0.04] #{'bg-algae-50/60 dark:bg-algae-600/10' if notification.unread?}",
    data: { turbo_prefetch: false }.merge(
      notification.event.type == "FollowUpTaskNotifier" ? { turbo_frame: "modal" } : {}) do %>
  <div class="flex items-center gap-3">
    <% if (actor_url = notification_actor_avatar_url(notification)) %>
      <%= image_tag actor_url, size: 32, alt: "", class: "h-8 w-8 shrink-0 rounded-full object-cover" %>
    <% elsif (avatar_url = notification_avatar_url(notification)) %>
      <%= image_tag avatar_url, size: 32, alt: notification_avatar_initials(notification), class: "h-8 w-8 shrink-0 rounded-full object-cover" %>
    <% else %>
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-algae-900 text-xs font-bold text-white"><%= notification_avatar_initials(notification) %></span>
    <% end %>
    <span class="min-w-0 flex-1">
      <span class="block truncate-2 text-[13.5px] font-medium leading-snug text-[#1c2420] dark:text-[#E7ECE9]" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;"><%= notification_message(notification) %></span>
      <span class="mt-0.5 block text-xs tabular-nums text-[#8a938d] dark:text-[#9AA6A0]"><%= time_ago_in_words(notification.created_at) %> ago</span>
    </span>
    <% if notification.unread? %>
      <span class="h-2 w-2 shrink-0 rounded-full bg-algae-600"></span>
    <% end %>
  </div>
<% end %>
