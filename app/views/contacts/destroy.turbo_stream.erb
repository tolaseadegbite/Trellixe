<%= turbo_stream.remove dom_id(@contact) %>

<%# If no contacts remain, render the empty state directly %>
<% unless Current.account.contacts.exists? %>
  <%= turbo_stream.update "contacts-list", partial: "shared/empty_state", locals: { title: "No contacts yet", body: "Add your first person from Saturday outreach.", icon_name: "card-sim" } %>
<% end %>

<%# Flash Messages %>
<%= turbo_stream.update "flash_messages", partial: "shared/flash" %>
