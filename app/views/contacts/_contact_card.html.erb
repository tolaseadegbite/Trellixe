<div id="<%= dom_id(contact, :card) %>" class="flex items-center gap-3 rounded-2xl border border-[#D9DDE0] bg-white p-3.5 dark:border-white/10 dark:bg-[#131B17]">
  <%= check_box_tag "contact_ids[]", contact.id, false, class: "h-4 w-4 shrink-0 accent-[#13714C]", data: { action: "check-all#check", check_all_target: "dependant" } %>
  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-algae-900 text-sm font-bold text-white">
    <%= (contact.full_name&.first || contact.first_name&.first || contact.email.first).upcase %>
  </span>
  <div class="min-w-0 flex-1">
    <div class="flex items-center justify-between gap-2">
      <%= link_to contact.full_name.titleize, contact, data: { turbo_frame: "_top" }, class: "truncate text-[14.5px] font-semibold" %>
      <%= link_to contact, data: { turbo_frame: "_top" }, class: "flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-[#8a938d] hover:bg-[#F1F4F2] dark:text-[#9AA6A0] dark:hover:bg-white/5" do %><%= icon("eye", css: "h-4 w-4") %><% end %>
    </div>
    <p class="flex items-center gap-1.5 truncate text-[13px] text-[#8a938d] dark:text-[#9AA6A0]"><%= icon("mail", css: "h-3.5 w-3.5") %><%= contact.email.presence || "No email" %></p>
    <p class="flex items-center gap-1.5 truncate text-[13px] text-[#8a938d] dark:text-[#9AA6A0]"><%= icon("phone", css: "h-3.5 w-3.5") %><%= contact.phone_number.presence || "No phone" %></p>
  </div>
</div>
