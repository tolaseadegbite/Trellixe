<% content_for :title, "Contacts" %>

<% content_for :page_header do %>
  <h4 class="font-semibold">Contacts (<%= @pagy.count %>)</h4>
<% end %>

<% content_for :header_action_buttons do %>
    <%= link_to new_contact_path,
                  class: "btn btn--icon bg-blue-500 hover:bg-blue-600 border-0 text-gray-50 i-full",
                  data: { turbo_frame: "modal" } do %>
      <span class="icon icon--user-round-pen"></span>
    <% end %>
<% end %>

<div class="absolute hide@md" style="bottom: 4rem; right: 1rem; z-index: 9999">
  <%= link_to new_contact_path, class: "btn bg-blue-500 hover:bg-blue-600 text-gray-50 p-5 border-0 rounded-full", data: { turbo_frame: "modal" } do %>
    <span class="icon icon--pen"></span>
  <% end %>
</div>

<div class="flex flex-col i-full p-3">
  
  <%# --- 1. SEARCH FORM --- %>
  <div class="search-form pbs-2">
    <%= render "contacts/search_form" %>
  </div>

  <%= turbo_frame_tag :contacts_table do %>

    <%# --- 2. ACTIVE FILTERS (New) --- %>
    <div class="mbe-2">
      <%= render "contacts/active_filters" %>
    </div>

    <%# --- 3. RESULT COUNT FEEDBACK --- %>
    <%# Only show this line if a search is actually active %>
    <% if params[:q].present? %>
      <div class="mbe-4 text-sm text-subtle">
        Found <strong class="text-primary"><%= @pagy.count %></strong> <%= "contact".pluralize(@pagy.count) %> matching your filters.
      </div>
    <% end %>
    
    <%# --- 4. BULK ACTIONS FORM --- %>
    <%= form_with url: bulk_destroy_contacts_path, method: :delete, id: "contacts-bulk-form", data: { controller: "check-all", action: "reset-bulk-ui->check-all#deselectAll" } do |form| %>

      <div id="bulk_actions_bar">
        <div id="bulk_actions_bar_inner" data-check-all-target="actionBar" 
            class="bg-black text-white p-2 rounded-md shadow-lg items-center justify-between border" 
            style="position: fixed; display: none; bottom: 2rem; inline-size: calc(100% - 2rem); max-inline-size: 600px; left: 50%; transform: translateX(-50%); z-index: 10000;">
          
          <div class="flex items-center gap">
            <span class="font-bold text-sm mis-2" data-check-all-target="count">0 selected</span>
          </div>

          <div class="flex items-center gap">
            
            <%# Event Assignment Controls %>
            <div class="flex items-center gap-half bg-surface p-1 rounded-sm border border-main">
              <%= form.select :event_id, 
                    @bulk_event_options, 
                    { prompt: "Select Event..." }, 
                    class: "input cursor-pointer border-0", 
                    style: "min-inline-size: 140px; padding-block: 0.25rem;" %>
              
              <%= form.button "Add", 
                    formaction: bulk_assign_event_contacts_path, 
                    formmethod: :post,
                    class: "btn bg-teal-600 hover:bg-teal-700 text-gray-50 font-semibold rounded-sm text-xs border-0",
                    style: "padding: 0.25rem 0.75rem;" %>
            </div>

            <%# Delete Control %>
            <%= form.button formaction: bulk_destroy_contacts_path, 
                            formmethod: :delete,
                            data: { turbo_confirm: "Delete selected contacts?" },
                            class: "btn bg-red-600 hover:bg-red-700 text-gray-50 border-0 text-xs" do %>
              <span class="icon icon--btn icon--trash-2"></span>
            <% end %>

          </div>
        </div>
      </div>

      <%# --- DESKTOP VIEW --- %>
      <div class="show@md">
        <div class="relative i-full overflow-x-auto border border-main rounded-lg">
          <table class="table i-full text-left">
            <thead class="bg-shade font-semibold text-xs uppercase text-subtle">
              <tr>
                <th class="p-3 w-8"><%= check_box_tag :check_all, nil, false, class: "input cursor-pointer", data: { action: "check-all#check", check_all_target: "dependee" } %></th>
                <th class="p-3"><%= sort_link(@search, :first_name, class: "flex items-center") %></th>
                <th class="p-3"><%= sort_link(@search, :last_name, class: "flex items-center") %></th>
                <th class="p-3"><%= sort_link(@search, :email, class: "flex items-center") %></th>
                <th class="p-3"><%= sort_link(@search, :phone_number, class: "flex items-center") %></th>
                <th class="p-3 text-end"></th>
              </tr>
            </thead>
            <tbody id="contacts-table">
              <% if @contacts.empty? %>
                <%= render "shared/empty_state_desktop" %>
              <% else %>
                <%= render @contacts %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <%# --- MOBILE VIEW --- %>
      <div class="hide@md flex flex-col">
        <div class="flex items-center gap pb-2 pi-1">
          <%= check_box_tag "check_all_mobile", nil, false, class: "input cursor-pointer", data: { action: "check-all#check", check_all_target: "dependee" } %>
          <label for="check_all_mobile" class="font-medium cursor-pointer">Select all</label>
        </div>
        
        <div id="contacts-cards">
          <% if @contacts.empty? %>
            <%= render "shared/empty_state_mobile" %>
          <% else %>
            <%= render partial: "contacts/contact_card", collection: @contacts, as: :contact %>
          <% end %>
        </div>
      </div>

      <%= render "shared/pagination", pagy: @pagy %>
    <% end %> <%# End form_with %>
  <% end %> <%# End turbo_frame %>
</div>