<% return unless params[:q].present? %>
<% safe_params = params.fetch(:q, {}).permit(:combined_search_cont, :invitations_event_id_eq, :invitations_status_eq, :created_at_gteq) %>

<div class="flex flex-wrap items-center gap-1.5">
  <span class="text-xs font-semibold text-[#8a938d] dark:text-[#9AA6A0]">Active:</span>
  <% if safe_params[:combined_search_cont].present? %>
    <span class="flex items-center gap-1.5 rounded-full border border-[#D9DDE0] bg-white py-1 pl-3 pr-1.5 text-xs dark:border-white/10 dark:bg-[#131B17]">
      “<%= safe_params[:combined_search_cont] %>”
      <%= link_to contacts_path(q: safe_params.except(:combined_search_cont)), data: { turbo_frame: "_top" }, class: "flex h-5 w-5 items-center justify-center rounded-full hover:bg-[#E9EBED] dark:hover:bg-white/10" do %><%= icon("x", css: "h-3 w-3") %><% end %>
    </span>
  <% end %>
  <% if safe_params[:invitations_event_id_eq].present? %>
    <% event_name = @filterable_events.find { |e| e.id.to_s == safe_params[:invitations_event_id_eq].to_s }&.name || "Event" %>
    <span class="flex items-center gap-1.5 rounded-full border border-[#D9DDE0] bg-white py-1 pl-3 pr-1.5 text-xs dark:border-white/10 dark:bg-[#131B17]">
      <%= event_name %>
      <%= link_to contacts_path(q: safe_params.except(:invitations_event_id_eq)), data: { turbo_frame: "_top" }, class: "flex h-5 w-5 items-center justify-center rounded-full hover:bg-[#E9EBED] dark:hover:bg-white/10" do %><%= icon("x", css: "h-3 w-3") %><% end %>
    </span>
  <% end %>
  <% if safe_params[:invitations_status_eq].present? %>
    <span class="flex items-center gap-1.5 rounded-full border border-[#D9DDE0] bg-white py-1 pl-3 pr-1.5 text-xs dark:border-white/10 dark:bg-[#131B17]">
      <%= Invitation.statuses.key(safe_params[:invitations_status_eq].to_i)&.humanize %>
      <%= link_to contacts_path(q: safe_params.except(:invitations_status_eq)), data: { turbo_frame: "_top" }, class: "flex h-5 w-5 items-center justify-center rounded-full hover:bg-[#E9EBED] dark:hover:bg-white/10" do %><%= icon("x", css: "h-3 w-3") %><% end %>
    </span>
  <% end %>
  <%= link_to "Clear all", contacts_path, data: { turbo_frame: "_top" }, class: "ml-1 text-xs font-semibold text-red-700 hover:underline dark:text-red-400" %>
</div>
