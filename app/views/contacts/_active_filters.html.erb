<% safe_params = present_filter_params(:combined_search_cont, :invitations_event_id_eq, :invitations_status_eq, :created_at_gteq) %>
<% return if safe_params.empty? %>
<% pill = "flex items-center gap-1.5 rounded-full border border-[#D9DDE0] bg-white py-1 pl-3 pr-1.5 text-xs dark:border-white/10 dark:bg-[#131B17]" %>
<% dismiss = "flex h-5 w-5 items-center justify-center rounded-full hover:bg-[#E9EBED] dark:hover:bg-white/10" %>

<div class="flex flex-wrap items-center gap-1.5">
  <span class="text-xs font-semibold text-[#8a938d] dark:text-[#9AA6A0]">Active:</span>
  <% if safe_params[:combined_search_cont].present? %>
    <span class="<%= pill %>">
      “<%= safe_params[:combined_search_cont] %>”
      <%= button_tag type: "button", title: "Remove filter", data: { action: "click->search-filter#removeFilter", search_filter_names_param: "q[combined_search_cont]" }, class: dismiss do %><%= icon("x", css: "h-3 w-3") %><% end %>
    </span>
  <% end %>
  <% if safe_params[:invitations_event_id_eq].present? %>
    <% event_name = @filterable_events.find { |e| e.id.to_s == safe_params[:invitations_event_id_eq].to_s }&.name || "Event" %>
    <span class="<%= pill %>">
      <%= event_name %>
      <%= button_tag type: "button", title: "Remove filter", data: { action: "click->search-filter#removeFilter", search_filter_names_param: "q[invitations_event_id_eq]" }, class: dismiss do %><%= icon("x", css: "h-3 w-3") %><% end %>
    </span>
  <% end %>
  <% if safe_params[:invitations_status_eq].present? %>
    <span class="<%= pill %>">
      <%= Invitation.statuses.key(safe_params[:invitations_status_eq].to_i)&.humanize %>
      <%= button_tag type: "button", title: "Remove filter", data: { action: "click->search-filter#removeFilter", search_filter_names_param: "q[invitations_status_eq]" }, class: dismiss do %><%= icon("x", css: "h-3 w-3") %><% end %>
    </span>
  <% end %>
  <% if safe_params[:created_at_gteq].present? %>
    <span class="<%= pill %>">
      Added after <%= safe_params[:created_at_gteq] %>
      <%= button_tag type: "button", title: "Remove filter", data: { action: "click->search-filter#removeFilter", search_filter_names_param: "q[created_at_gteq]" }, class: dismiss do %><%= icon("x", css: "h-3 w-3") %><% end %>
    </span>
  <% end %>
  <%= button_tag "Clear all", type: "button", data: { action: "click->search-filter#resetAll" }, class: "ml-1 text-xs font-semibold text-red-700 hover:underline dark:text-red-400" %>
</div>
