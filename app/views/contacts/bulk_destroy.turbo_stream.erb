<%# 1. Update Flash Messages %>
<%= turbo_stream.update "flash_messages", partial: "shared/flash" %>

<%# 2. Loop through the deleted IDs and remove the unified rows %>
<% @contact_ids.each do |id| %>
  <%= turbo_stream.remove "contact_#{id}" %>
<% end %>

<%# 3. Reset UI via Stimulus (uncheck boxes, hide action bar) %>
<%= turbo_stream.append "contacts-bulk-form" do %>
  <script>
    document.getElementById("contacts-bulk-form").dispatchEvent(new CustomEvent("reset-bulk-ui"));
  </script>
<% end %>
