<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= full_title(yield(:title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= render "shared/font_faces" %>
    <%= javascript_importmap_tags %>
  </head>

  <% auth_pages = controller_name.in?(%w[sessions passwords registrations passwordlesses password_resets]) %>

  <body class="min-h-screen bg-[#F1F4F2] font-sans text-[#1c2420] antialiased dark:bg-[#0C1210] dark:text-[#E7ECE9]" data-controller="color-scheme">

    <div id="flash_messages">
      <%= render "shared/flash" %>
    </div>

    <% if controller_name == "pages" %>
      <%= render "layouts/navigation/application/navbar" %>
    <% end %>

    <% if auth_pages %>
      <%= yield %>
    <% else %>
      <main id="main">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
