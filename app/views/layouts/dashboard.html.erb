<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= full_title(yield(:title)) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= tag.meta name: "vapid_key", content: Rails.application.credentials.vapid[:public_key] %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <%# <link rel="icon" href="/icon.svg" type="image/svg+xml"> %>
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "css-zero/reset", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "css-zero/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "css-zero/utilities", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# 1. Listen for Global Events (Invitations) %>
    <%= turbo_stream_from "notifications_#{current_user.id}_global" %>

    <%# 2. Listen for Context-Specific Events (Role changes in THIS workspace) %>
    <% if Current.account %>
    <%= turbo_stream_from "notifications_#{current_user.id}_account_#{Current.account.id}" %>
    <% end %>

  </head>

  <body class="bg-main" data-controller="color-scheme ">

    <div id="flash_messages">
      <%= render "shared/flash" %>
    </div>

    <%#= render "layouts/navigation/navbar" %>

    <div class="sidebar-layout">
      <aside id="sidebar">
        <%= render "layouts/navigation/dashboard/sidebar_menu" %>
      </aside>

      <main id="main" style="padding: 0; gap: 0">
        <div class="header-layout">
          <header class="" id="header">
            <%= render "layouts/navigation/dashboard/mobile_menu" %>
            <%= render "layouts/navigation/dashboard/header_menu" %>
          </header>
        
          <%= yield %>
        </div>
      </main>
    </div>

    <%= turbo_frame_tag "modal" %>
    
  </body>
</html>