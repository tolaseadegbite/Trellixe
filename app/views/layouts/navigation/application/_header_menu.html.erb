<div class="flex items-center justify-between">
  <div class="flex items-center gap-2">
    <%= link_to root_path, class: "flex items-center gap-2" do %>
      <%= image_tag "logo/trellixe-mark.svg", size: 30, alt: "Trellixe", class: "h-[30px] w-[30px] rounded-lg" %>
      <span class="font-display text-lg font-bold tracking-tight text-[#13714C]">Trellixe</span>
    <% end %>
  </div>
  <% if user_signed_in? %>
    <%= link_to "Open dashboard", dashboard_path, class: "rounded-lg bg-algae-900 px-4 py-2 text-sm font-semibold text-white" %>
  <% else %>
    <%= link_to "Log in", sign_in_path, class: "rounded-lg bg-algae-900 px-4 py-2 text-sm font-semibold text-white" %>
  <% end %>
</div>
