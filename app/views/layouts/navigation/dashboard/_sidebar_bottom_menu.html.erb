<div class="border-t border-[#E9EBED] p-3 dark:border-white/10">
  <div class="hidden md:block">
    <div class="space-y-0.5">
      <div data-controller="popover" data-popover-placement-value="right-end" data-action="click@window->popover#clickOutside" class="relative">
        <%= button_tag type: "button", class: "flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-left text-[13.5px] font-medium text-[#3d4742] transition hover:bg-[#F1F4F2] dark:text-[#C6CFC9] dark:hover:bg-white/5",
            popovertarget: "notifications-popover",
            data: { popover_target: "trigger" } do %>
          <span class="relative">
            <%= icon("bell", css: "h-[18px] w-[18px] text-[#8a938d] dark:text-[#9AA6A0]") %>
            <%= render "notifications/badge", unread: context_notifications.unread.any?, id_suffix: "sidebar" %>
          </span>
          Notifications
        <% end %>
        <%= tag.div popover: "auto", id: "notifications-popover", class: "tlx-popover w-[380px] overflow-hidden", data: { popover_target: "content" } do %>
          <div class="flex items-center justify-between border-b border-[#E9EBED] bg-white px-4 py-3 dark:border-white/10 dark:bg-transparent">
            <h3 class="font-display text-[15px] font-semibold">Notifications</h3>
            <%= link_to "Mark all as read", mark_all_as_read_notifications_path, data: { turbo_method: :post }, class: "text-xs font-medium text-algae-900 hover:underline dark:text-algae-300" if context_notifications.any? %>
          </div>
          <div class="max-h-[380px] overflow-y-auto" id="sidebar-notifications-list">
            <%= render partial: "notifications/notification", collection: context_notifications.limit(10) %>
            <% if context_notifications.empty? %>
              <p class="px-4 py-8 text-center text-sm text-[#8a938d] dark:text-[#9AA6A0] dark:text-[#9AA6A0]">Nothing new. When someone RSVPs or a follow-up comes due, it lands here.</p>
            <% end %>
          </div>
          <% if context_notifications.any? %>
            <div class="border-t border-[#E9EBED] bg-white p-2 dark:border-white/10 dark:bg-transparent">
              <%= link_to "View all notifications", notifications_path, class: "flex items-center justify-center rounded-lg bg-algae-900 px-3 py-2 text-xs font-semibold text-white transition hover:bg-[#0f5c3e]" %>
            </div>
          <% end %>
        <% end %>
      </div>

      <div data-controller="popover" data-popover-placement-value="right-end" data-action="click@window->popover#clickOutside" class="relative">
        <%= button_tag type: "button", class: "flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-left text-[13.5px] font-medium text-[#3d4742] transition hover:bg-[#F1F4F2] dark:text-[#C6CFC9] dark:hover:bg-white/5",
            popovertarget: "dashboard-theme-switcher-popover",
            data: { popover_target: "trigger" }, aria: { haspopup: "true" } do %>
          <%= icon("sun", css: "h-[18px] w-[18px] text-[#8a938d] dark:text-[#9AA6A0]") %>
          <span class="flex-1">Theme</span>
          <%= icon("chevron-right", css: "h-4 w-4 text-[#8a938d] dark:text-[#9AA6A0]") %>
        <% end %>
        <%= tag.div popover: "auto", id: "dashboard-theme-switcher-popover", class: "tlx-popover w-40 p-1.5", data: { popover_target: "content" } do %>
          <button type="button" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-[13px] hover:bg-[#F1F4F2] dark:hover:bg-white/5" data-action="popover#hide color-scheme#setLight"><%= icon("sun", css: "h-4 w-4") %> Light</button>
          <button type="button" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-[13px] hover:bg-[#F1F4F2] dark:hover:bg-white/5" data-action="popover#hide color-scheme#setDark"><%= icon("moon", css: "h-4 w-4") %> Dark</button>
          <button type="button" class="flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-[13px] hover:bg-[#F1F4F2] dark:hover:bg-white/5" data-action="popover#hide color-scheme#setSystem"><%= icon("laptop", css: "h-4 w-4") %> System</button>
        <% end %>
      </div>

      <div data-controller="popover" data-popover-placement-value="right-end" data-action="click@window->popover#clickOutside" class="relative">
          <%= button_tag type: "button", class: "flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-left transition hover:bg-[#F1F4F2] dark:hover:bg-white/5",
            popovertarget: "user-menu-popover",
            data: { popover_target: "trigger" }, aria: { haspopup: "true" } do %>
          <%= image_tag user_avatar_url(current_user, size: 64), size: 32, alt: current_user.name, class: "h-8 w-8 rounded-full object-cover" %>
          <span class="min-w-0 flex-1 leading-tight">
            <span class="flex items-center gap-1.5">
              <span class="truncate text-[13px] font-semibold"><%= current_user.name %></span>
              <% if current_user.verified? %>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="#3AB67D" aria-hidden="true"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd"/></svg>
              <% end %>
            </span>
            <span class="block truncate text-xs text-[#8a938d] dark:text-[#9AA6A0] dark:text-[#9AA6A0]"><%= current_user.email %></span>
          </span>
        <% end %>
        <%= tag.div popover: "auto", id: "user-menu-popover", class: "tlx-popover w-52 p-1.5", data: { popover_target: "content" } do %>
          <%= link_to "Account settings", settings_path, class: "flex items-center gap-2 rounded-lg px-2.5 py-2 text-[13px] hover:bg-[#F1F4F2] dark:hover:bg-white/5" %>
          <%= button_to "Sign out", Current.session, method: :delete, class: "flex w-full items-center gap-2 rounded-lg px-2.5 py-2 text-left text-[13px] text-red-700 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-500/10" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="md:hidden">
    <%= link_to notifications_path, class: "flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-[13.5px] font-medium text-[#3d4742] hover:bg-[#F1F4F2] dark:text-[#C6CFC9] dark:hover:bg-white/5" do %>
      <span class="relative"><%= icon("bell", css: "h-[18px] w-[18px]") %><%= render "notifications/badge", unread: context_notifications.unread.any?, id_suffix: "sidebar-m" %></span>
      Notifications
    <% end %>
    <%= link_to settings_path, class: "flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-[13.5px] font-medium text-[#3d4742] hover:bg-[#F1F4F2] dark:text-[#C6CFC9] dark:hover:bg-white/5" do %>
      <%= image_tag user_avatar_url(current_user, size: 64), size: 28, alt: current_user.name, class: "h-7 w-7 rounded-full object-cover" %>
      <span class="truncate"><%= current_user.name %></span>
    <% end %>
    <%= button_to "Sign out", Current.session, method: :delete, class: "mt-1 flex w-full items-center gap-2.5 rounded-lg px-2.5 py-2 text-left text-[13.5px] font-medium text-red-700 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-500/10" %>
  </div>
</div>
