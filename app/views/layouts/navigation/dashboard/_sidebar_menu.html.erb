<div class="sidebar-menu b-full flex flex-col">
  
  <%# --- HEADER: Logo & Toggle --- %>
  <div class="flex items-center justify-between mbs-2 mbe- pis-1">
    <%= link_to root_path, class: "flex items-center gap-2 text-decoration-none" do %>
      <%# Fixed-width container for logo alignment in collapsed mode %>
      <div class="flex items-center justify-center" style="inline-size: 2.25rem;">
        <%= image_tag("logo/logo.png", style: "inline-size: 30px; block-size: auto;") %>
      </div>
      <%# <h3 class="text-xl sidebar-label font-bold text-primary">Trellixe</h3> %>
    <% end %>
    
    <%# Toggle Button (Desktop Only) %>
    <!--<button type="button" 
            class="btn btn--icon show@md border-0 cursor-pointer sidebar-label" 
            data-action="sidebar#toggle"
            title="Toggle Sidebar">
      <span class="icon icon--panel-left"></span>
    </button>-->
  </div>

  <%# --- WORKSPACE SWITCHER --- %>
  <div contents class="mbe-6" data-controller="popover" data-popover-placement-value="bottom-start" data-action="click@window->popover#clickOutside">
    <%= button_tag type: "button", class: "btn sidebar-menu__button workspace-button i-full", data: { action: "click->popover#toggle", popover_target: "trigger" } do %>
      <div class="flex flex-item-no-shrink overflow-hidden rounded-md bg-emerald-500">
        <div class="flex items-center justify-center font-bold text-gray-50 text-sm" style="inline-size: 2.25rem; block-size: 2.25rem;">
          <%= account_initials(Current.account) %> 
        </div>
      </div>

      <div class="flex flex-col text-start leading-tight overflow-hidden mis-2 sidebar-label">
        <span class="overflow-ellipsis font-semibold text-primary"><%= Current.account.name %></span>
        <span class="overflow-ellipsis text-xs text-subtle capitalize"><%= current_role %></span>
      </div>
      
      <span class="icon icon--chevrons-up-down mis-auto text-subtle sidebar-label" aria-hidden="true"></span>
    <% end %>

    <%# Switcher Popover %>
    <%= tag.div popover: true, id: "workspace-switcher-popover", class: "popover", style: "--popover-size: 16rem;", data: { popover_target: "content" } do %>
       <div class="p-2 text-xs font-semibold text-subtle uppercase i-full">Switch Workspace</div>
       <div class="menu i-full" role="menu">
          <% Current.user.accounts.each do |account| %>
            <% is_active = account == Current.account %>
            
            <% if is_active %>
              <%# Non-clickable Active State %>
              <div class="btn menu__item justify-between i-full bg-emerald-700 hover:bg-emerald-700 text-gray-50" style="cursor: default;" role="menuitem">
                <div class="flex items-center gap-2">
                  <div class="p-1 rounded-md flex items-center justify-center text-xs font-bold bg-black text-reversed" style="inline-size: 1.7rem; block-size: 1.7rem;">
                    <%= account_initials(account) %>
                  </div>
                  <span class="font-bold"><%= account.name %></span>
                </div>
                <span class="icon icon--check text-gray-50"></span>
              </div>
            <% else %>
              <%# Clickable Link %>
              <%= link_to switch_account_path(account), data: { turbo_method: :post }, class: "btn menu__item justify-between i-full hover:bg-shade", role: "menuitem" do %>
                <div class="flex items-center gap-2">
                  <div class="p-1 rounded-md flex items-center justify-center text-xs bg-black text-reversed" style="inline-size: 1.7rem; block-size: 1.7rem;">
                    <%= account_initials(account) %>
                  </div>
                  <span><%= account.name %></span>
                </div>
              <% end %>
            <% end %>
          <% end %>
          <hr class="menu__separator m-1" />
          <%= link_to new_account_path, class: "btn menu__item", data: { turbo_frame: "modal" } do %>
            <span class="icon icon--plus"></span> Create Workspace
          <% end %>
       </div>
    <% end %>
  </div>

  <%# --- MAIN CONTENT --- %>
  <div class="sidebar-menu__content flex-1">
    
    <%# GROUP 1: CRM (Core Features) %>
    <div class="sidebar-menu__group">
      <div class="sidebar-menu__group-label sidebar-label">PRM</div>
      <div class="sidebar-menu__items">
        
        <%= link_to dashboard_path, class: "btn sidebar-menu__button", aria: (current_page?(dashboard_path) ? { current: "page" } : {}) do %>
          <span class="icon icon--chart-pie"></span>
          <span class="sidebar-label mis-2">Dashboard</span>
        <% end %>

        <%= link_to contacts_path, class: "btn sidebar-menu__button", aria: (current_page?(contacts_path) ? { current: "page" } : {}) do %>
          <span class="icon icon--card-sim"></span>
          <span class="sidebar-label mis-2">Contacts</span>
        <% end %>

        <%= link_to events_path, class: "btn sidebar-menu__button", aria: (current_page?(events_path) ? { current: "page" } : {}) do %>
          <span class="icon icon--calendar-range"></span>
          <span class="sidebar-label mis-2">Events</span>
        <% end %>

        <%= link_to follow_up_tasks_path, class: "btn sidebar-menu__button", aria: (current_page?(follow_up_tasks_path) ? { current: "page" } : {}) do %>
          <span class="icon icon--list-checks"></span>
          <span class="sidebar-label mis-2 flex-1">Follow ups</span>
          
          <%# Task Counter %>
          <% task_count = current_user.follow_up_tasks.for_account(Current.account).where(completed_at: nil).count %>
          <% if task_count > 0 %>
            <div class="badge badge--number badge--negative sidebar-label">
              <%= task_count %>
            </div>
          <% end %>
        <% end %>

      </div>
    </div>

    <%# GROUP 2: CONFIGURATION (Team/Settings) %>
    <div class="sidebar-menu__group mbs-4">
      <div class="sidebar-menu__group-label sidebar-label">Configuration</div>
      <div class="sidebar-menu__items">
        <% settings_active = request.path.include?('settings') || request.path.include?('members') %>
        
        <details <%= 'open' if settings_active ? 'open' : '' %>>
          <summary class="btn sidebar-menu__button">
            <span class="icon icon--settings"></span>
            <span class="sidebar-label mis-2">Workspace Settings</span>
          </summary>
          <nav class="sidebar-menu__sub">
            
            <% if current_role == "admin" %>
              <%= link_to edit_account_path(Current.account), class: "btn sidebar-menu__button" do %>
                <span class="sidebar-label">General</span>
              <% end %>
            <% end %>

            <%= link_to members_path, class: "btn sidebar-menu__button" do %>
              <span class="sidebar-label">Team Members</span>
            <% end %>

            <% if current_role == "admin" %>
              <%= link_to "#", class: "btn sidebar-menu__button" do %>
                <span class="sidebar-label">Billing</span>
              <% end %>
            <% end %>

            <%= link_to "#", class: "btn sidebar-menu__button" do %>
              <span class="sidebar-label">Limits</span>
            <% end %>
          </nav>
        </details>
      </div>
    </div>
  </div>

  <%# --- FOOTER (Notifications & Profile) --- %>
  <%= render "layouts/navigation/dashboard/sidebar_bottom_menu" %>
</div>