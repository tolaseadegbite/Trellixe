<% active = ->(path) { current_page?(path) || request.path.start_with?(path.to_s) } %>
<div class="flex h-full flex-col">
  <% unless local_assigns[:hide_logo] %>
  <div class="flex items-center gap-2.5 px-4 pb-4 pt-5">
    <%= link_to root_path, class: "flex items-center gap-2.5" do %>
      <%= image_tag "logo/trellixe-mark.svg", size: 32, alt: "Trellixe", class: "h-8 w-8 rounded-lg" %>
      <span class="font-display text-[19px] font-bold tracking-tight text-[#13714C] dark:text-algae-300">Trellixe</span>
    <% end %>
  </div>
  <% end %>

  <div class="px-3 <%= "pt-3" if local_assigns[:hide_logo] %>">
    <div data-controller="popover" data-popover-placement-value="bottom-start" data-action="click@window->popover#clickOutside" class="relative">
      <%= button_tag type: "button",
          class: "flex w-full items-center gap-2.5 rounded-xl border border-[#D9DDE0] bg-white px-2.5 py-2 text-left transition hover:border-[#A2E494] hover:bg-[#EEF9F1] dark:border-white/10 dark:bg-white/5 dark:hover:border-algae-600/50 dark:hover:bg-white/10",
          popovertarget: "workspace-switcher-popover",
          data: { popover_target: "trigger" } do %>
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-algae-900 text-[13px] font-bold text-white">
          <%= account_initials(Current.account) %>
        </span>
        <span class="min-w-0 flex-1 leading-tight">
          <span class="block truncate text-[13.5px] font-semibold text-[#1c2420] dark:text-[#E7ECE9]"><%= Current.account.name %></span>
          <span class="block truncate text-xs capitalize text-[#5b6660] dark:text-[#9AA6A0]"><%= current_role %></span>
        </span>
        <%= icon("chevrons-up-down", css: "h-4 w-4 shrink-0 text-[#5b6660]") %>
      <% end %>

      <%= tag.div popover: "auto", id: "workspace-switcher-popover", class: "tlx-popover w-64 p-2", data: { popover_target: "content" } do %>
        <p class="px-2.5 pb-1.5 pt-1.5 text-[11px] font-semibold uppercase tracking-wide text-[#5b6660] dark:text-[#9AA6A0]">Switch workspace</p>
        <div class="space-y-1">
        <% Current.user.accounts.each do |account| %>
          <% is_active = account == Current.account %>
          <% if is_active %>
            <div class="flex items-center justify-between rounded-xl bg-algae-900 px-2.5 py-2 text-white">
              <span class="flex min-w-0 items-center gap-2">
                <span class="flex h-7 w-7 items-center justify-center rounded-md bg-white/15 text-xs font-bold"><%= account_initials(account) %></span>
                <span class="truncate text-[13px] font-semibold"><%= account.name %></span>
              </span>
              <%= icon("check", css: "h-4 w-4") %>
            </div>
          <% else %>
            <%= link_to switch_account_path(account), data: { turbo_method: :post },
                class: "flex items-center gap-2 rounded-xl px-2.5 py-2 text-[13px] text-[#1c2420] transition hover:bg-[#EEF9F1] dark:text-[#E7ECE9] dark:hover:bg-white/5" do %>
              <span class="flex h-7 w-7 items-center justify-center rounded-md bg-[#1c2420] text-xs font-bold text-white"><%= account_initials(account) %></span>
              <span class="truncate"><%= account.name %></span>
            <% end %>
          <% end %>
        <% end %>
        </div>
        <div class="my-2 border-t border-[#E9EBED] dark:border-white/10"></div>
        <%= link_to new_account_path, data: { turbo_frame: "modal" },
            class: "flex items-center gap-2 rounded-lg px-2.5 py-2 text-[13px] font-medium text-algae-900 transition hover:bg-[#EEF9F1] dark:text-algae-300 dark:hover:bg-white/5" do %>
          <%= icon("plus", css: "h-4 w-4") %> New workspace
        <% end %>
      <% end %>
    </div>
  </div>

  <nav class="tlx-scroll mt-4 flex-1 overflow-y-auto px-3 pb-4" aria-label="Primary">
    <p class="px-2.5 pb-1.5 text-[11px] font-semibold uppercase tracking-[0.08em] text-[#8a938d] dark:text-[#9AA6A0]">Outreach</p>
    <div class="space-y-0.5">
      <%= link_to dashboard_path,
          class: "flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-[13.5px] font-medium transition #{active.(dashboard_path) ? 'bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300' : 'text-[#3d4742] hover:bg-[#F1F4F2] dark:text-[#C6CFC9] dark:hover:bg-white/5'}" do %>
        <%= icon("chart-pie", css: "h-[18px] w-[18px] #{active.(dashboard_path) ? 'text-algae-900 dark:text-algae-300' : 'text-[#8a938d] dark:text-[#9AA6A0]'}") %>
        Dashboard
      <% end %>
      <%= link_to contacts_path,
          class: "flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-[13.5px] font-medium transition #{active.(contacts_path) ? 'bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300' : 'text-[#3d4742] hover:bg-[#F1F4F2] dark:text-[#C6CFC9] dark:hover:bg-white/5'}" do %>
        <%= icon("card-sim", css: "h-[18px] w-[18px] #{active.(contacts_path) ? 'text-algae-900 dark:text-algae-300' : 'text-[#8a938d] dark:text-[#9AA6A0]'}") %>
        Contacts
      <% end %>
      <%= link_to events_path,
          class: "flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-[13.5px] font-medium transition #{active.(events_path) && !request.path.include?('event_series') ? 'bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300' : 'text-[#3d4742] hover:bg-[#F1F4F2] dark:text-[#C6CFC9] dark:hover:bg-white/5'}" do %>
        <%= icon("calendar-range", css: "h-[18px] w-[18px] text-[#8a938d] dark:text-[#9AA6A0]") %>
        Events
      <% end %>
      <%= link_to event_series_index_path,
          class: "flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-[13.5px] font-medium transition #{request.path.include?('event_series') ? 'bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300' : 'text-[#3d4742] hover:bg-[#F1F4F2] dark:text-[#C6CFC9] dark:hover:bg-white/5'}" do %>
        <%= icon("calendar-plus", css: "h-[18px] w-[18px] text-[#8a938d] dark:text-[#9AA6A0]") %>
        Series
      <% end %>
      <%= link_to follow_up_tasks_path,
          class: "flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-[13.5px] font-medium transition #{active.(follow_up_tasks_path) ? 'bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300' : 'text-[#3d4742] hover:bg-[#F1F4F2] dark:text-[#C6CFC9] dark:hover:bg-white/5'}" do %>
        <%= icon("list-checks", css: "h-[18px] w-[18px] #{active.(follow_up_tasks_path) ? 'text-algae-900 dark:text-algae-300' : 'text-[#8a938d] dark:text-[#9AA6A0]'}") %>
        <span class="flex-1">Follow-ups</span>
        <% task_count = current_user.follow_up_tasks.for_account(Current.account).where(completed_at: nil).count %>
        <% if task_count > 0 %>
          <span class="flex h-5 min-w-5 items-center justify-center rounded-full bg-algae-900 px-1.5 text-[11px] font-bold tabular-nums text-white"><%= task_count %></span>
        <% end %>
      <% end %>
      <%= link_to tags_path,
          class: "flex items-center gap-2.5 rounded-lg px-2.5 py-2 text-[13.5px] font-medium transition #{active.(tags_path) ? 'bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300' : 'text-[#3d4742] hover:bg-[#F1F4F2] dark:text-[#C6CFC9] dark:hover:bg-white/5'}" do %>
        <%= icon("tags", css: "h-[18px] w-[18px] text-[#8a938d] dark:text-[#9AA6A0]") %>
        Tags
      <% end %>
    </div>

    <p class="px-2.5 pb-1.5 pt-5 text-[11px] font-semibold uppercase tracking-[0.08em] text-[#8a938d] dark:text-[#9AA6A0]">Workspace</p>
    <div class="space-y-0.5">
      <% settings_active = request.path.start_with?("/settings") || controller_name.in?(%w[accounts members notifications]) %>
      <details <%= "open" if settings_active %> class="group">
        <summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-[13.5px] font-medium transition <%= settings_active ? 'bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300' : 'text-[#3d4742] hover:bg-[#F1F4F2] dark:text-[#C6CFC9] dark:hover:bg-white/5' %> [&::-webkit-details-marker]:hidden">
          <%= icon("settings", css: "h-[18px] w-[18px] #{settings_active ? 'text-algae-900 dark:text-algae-300' : 'text-[#8a938d] dark:text-[#9AA6A0]'}") %>
          <span class="flex-1">Settings</span>
          <%= icon("chevron-down", css: "h-4 w-4 text-[#8a938d] dark:text-[#9AA6A0] transition group-open:rotate-180") %>
        </summary>
        <div class="ml-[26px] mt-0.5 space-y-0.5 border-l border-[#E9EBED] pl-3 dark:border-white/10">
          <% if can_manage_settings? %>
            <%= link_to "General", edit_account_path(Current.account), class: "block rounded-md px-2 py-1.5 text-[13px] text-[#3d4742] hover:bg-[#F1F4F2] dark:text-[#C6CFC9] dark:hover:bg-white/5 hover:text-algae-900 dark:hover:text-algae-300" %>
          <% end %>
          <%= link_to "Team members", members_path, class: "block rounded-md px-2 py-1.5 text-[13px] text-[#3d4742] hover:bg-[#F1F4F2] dark:text-[#C6CFC9] dark:hover:bg-white/5 hover:text-algae-900 dark:hover:text-algae-300" %>
        </div>
      </details>
    </div>
  </nav>

  <%= render "layouts/navigation/dashboard/sidebar_bottom_menu" %>
</div>
