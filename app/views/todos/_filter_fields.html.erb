<%# Todos filter fields for the shared search bar. Locals: f (filter form builder). %>
<div class="grid grid-cols-2 gap-3">
  <div>
    <%= f.label :user_id_eq, "Assigned to", class: "mb-1 block text-[11px] font-semibold uppercase tracking-wide text-[#8a938d] dark:text-fog" %>
    <%= f.collection_select :user_id_eq, Current.account.users.order(:email), :id, :full_name, { include_blank: "Anyone" },
        { class: "w-full rounded-lg border border-[#D9DDE0] bg-[#F6F9F7] h-10 px-3 text-sm outline-none transition focus:border-algae-600 focus:bg-white focus:ring-2 focus:ring-algae-300/50 dark:border-white/10 dark:bg-white/[0.03] dark:focus:bg-night", data: { action: "input->debounce#submit" } } %>
  </div>
  <div class="flex items-end">
    <%= button_tag "Reset", type: "button", data: { action: "click->search-filter#resetAll" },
        class: "w-full rounded-lg border border-[#D9DDE0] bg-white flex h-10 items-center justify-center px-3 text-sm font-semibold transition hover:border-algae-300 dark:border-white/10 dark:bg-white/5" %>
  </div>
</div>
