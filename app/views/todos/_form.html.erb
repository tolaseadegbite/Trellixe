<%# Todo form for the new/edit modals. Locals: todo. Assignee and
    visibility pickers render for admins only; members always create
    personal todos for themselves (enforced in the controller). %>
<%= form_with(model: todo) do |form| %>
  <% if todo.errors.any? %>
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-500/30 dark:bg-red-500/10 dark:text-red-300" role="alert">
      <p class="font-semibold"><%= pluralize(todo.errors.count, "error") %> stopped this todo from saving:</p>
      <ul class="mt-1 list-disc pl-5"><% todo.errors.each do |error| %><li><%= error.full_message %></li><% end %></ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "mb-1 block text-[13px] font-semibold" %>
    <%= form.text_field :title, required: true, autofocus: true, placeholder: "e.g. Pray for Ada this week",
        class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-[16px] outline-none transition placeholder:text-[#a7b0aa] focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]" %>
  </div>

  <div class="mt-3 grid gap-3">
    <div id="todo_due_field">
      <%= form.label :due_at, "Due date (optional)", class: "mb-1 block text-[13px] font-semibold" %>
      <%= form.datetime_field :due_at,
          class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm tabular-nums outline-none transition focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]",
          data: { controller: "datepicker", datepicker_type_value: "datetime" } %>
    </div>
    <div>
      <%= form.label :target_count, "Goal target (optional)", class: "mb-1 block text-[13px] font-semibold" %>
      <%= form.number_field :target_count, min: 1, step: 1, placeholder: "e.g. 5",
          class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm tabular-nums outline-none transition placeholder:text-[#a7b0aa] focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]" %>
    </div>
  </div>

  <% if can_assign_todos? %>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <div>
        <%= form.label :user_id, "Assign to", class: "mb-1 block text-[13px] font-semibold" %>
        <%= form.collection_select :user_id, @assignable_users, :id, :full_name, { include_blank: "Everyone (whole team)" },
            class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm outline-none transition focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]" %>
      </div>
      <div>
        <%= form.label :visibility, class: "mb-1 block text-[13px] font-semibold" %>
        <%= form.select :visibility, Todo.visibilities.keys.map { |v| [ v.humanize, v ] }, {},
            class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm outline-none transition focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]" %>
      </div>
    </div>
  <% end %>

  <div class="mt-3">
    <%= render "todos/contact_checklist", form: form, selected: todo.todo_contacts.pluck(:contact_id) %>
  </div>

  <%= form.submit todo.persisted? ? "Save changes" : "Create todo",
      class: "mt-5 w-full cursor-pointer rounded-lg bg-algae-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#0f5c3e]" %>
<% end %>
