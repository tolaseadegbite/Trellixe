<%# Todo row — the single todo presentation at every width. Locals: todo.
    Managing (edit/delete) is admin-only on shared todos; closing is
    admin-or-assignee; progress and participation are open to every
    member who can see a shared todo. %>
<div id="<%= dom_id(todo) %>" class="flex items-start gap-3 px-4 py-3.5">
  <% if can_complete_todo?(todo) %>
    <%= button_to toggle_complete_todo_path(todo), method: :patch,
        title: todo.completed? ? "Reopen" : "Mark complete",
        class: "group mt-0.5 flex min-h-11 min-w-11 shrink-0 cursor-pointer items-center justify-center" do %>
      <% if todo.completed? %>
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-algae-900 text-white"><%= icon("check", css: "h-4 w-4") %></span>
      <% else %>
        <span class="block h-6 w-6 rounded-full border-2 border-[#D9DDE0] transition group-hover:border-[#3AB67D] dark:border-white/20"></span>
      <% end %>
    <% end %>
  <% else %>
    <span class="mt-0.5 flex min-h-11 min-w-11 shrink-0 items-center justify-center" title="<%= todo.completed? ? 'Completed' : 'Open' %>">
      <% if todo.completed? %>
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-algae-900 text-white"><%= icon("check", css: "h-4 w-4") %></span>
      <% else %>
        <span class="block h-6 w-6 rounded-full border-2 border-[#D9DDE0] dark:border-white/20"></span>
      <% end %>
    </span>
  <% end %>

  <div class="min-w-0 flex-1">
    <p class="break-words text-[14.5px] leading-snug <%= todo.completed? ? 'text-[#8a938d] line-through dark:text-[#9AA6A0]' : 'font-semibold' %>"><%= todo.title %></p>

    <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1.5 text-[13px] text-[#8a938d] dark:text-[#9AA6A0]">
      <span class="inline-flex items-center gap-1.5">
        <% if todo.user.present? %>
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-algae-900 text-[10px] font-bold text-white">
            <%= (todo.user.full_name&.first || "?").upcase %>
          </span>
          <%= todo.user_id == current_user.id ? "You" : todo.user.full_name %>
        <% else %>
          <span class="rounded-full border border-[#A2E494] bg-algae-50 px-2 py-0.5 text-[11px] font-semibold text-algae-900 dark:bg-algae-600/15 dark:text-algae-300">Everyone</span>
        <% end %>
      </span>
      <% if todo.overdue? %>
        <span class="rounded-full bg-red-700 px-2 py-0.5 text-[11px] font-bold text-white">Overdue · <%= time_ago_in_words(todo.due_at) %></span>
      <% elsif todo.due_at.present? %>
        <span class="rounded-full border border-[#A2E494] bg-algae-50 px-2 py-0.5 text-[11px] font-semibold text-algae-900 dark:bg-algae-600/15 dark:text-algae-300">Due <%= todo.due_at.today? ? "today" : l(todo.due_at, format: :short) %></span>
      <% end %>
      <% if todo.personal? %>
        <span class="rounded-full border border-[#D9DDE0] px-2 py-0.5 text-[11px] font-semibold dark:border-white/10">Only you</span>
      <% end %>
      <% if todo.goal? %>
        <span class="font-semibold tabular-nums text-algae-900 dark:text-algae-300"><%= todo.progress_count %>/<%= todo.target_count %></span>
      <% end %>
    </div>

    <% if todo.goal? && todo.shared? %>
      <div class="mt-2 flex items-center gap-2">
        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-[#E9EBED] dark:bg-white/10" role="progressbar"
            aria-valuenow="<%= todo.progress_count %>" aria-valuemin="0" aria-valuemax="<%= todo.target_count %>" aria-label="Goal progress">
          <div class="h-full rounded-full bg-algae-600 transition-all" style="width: <%= (todo.progress_count * 100.0 / todo.target_count).round %>%"></div>
        </div>
        <%= button_to step_progress_todo_path(todo, delta: -1), method: :patch, title: "Step back",
            class: "flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg border border-[#D9DDE0] text-[#6b7672] transition hover:border-[#A2E494] dark:border-white/10 dark:text-[#9AA6A0]" do %><%= icon("minus", css: "h-4 w-4") %><% end %>
        <%= button_to step_progress_todo_path(todo, delta: 1), method: :patch, title: "Log progress",
            class: "flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg border border-[#D9DDE0] text-[#6b7672] transition hover:border-[#A2E494] dark:border-white/10 dark:text-[#9AA6A0]" do %><%= icon("plus", css: "h-4 w-4") %><% end %>
      </div>
    <% elsif todo.goal? %>
      <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-[#E9EBED] dark:bg-white/10" role="progressbar"
          aria-valuenow="<%= todo.progress_count %>" aria-valuemin="0" aria-valuemax="<%= todo.target_count %>" aria-label="Goal progress">
        <div class="h-full rounded-full bg-algae-600 transition-all" style="width: <%= (todo.progress_count * 100.0 / todo.target_count).round %>%"></div>
      </div>
    <% end %>

    <% if todo.todo_contacts.any? %>
      <div class="mt-2 flex flex-wrap gap-1.5">
        <% todo.todo_contacts.each do |link| %>
          <%= link_to link.contact, data: { turbo_frame: "_top" }, title: "View #{link.contact.full_name}",
              class: "inline-flex items-center gap-1.5 rounded-full border border-[#D9DDE0] px-2.5 py-1 text-xs font-semibold text-[#3d4742] transition hover:border-[#A2E494] dark:border-white/10 dark:text-[#C6CFC9]" do %>
            <%= link.contact.full_name %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if todo.shared? %>
      <% participants = todo.todo_participations.sort_by(&:created_at).map(&:user) %>
      <div class="mt-2.5 flex flex-wrap items-center gap-2 border-t border-[#E9EBED] pt-2.5 dark:border-white/10">
        <% if participants.any? %>
          <span class="flex -space-x-1.5">
            <% participants.first(4).each do |participant| %>
              <span class="flex h-6 w-6 items-center justify-center rounded-full border-2 border-white bg-algae-900 text-[10px] font-bold text-white dark:border-[#131B17]" title="<%= participant.full_name %>">
                <%= (participant.full_name&.first || "?").upcase %>
              </span>
            <% end %>
          </span>
          <span class="text-xs text-[#6b7672] dark:text-[#9AA6A0]">
            <% names = participants.first(2).map { |p| p.id == current_user.id ? "You" : p.full_name } %>
            <%= names.join(", ") %><%= " +#{participants.size - 2} more" if participants.size > 2 %> participated
          </span>
        <% else %>
          <span class="text-xs text-[#8a938d] dark:text-[#9AA6A0]">No one yet — be the first</span>
        <% end %>
        <% if todo.participated?(current_user) %>
          <%= button_to "Participated", participate_todo_path(todo), method: :patch, title: "Remove your participation",
              class: "cursor-pointer rounded-lg border border-[#A2E494] bg-algae-50 px-3 py-1.5 text-xs font-semibold text-algae-900 transition hover:border-red-300 hover:text-red-700 dark:bg-algae-600/15 dark:text-algae-300 dark:hover:text-red-400" %>
        <% else %>
          <%= button_to "I participated", participate_todo_path(todo), method: :patch, title: "Log your participation",
              class: "cursor-pointer rounded-lg border border-[#D9DDE0] bg-white px-3 py-1.5 text-xs font-semibold transition hover:border-[#A2E494] hover:text-algae-900 dark:border-white/10 dark:bg-white/5 dark:hover:text-algae-300" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <span class="flex shrink-0 items-center gap-0.5">
    <% if can_edit_todo?(todo) %>
      <%= link_to edit_todo_path(todo), data: { turbo_frame: "modal" }, title: "Edit",
          class: "flex h-9 w-9 items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-[#E9EBED] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:bg-white/10 dark:hover:text-[#E7ECE9]" do %><%= icon("pen", css: "h-4 w-4") %><% end %>
    <% end %>
    <% if todo.personal? ? todo.user == current_user : admin? %>
      <% delete_trigger = button_tag type: "button", title: "Delete", data: { action: "dialog#showModal" },
          class: "flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-red-50 hover:text-red-700 dark:text-[#9AA6A0] dark:hover:bg-red-500/10 dark:hover:text-red-400" do %><%= icon("trash-2", css: "h-4 w-4") %><% end %>
      <%= modal_dialog delete_trigger, size: "450px", title: "Delete '#{todo.title}'?" do %>
        <p class="text-sm text-[#6b7672] dark:text-[#9AA6A0]">This permanently deletes this todo. This can't be undone.</p>
        <div class="mt-5 flex justify-end gap-2">
          <button type="button" class="rounded-lg border border-[#D9DDE0] px-4 py-2 text-sm font-semibold transition hover:border-[#A2E494] dark:border-white/10" data-action="click->dialog#close">Cancel</button>
          <%= button_to "Delete", todo_path(todo), method: :delete, class: "rounded-lg bg-red-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-800" %>
        </div>
      <% end %>
    <% end %>
  </span>
</div>
