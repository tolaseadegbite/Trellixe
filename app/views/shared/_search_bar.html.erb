<%# Shared search idiom. Locals: search (ransack object), url:, frame:
    turbo-frame id updated by both forms, predicate: (search field name),
    placeholder:, hidden: ({name => value} rendered as hidden fields),
    fields: (partial name rendered with the filter form's builder as `f`).
    Saved-view pills live with the list they filter (inside the update
    frame) so their active states stay correct; only this shell — search
    input plus collapsible panel — sits outside it and is never rebuilt,
    which is what keeps focus and panel state across updates. %>
<div data-search-filter-target="card">
  <div class="flex flex-wrap items-center gap-2">
    <%= search_form_for(search, url: url,
        data: { turbo_frame: frame, turbo_action: "advance", controller: "debounce" },
        html: { class: "flex min-w-0 flex-1 items-center gap-2" }) do |f| %>
      <% hidden.each do |name, value| %>
        <%= hidden_field_tag name, value %>
      <% end %>
      <span class="relative min-w-0 flex-1">
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[#8a938d] dark:text-[#9AA6A0]"><%= icon("search", css: "h-4 w-4") %></span>
        <%= f.search_field predicate, placeholder: placeholder,
            class: "w-full rounded-lg border border-[#D9DDE0] bg-[#F6F9F7] py-3 pl-9 pr-3 text-[16px] outline-none transition placeholder:text-[#a7b0aa] focus:border-[#3AB67D] focus:bg-white focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-white/[0.03] dark:focus:bg-[#0C1210]",
            data: { action: "input->debounce#submit" } %>
      </span>
    <% end %>
    <button type="button" class="flex items-center gap-1.5 self-stretch rounded-lg border border-[#D9DDE0] bg-white px-3 text-[13px] font-medium transition hover:border-[#A2E494] dark:border-white/10 dark:bg-white/5" data-action="search-filter#toggle">
      <%= icon("search", css: "h-4 w-4") %> Filters
    </button>
  </div>

  <div class="hidden pt-3" data-search-filter-target="filters">
    <%= search_form_for(search, url: url,
        data: { turbo_frame: frame, turbo_action: "advance", controller: "debounce" }) do |filter_form| %>
      <% hidden.each do |name, value| %>
        <%= hidden_field_tag name, value %>
      <% end %>
      <%= render fields, f: filter_form %>
    <% end %>
  </div>
</div>
