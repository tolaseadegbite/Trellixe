<%# Receives `trigger`, `title`, `label`, `size`, and `content` %>
<div contents data-controller="dialog">
  <%= raw(trigger) %>

  <dialog class="tlx-dialog"
          style="<%= "--dialog-size: #{size};" if size %>"
          data-dialog-target="content"
          data-action="click->dialog#closeOnClickOutside"
          aria-label="<%= label %>">
    <button type="button" class="absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-[#F1F4F2] hover:text-[#1c2420]" data-action="click->dialog#close" aria-label="Close">
      <%= icon("x", css: "h-4 w-4") %>
    </button>
    <div class="p-6">
      <% if title.present? %>
        <h2 class="mb-4 font-display text-lg font-semibold tracking-tight"><%= title %></h2>
      <% end %>
      <%= raw(content) %>
    </div>
  </dialog>
</div>
