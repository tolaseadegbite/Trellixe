<% content_for :title, "Trellixe — Every visitor remembered" %>

<div class="bg-white dark:bg-[#131B17]">
  <section class="mx-auto grid w-full max-w-6xl gap-10 px-4 pb-14 pt-12 md:grid-cols-2 md:items-center md:px-8 md:pt-20">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-[#A2E494] bg-algae-50 px-3 py-1 text-xs font-semibold text-algae-900 dark:bg-algae-600/15 dark:text-algae-300">
        <span class="h-1.5 w-1.5 rounded-full bg-algae-600"></span>
        Built for outreach teams &amp; cell networks
      </p>
      <h1 class="mt-5 font-display text-4xl font-bold leading-[1.05] tracking-tight md:text-[52px]">No visitor falls through the cracks.</h1>
      <p class="mt-5 max-w-md text-[17px] leading-relaxed text-[#3d4742] dark:text-[#C6CFC9]">Trellixe carries one shared list from Saturday street invitation to Sunday seat to Monday follow-up — so your team always knows who to call, and why it matters.</p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <%= link_to "Start free — no card needed", sign_up_path, class: "rounded-lg bg-algae-900 px-5 py-3 text-[15px] font-semibold text-white transition hover:bg-[#0f5c3e]" %>
        <%= link_to "See how it works", "#how-it-works", class: "rounded-lg border border-[#D9DDE0] px-5 py-3 text-[15px] font-semibold transition hover:border-[#A2E494] hover:text-algae-900 dark:border-white/10 dark:hover:text-algae-300" %>
      </div>
      <p class="mt-4 text-[13px] text-[#8a938d] dark:text-[#9AA6A0]">Set up in an afternoon. Your cell of five can run Sunday on it.</p>
    </div>

    <div class="relative">
      <div class="rounded-2xl border border-[#D9DDE0] bg-[#F6F9F7] p-4 shadow-[0_24px_60px_-24px_rgb(19_113_76/0.25)] dark:border-white/10 dark:bg-white/[0.03]">
        <div class="flex items-center justify-between px-1 pb-3">
          <p class="text-[13px] font-semibold">Saturday outreach — Ring Road</p>
          <span class="rounded-full bg-algae-100 px-2.5 py-0.5 text-xs font-semibold text-algae-900 dark:text-algae-300">12 new</span>
        </div>
        <div class="space-y-2">
          <div class="flex items-center gap-3 rounded-xl border border-[#E9EBED] bg-white px-3.5 py-3 dark:bg-[#131B17] dark:border-white/10">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-algae-900 text-xs font-bold text-white">BK</span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold">Blessing K. <span class="font-normal text-[#8a938d] dark:text-[#9AA6A0]">· invited to Sunday 9am</span></p>
              <p class="truncate text-[13px] text-[#8a938d] dark:text-[#9AA6A0]">“Pray for mum's surgery Thursday.”</p>
            </div>
            <%= icon("check", css: "h-4 w-4 text-algae-600") %>
          </div>
          <div class="flex items-center gap-3 rounded-xl border border-[#E9EBED] bg-white px-3.5 py-3 dark:bg-[#131B17] dark:border-white/10">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#1c2420] text-xs font-bold text-white">DA</span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold">Daniel A. <span class="font-normal text-[#8a938d] dark:text-[#9AA6A0]">· needs transport</span></p>
              <p class="truncate text-[13px] text-[#8a938d] dark:text-[#9AA6A0]">New in town, works nights.</p>
            </div>
            <%= icon("check", css: "h-4 w-4 text-algae-600") %>
          </div>
          <div class="flex items-center gap-3 rounded-xl border border-[#A2E494] bg-algae-50 px-3.5 py-3 dark:bg-algae-600/15">
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-algae-600 text-xs font-bold text-white">MF</span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold">Monday 9:12am — call Funmi</p>
              <p class="truncate text-[13px] text-[#5b6660] dark:text-[#9AA6A0]">Attended Sunday · “Ask about the job interview.”</p>
            </div>
            <span class="rounded-md bg-algae-900 px-2 py-1 text-xs font-semibold text-white">Due</span>
          </div>
        </div>
      </div>
      <p class="mt-3 text-center text-xs text-[#8a938d] dark:text-[#9AA6A0]">Real workflow: capture on the street, check in at the door, follow up Monday.</p>
    </div>
  </section>

  <section class="border-y border-[#E9EBED] bg-[#F6F9F7] dark:border-white/10 dark:bg-white/[0.03]">
    <div class="mx-auto grid w-full max-w-6xl gap-3 px-4 py-6 text-[13.5px] md:grid-cols-4 md:px-8">
      <p><span class="font-bold text-algae-900 dark:text-algae-300">01 — Invite.</span> <span class="text-[#3d4742] dark:text-[#C6CFC9]">Names, numbers, prayer points, straight into the phone.</span></p>
      <p><span class="font-bold text-algae-900 dark:text-algae-300">02 — Remind.</span> <span class="text-[#3d4742] dark:text-[#C6CFC9]">Saturday-night nudge before Sunday service.</span></p>
      <p><span class="font-bold text-[#3d4742] dark:text-[#C6CFC9]"><span class="font-bold text-algae-900 dark:text-algae-300">03 — Welcome.</span> One-tap attendance at the door.</span></p>
      <p><span class="font-bold text-algae-900 dark:text-algae-300">04 — Keep.</span> <span class="text-[#3d4742] dark:text-[#C6CFC9]">Monday calls queued with full context.</span></p>
    </div>
  </section>

  <section id="how-it-works" class="mx-auto w-full max-w-6xl px-4 py-16 md:px-8 md:py-24">
    <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-algae-900 dark:text-algae-300">How it works</p>
    <h2 class="mt-2 max-w-xl font-display text-3xl font-bold tracking-tight md:text-4xl">A simple loop your volunteers will actually keep.</h2>
    <div class="mt-10 space-y-4">
      <div class="grid gap-6 rounded-2xl border border-[#D9DDE0] p-6 md:grid-cols-[64px_1fr_1fr] md:items-center md:p-8 dark:border-white/10">
        <span class="font-display text-4xl font-bold text-[#A2E494]">1</span>
        <div>
          <h3 class="font-display text-lg font-semibold">Capture with context</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-[#3d4742] dark:text-[#C6CFC9]">Not just a phone number. Who they came with, what they're carrying, what to pray about — written once, visible to the whole cell.</p>
        </div>
        <div class="rounded-xl bg-[#F6F9F7] p-4 text-sm text-[#3d4742] dark:text-[#C6CFC9] dark:bg-white/[0.03]"><span class="font-semibold">Sat 4:40pm</span> · “Met at the junction. Two kids. Invited to cell Thursday.”</div>
      </div>
      <div class="grid gap-6 rounded-2xl border border-[#D9DDE0] p-6 md:grid-cols-[64px_1fr_1fr] md:items-center md:p-8 dark:border-white/10">
        <span class="font-display text-4xl font-bold text-[#A2E494]">2</span>
        <div>
          <h3 class="font-display text-lg font-semibold">Show up prepared</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-[#3d4742] dark:text-[#C6CFC9]">Sunday morning the welcome team sees every expected guest, who invited them, and where to seat them. Check-in is one tap.</p>
        </div>
        <div class="rounded-xl bg-[#F6F9F7] p-4 text-sm text-[#3d4742] dark:text-[#C6CFC9] dark:bg-white/[0.03]"><span class="font-semibold">Sun 8:15am</span> · “6 expected · 2 need transport · Blessing — first row, friend of Adaeze.”</div>
      </div>
      <div class="grid gap-6 rounded-2xl border border-[#D9DDE0] p-6 md:grid-cols-[64px_1fr_1fr] md:items-center md:p-8 dark:border-white/10">
        <span class="font-display text-4xl font-bold text-[#A2E494]">3</span>
        <div>
          <h3 class="font-display text-lg font-semibold">Follow up while it's warm</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-[#3d4742] dark:text-[#C6CFC9]">Monday morning each volunteer gets their short list with context. Every call and visit is logged, so the next person never starts cold.</p>
        </div>
        <div class="rounded-xl bg-[#F6F9F7] p-4 text-sm text-[#3d4742] dark:text-[#C6CFC9] dark:bg-white/[0.03]"><span class="font-semibold">Mon 9:00am</span> · “3 calls · each with last week's note attached.”</div>
      </div>
    </div>
  </section>

  <section id="who-its-for" class="border-y border-[#E9EBED] bg-algae-900 text-white">
    <div class="mx-auto w-full max-w-6xl px-4 py-16 md:px-8 md:py-20">
      <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-[#A2E494]">Who it's for</p>
      <h2 class="mt-2 max-w-xl font-display text-3xl font-bold tracking-tight md:text-4xl">Built with cell leaders, not for CRMs.</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        <div class="border-t border-white/15 pt-5">
          <h3 class="font-display text-[17px] font-semibold">Cell groups of five</h3>
          <p class="mt-2 text-[14.5px] leading-relaxed text-white/70">Share one list on five phones. No duplicates, no “who has her number?” — whoever meets someone, the whole cell knows.</p>
        </div>
        <div class="border-t border-white/15 pt-5">
          <h3 class="font-display text-[17px] font-semibold">Welcome &amp; assimilation teams</h3>
          <p class="mt-2 text-[14.5px] leading-relaxed text-white/70">Route guests between cells by area or need, assign transport or a visit, and see every touch in one timeline.</p>
        </div>
        <div class="border-t border-white/15 pt-5">
          <h3 class="font-display text-[17px] font-semibold">Branch overseers</h3>
          <p class="mt-2 text-[14.5px] leading-relaxed text-white/70">Watch outreach turn into attendance and attendance turn into belonging — cell by cell, week by week.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="field-notes" class="mx-auto w-full max-w-6xl px-4 py-16 md:px-8 md:py-24">
    <div class="grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-algae-900 dark:text-algae-300">Field notes</p>
        <blockquote class="mt-3 font-display text-2xl font-bold leading-snug tracking-tight md:text-[32px]">“We used to lose half our Saturday names by Sunday. Last month we followed up with every single one.”</blockquote>
        <p class="mt-4 text-[15px] text-[#3d4742] dark:text-[#C6CFC9]">Welcome coordinator, 4-cell network · 200 Sunday attendance</p>
      </div>
      <div class="rounded-2xl border border-[#D9DDE0] bg-[#F6F9F7] p-6 dark:border-white/10 dark:bg-white/[0.03]">
        <p class="text-sm font-semibold">What changes in the first month</p>
        <ul class="mt-3 space-y-2.5 text-[14.5px] text-[#3d4742] dark:text-[#C6CFC9]">
          <li class="flex gap-2.5"><%= icon("check", css: "mt-0.5 h-4 w-4 shrink-0 text-algae-600") %> Saturday names land in the shared list before you get home.</li>
          <li class="flex gap-2.5"><%= icon("check", css: "mt-0.5 h-4 w-4 shrink-0 text-algae-600") %> Sunday check-in takes seconds at a crowded door.</li>
          <li class="flex gap-2.5"><%= icon("check", css: "mt-0.5 h-4 w-4 shrink-0 text-algae-600") %> Monday calls come with the prayer point attached.</li>
          <li class="flex gap-2.5"><%= icon("check", css: "mt-0.5 h-4 w-4 shrink-0 text-algae-600") %> New volunteers inherit history instead of starting blind.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="border-t border-[#E9EBED] bg-[#F6F9F7] dark:border-white/10 dark:bg-white/[0.03]">
    <div class="mx-auto flex w-full max-w-6xl flex-col items-start justify-between gap-6 px-4 py-14 md:flex-row md:items-center md:px-8">
      <div>
        <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl">This Sunday's guests deserve Monday's call.</h2>
        <p class="mt-2 text-[15px] text-[#3d4742] dark:text-[#C6CFC9]">Create your workspace, invite your cell, log your first outreach.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= link_to "Start free", sign_up_path, class: "rounded-lg bg-algae-900 px-5 py-3 text-[15px] font-semibold text-white transition hover:bg-[#0f5c3e]" %>
        <%= link_to "Log in", sign_in_path, class: "rounded-lg border border-[#D9DDE0] bg-white px-5 py-3 text-[15px] font-semibold transition hover:border-[#A2E494] dark:bg-[#131B17] dark:border-white/10" %>
      </div>
    </div>
  </section>

  <footer class="bg-algae-900 text-white">
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-10 md:flex-row md:items-center md:justify-between md:px-8">
      <span class="flex items-center gap-2">
        <%= image_tag "logo/trellixe-mark.svg", size: 28, alt: "Trellixe", class: "h-7 w-7 rounded-md" %>
        <span class="font-display text-[15px] font-bold">Trellixe</span>
        <span class="text-[13px] text-white/60">· Every visitor remembered.</span>
      </span>
      <nav class="flex flex-wrap gap-x-6 gap-y-2 text-[13.5px] text-white/70">
        <%= link_to "Help", help_path, class: "hover:text-white" %>
        <%= link_to "Privacy", privacy_path, class: "hover:text-white" %>
        <%= link_to "Contact", contact_us_path, class: "hover:text-white" %>
        <%= link_to "Sign in", sign_in_path, class: "hover:text-white" %>
      </nav>
    </div>
  </footer>
</div>
