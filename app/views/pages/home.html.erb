<% content_for :title, "Never Forget a Follow-Up Again" %>

<section class="mb-6 mi-4 rounded-2xl" style="background-image: linear-gradient(to right, var(--purple-200), var(--orange-200)); height: ">

    <%= render "layouts/navigation/application/navbar" %>

    <div class="section-padding text-center" style="padding: 6rem 0;">
        <div class="container flex flex-col gap-8">
            <h1 class="font-semibold leading-tight text-gray-900" style="font-size: 4rem;">Never Forget a Follow-Up Again.</h1>
            <p class="text-lg mt-4 mi-auto text-gray-900" style="max-inline-size: 48rem;">
                Trellixe is the simple app for pastors, salespeople, and networkers that automates your post-event reminders so you can build lasting connections.
            </p>
            <div class="mt-8">
                <a href="#signup" class="btn btn--primary text-lg">Start Your 14-Day Free Trial</a>
                <p class="text-xs text-gray-900 mbs-2">No credit card required.</p>
            </div>
            
            <div class="mt-10 shadow-lg rounded-lg relative">
                <!-- This is where the main hero image of your app's dashboard would go. -->
                <!-- It should visually hint at the core value proposition. -->
                <div class="bg-surface rounded-lg aspect-widescreen flex items-center justify-center border border-main">
                    <p class="text-subtle">[ Main Dashboard Screen ]</p>
                </div>
            </div>
        </div>
    </div>
</section>

