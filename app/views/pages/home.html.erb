<section class="bg-black text-reversed mbe-4 mi-4 rounded-lg" style="padding: 6rem 0;">
    <div class="container flex justify-center">
        <div class="flex flex-col gap-8">
            <h2 class="font-semibold leading-tight text-4xl" style="max-inline-size: 60dvh;">Ready to Build Stronger Connections?</h2>
            <p class="text-lg" style="max-inline-size: 50dvh;">
                Start your free trial today. It only takes a minute to sign up.
            </p>
            
            <div class="">
                <a href="#signup" class="btn text-lg">Start your 14-Day free trial</a>
            </div>
        </div>
