<% content_for :title, "Pricing" %>
<div class="mx-auto w-full max-w-4xl px-4 py-14 md:px-8">
  <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-algae-900 dark:text-algae-300">Pricing</p>
  <h1 class="mt-2 font-display text-3xl font-bold tracking-tight">Start with your cell. Grow to your branch.</h1>
  <div class="mt-8 grid gap-4 md:grid-cols-2">
    <div class="rounded-2xl border border-[#D9DDE0] bg-white p-6 dark:bg-[#131B17] dark:border-white/10">
      <p class="text-sm font-semibold">Cell workspace</p>
      <p class="mt-1 font-display text-3xl font-bold">Free <span class="text-base font-medium text-[#8a938d] dark:text-[#9AA6A0]">to start</span></p>
      <ul class="mt-4 space-y-2 text-[14.5px] text-[#3d4742] dark:text-[#C6CFC9]">
        <li>· Up to 5 members, one shared list</li>
        <li>· Contacts, events &amp; follow-ups</li>
        <li>· Sunday check-in</li>
      </ul>
      <%= link_to "Start free", sign_up_path, class: "mt-6 flex justify-center rounded-lg bg-algae-900 px-4 py-2.5 text-sm font-semibold text-white" %>
    </div>
    <div class="rounded-2xl border border-algae-900 bg-algae-900 p-6 text-white">
      <p class="text-sm font-semibold text-[#A2E494]">Church branch</p>
      <p class="mt-1 font-display text-3xl font-bold">Talk to us</p>
      <ul class="mt-4 space-y-2 text-[14.5px] text-white/80">
        <li>· Multiple cells under one branch</li>
        <li>· Guest routing &amp; assignments</li>
        <li>· Retention view for overseers</li>
      </ul>
      <%= link_to "Contact us", contact_us_path, class: "mt-6 flex justify-center rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-algae-900 dark:bg-[#131B17] dark:text-algae-300" %>
    </div>
  </div>
</div>
