<% content_for :title, "Contact" %>
<div class="mx-auto w-full max-w-3xl px-4 py-14 md:px-8">
  <p class="text-[13px] font-semibold uppercase tracking-[0.12em] text-algae-900 dark:text-algae-300">Contact</p>
  <h1 class="mt-2 font-display text-3xl font-bold tracking-tight">Talk to a human.</h1>
  <p class="mt-4 text-[15px] leading-relaxed text-[#3d4742] dark:text-[#C6CFC9]">Running outreach this weekend and need help setting up your workspace? Tell us about your cell and we'll walk you through it.</p>
  <div class="mt-6 rounded-2xl border border-[#D9DDE0] bg-white p-6 dark:bg-[#131B17] dark:border-white/10">
    <p class="text-sm font-semibold">Email us</p>
    <p class="mt-1 text-[15px] text-[#3d4742] dark:text-[#C6CFC9]">hello@trellixe.com — we reply within a day, faster on Saturdays.</p>
  </div>
  <%= link_to "Back home", root_path, class: "mt-8 inline-flex rounded-lg border border-[#D9DDE0] bg-white px-4 py-2.5 text-sm font-semibold hover:border-[#A2E494] dark:bg-[#131B17] dark:border-white/10" %>
</div>
