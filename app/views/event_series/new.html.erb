<% content_for :title, "New Event Series" %>
<% content_for :page_header, "New event series" %>

<div class="mx-auto w-full max-w-2xl">
  <%= link_to "‹ All series", event_series_index_path, class: "inline-flex items-center gap-1 rounded-lg px-2 py-1 text-sm font-semibold text-[#3d4742] transition hover:bg-[#E9EBED] dark:text-[#C6CFC9] dark:hover:bg-white/5" %>

  <div class="mt-3 rounded-2xl border border-[#D9DDE0] bg-white p-6 dark:border-white/10 dark:bg-[#131B17] sm:p-8">
    <h1 class="font-display text-xl font-bold tracking-tight">Create a repeating series</h1>
    <p class="mt-1 text-sm leading-relaxed text-[#6b7672] dark:text-[#9AA6A0]">Weekly services and cell meetings generate occurrences automatically — tagged contacts get invited to each one.</p>
    <div class="mt-6">
      <%= render "form", event_series: @event_series %>
    </div>
  </div>
</div>
