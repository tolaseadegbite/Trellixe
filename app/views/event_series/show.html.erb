<% content_for :title, @event_series.name %>

<% content_for :page_header do %>
  <%= render "shared/breadcrumb", trail: [ { label: "Series", path: event_series_index_path }, { label: @event_series.name } ] %>
<% end %>

<div class="space-y-5">
  <%= render "event_series/show_details", event_series: @event_series %>

  <div id="series-events">
    <h2 class="mb-2 font-display text-[15px] font-semibold">Generated events</h2>

    <div id="series-events-list" class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <%= render partial: "events/event_list_item", collection: @events, as: :event %>
    </div>

    <% if @events.any? %>
      <div class="mt-4">
        <%= render "shared/pagination", pagy: @pagy %>
      </div>
    <% else %>
      <p id="series-events-empty" class="mt-2 rounded-2xl border border-dashed border-[#D9DDE0] bg-white p-8 text-center text-sm text-[#8a938d] dark:border-white/10 dark:bg-[#131B17] dark:text-[#9AA6A0]">No events generated yet.</p>
    <% end %>
  </div>
</div>
