<% content_for :title, "Event Series" %>
<% content_for :page_header, "Event Series · #{@event_series.count}" %>
<% content_for :header_action_buttons do %>
  <%= link_to new_event_series_path,
      class: "flex items-center gap-1.5 rounded-lg bg-algae-900 px-3.5 py-2 text-[13px] font-semibold text-white transition hover:bg-[#0f5c3e]" do %>
    <%= icon("plus", css: "h-4 w-4") %> New series
  <% end %>
<% end %>

<%= link_to new_event_series_path, aria: { label: "New series" },
    class: "fixed bottom-6 right-4 z-40 flex h-13 w-13 items-center justify-center rounded-full bg-algae-900 p-4 text-white shadow-xl transition hover:bg-[#0f5c3e] md:hidden" do %>
  <%= icon("plus", css: "h-5 w-5") %>
<% end %>

<div class="space-y-4">
  <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-[#D9DDE0] bg-white p-3 dark:border-white/10 dark:bg-[#131B17]">
    <nav class="inline-flex items-center gap-1 rounded-xl bg-[#F1F4F2] p-1 dark:bg-white/5" aria-label="Events and Series">
      <%= link_to "Events list", events_path(view: "events-list"), data: { turbo_frame: "_top" },
          class: "rounded-lg px-3.5 py-2 text-[13px] font-medium text-[#6b7672] transition hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:text-[#E7ECE9]" %>
      <%= link_to "Calendar", events_path(view: "calendar"), data: { turbo_frame: "_top" },
          class: "rounded-lg px-3.5 py-2 text-[13px] font-medium text-[#6b7672] transition hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:text-[#E7ECE9]" %>
      <%= link_to "Series", event_series_index_path, aria: { current: "page" },
          class: "rounded-lg bg-white px-3.5 py-2 text-[13px] font-semibold shadow-sm dark:bg-[#131B17]" %>
    </nav>
  </div>

  <div id="event-series-list" class="space-y-2.5">
    <%= render @event_series %>
  </div>

  <% unless @event_series.any? %>
    <div id="series-empty-state">
      <%= render "shared/empty_state", title: "No series yet", body: "Create your first repeating event — weekly service, monthly outreach, one setup.", icon_name: "calendar-range" %>
    </div>
  <% end %>
</div>
