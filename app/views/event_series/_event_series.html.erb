<%# Series card — date-forward list item. Locals: event_series. Contract
    frozen: dom_id(event_series), rendered by the series index. Same
    actions, new presentation. %>
<% cancelled = event_series.cancelled_series? %>
<% ended = event_series.ends_on.present? && event_series.ends_on < Date.current %>
<% days = Array(event_series.day_of_week).map { |d| Date::DAYNAMES[d.to_i]&.first(3) }.compact %>
<div id="<%= dom_id(event_series) %>" class="rounded-2xl border border-[#D9DDE0] bg-white p-4 transition hover:border-[#A2E494] dark:border-white/10 dark:bg-[#131B17] <%= 'opacity-75' if cancelled %>">
  <div class="flex items-start gap-3.5">
    <span class="flex h-12 w-12 shrink-0 flex-col items-center justify-center rounded-xl <%= cancelled ? 'bg-[#F1F4F2] text-[#8a938d] dark:bg-white/5 dark:text-[#9AA6A0]' : 'bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300' %>">
      <span class="text-[10px] font-bold uppercase tracking-wide"><%= event_series.starts_at.strftime("%b") %></span>
      <span class="font-display text-lg font-bold leading-none tabular-nums"><%= event_series.starts_at.strftime("%-d") %></span>
    </span>
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-2">
        <%= link_to event_series, data: { turbo_frame: "_top" }, class: "min-w-0 flex-1 truncate font-semibold hover:text-algae-900 hover:underline dark:hover:text-algae-300" do %>
          <%= event_series.name %>
        <% end %>
        <span class="flex shrink-0 items-center gap-1">
          <% unless cancelled || ended %>
            <%= button_to generate_occurrence_event_series_path(event_series,
                            date: event_series.occurrences(from: Time.current, to: 60.days.from_now).first&.to_date || Date.today),
                method: :post, title: "Generate next occurrence",
                class: "flex h-8 w-8 items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-[#E9EBED] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:bg-white/10 dark:hover:text-[#E7ECE9]" do %>
              <%= icon("calendar-plus", css: "h-4 w-4") %>
            <% end %>
          <% end %>
          <%= button_to toggle_cancellation_event_series_path(event_series),
              method: :patch, title: cancelled ? "Reactivate" : "Cancel series",
              class: "flex h-8 w-8 items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-[#E9EBED] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:bg-white/10 dark:hover:text-[#E7ECE9]" do %>
            <%= icon(cancelled ? "check" : "x", css: "h-4 w-4") %>
          <% end %>
          <%= link_to edit_event_series_path(event_series), title: "Edit",
              class: "flex h-8 w-8 items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-[#E9EBED] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:bg-white/10 dark:hover:text-[#E7ECE9]" do %>
            <%= icon("pen", css: "h-4 w-4") %>
          <% end %>
        </span>
      </div>
      <p class="mt-1 truncate text-[13px] tabular-nums text-[#6b7672] dark:text-[#9AA6A0]">
        <% if event_series.recurrence_frequency.present? %>
          <%= event_series.recurrence_frequency.humanize %><% if days.any? %> · <%= days.join(", ") %><% end %> ·
        <% end %>
        <%= pluralize(event_series.events.count, "occurrence") %>
        <% if event_series.ends_on %> · ends <%= event_series.ends_on.strftime("%b %-d, %Y") %><% end %>
      </p>
      <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
        <% if cancelled %>
          <span class="rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700 dark:bg-red-500/10 dark:text-red-400">Cancelled</span>
        <% end %>
        <% event_series.tags.each do |tag| %>
          <span class="rounded-full border border-[#A2E494] bg-algae-50 px-2.5 py-0.5 text-xs font-semibold text-algae-900 dark:bg-algae-600/15 dark:text-algae-300"><%= tag.name %></span>
        <% end %>
      </div>
    </div>
  </div>
</div>
