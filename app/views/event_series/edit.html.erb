<% content_for :title, "Edit Event Series" %>
<% content_for :page_header, "Edit event series" %>

<div class="mx-auto w-full max-w-2xl">
  <%= render "shared/breadcrumb", trail: [ { label: @event_series.name, path: event_series_path(@event_series) }, { label: "Edit" } ] %>

  <div class="mt-3 rounded-2xl border border-[#D9DDE0] bg-white p-6 dark:border-white/10 dark:bg-[#131B17] sm:p-8">
    <h1 class="font-display text-xl font-bold tracking-tight">Edit <%= @event_series.name %></h1>
    <p class="mt-1 text-sm leading-relaxed text-[#6b7672] dark:text-[#9AA6A0]">Changes apply to future occurrences.</p>
    <div class="mt-6">
      <%= render "form", event_series: @event_series %>
    </div>
  </div>
</div>
