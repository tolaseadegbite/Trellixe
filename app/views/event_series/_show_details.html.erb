<div id="<%= dom_id(event_series, :show_details) %>">
  <div class="rounded-2xl border border-[#D9DDE0] bg-white p-6 dark:border-white/10 dark:bg-[#131B17]">
    <h1 class="break-words font-display text-2xl font-bold tracking-tight"><%= event_series.name %></h1>
    <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm tabular-nums text-[#6b7672] dark:text-[#9AA6A0]">
      <span><%= l(event_series.starts_at, format: :long) %></span>
      <span class="opacity-50">&middot;</span>
      <span><%= pluralize(event_series.duration_in_minutes, "minute") %></span>
      <% if event_series.ends_on %>
        <span class="opacity-50">&middot;</span>
        <span>Ends <%= l(event_series.ends_on, format: :long) %></span>
      <% end %>
    </div>
    <div class="mt-2 flex flex-wrap items-center gap-1.5">
      <% if event_series.cancelled_series? %>
        <span class="rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700 dark:bg-red-500/10 dark:text-red-400">Cancelled</span>
      <% end %>
      <% if event_series.tags.any? %>
        <% event_series.tags.each do |tag| %>
          <span class="rounded-full border border-[#A2E494] bg-algae-50 px-2.5 py-0.5 text-xs font-semibold text-algae-900 dark:bg-algae-600/15 dark:text-algae-300"><%= tag.name %></span>
        <% end %>
      <% end %>
    </div>

    <div class="mt-5">
      <%= render "event_series/stats", event_series: event_series %>
    </div>
  </div>
</div>
