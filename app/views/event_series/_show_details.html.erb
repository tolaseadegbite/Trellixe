<div id="<%= dom_id(event_series, :show_details) %>">
  <div class="card p-3 bg-surface border border-main rounded-md shadow-sm">
    <div class="p-3">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold mbe-1"><%= event_series.name %></h1>
          <div class="flex flex-wrap items-center gap-2 text-sm text-subtle">
            <span><%= l(event_series.starts_at, format: :long) %></span>
            <span class="opacity-50">&middot;</span>
            <span><%= pluralize(event_series.duration_in_minutes, "minute") %></span>
            <% if event_series.ends_on %>
              <span class="opacity-50">&middot;</span>
              <span>Ends <%= l(event_series.ends_on, format: :long) %></span>
            <% end %>
          </div>
          <div class="flex flex-wrap items-center gap-2 mbs-1">
            <% if event_series.cancelled_series? %>
              <span class="text-xs font-medium rounded-full pi-2 pb-1 bg-red-100 text-red-700">Cancelled</span>
            <% end %>
            <% if event_series.tags.any? %>
              <% event_series.tags.each do |tag| %>
                <span class="text-xs font-medium rounded-full pi-2 pb-1 bg-emerald-50 text-emerald-700 border border-emerald-200"><%= tag.name %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%= render "event_series/stats", event_series: event_series %>
  </div>
</div>
