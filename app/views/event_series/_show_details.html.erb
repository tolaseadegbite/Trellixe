<div id="<%= dom_id(event_series, :show_details) %>">
  <div class="overflow-hidden rounded-2xl border border-[#D9DDE0] bg-white dark:border-white/10 dark:bg-[#131B17]">
    <div class="flex items-start gap-4 p-6">
      <span class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-2xl <%= event_series.cancelled_series? ? 'bg-[#F1F4F2] text-[#8a938d] dark:bg-white/5 dark:text-[#9AA6A0]' : 'bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300' %>">
        <span class="text-xs font-bold uppercase tracking-wide"><%= event_series.starts_at.strftime("%b") %></span>
        <span class="font-display text-2xl font-bold leading-none tabular-nums"><%= event_series.starts_at.strftime("%-d") %></span>
      </span>
      <div class="min-w-0 flex-1">
        <h1 class="break-words font-display text-2xl font-bold tracking-tight"><%= event_series.name %></h1>
        <p class="mt-1.5 text-sm tabular-nums text-[#6b7672] dark:text-[#9AA6A0]">
          <% if event_series.recurrence_frequency.present? %>
            Repeats <%= event_series.recurrence_frequency %>
            <% days = Array(event_series.day_of_week).map { |d| Date::DAYNAMES[d.to_i]&.first(3) }.compact %>
            <% if days.any? %> · <%= days.join(", ") %><% end %> ·
          <% end %>
          <%= pluralize(event_series.duration_in_minutes, "minute") %>
          <% if event_series.ends_on %> · ends <%= l(event_series.ends_on, format: :long) %><% end %>
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-1.5">
          <% if event_series.cancelled_series? %>
            <span class="rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700 dark:bg-red-500/10 dark:text-red-400">Cancelled</span>
          <% end %>
          <% event_series.tags.each do |tag| %>
            <span class="rounded-full border border-[#A2E494] bg-algae-50 px-2.5 py-0.5 text-xs font-semibold text-algae-900 dark:bg-algae-600/15 dark:text-algae-300"><%= tag.name %></span>
          <% end %>
        </div>
      </div>
      <div class="flex shrink-0 items-center gap-1.5">
        <%= link_to edit_event_series_path(event_series), title: "Edit",
            class: "flex h-9 w-9 items-center justify-center rounded-lg bg-algae-900 text-white transition hover:bg-[#0f5c3e]" do %>
          <%= icon("pen", css: "h-4 w-4") %>
        <% end %>
        <% unless event_series.cancelled_series? || (event_series.ends_on.present? && event_series.ends_on < Date.current) %>
          <%= button_to generate_occurrence_event_series_path(event_series,
                          date: event_series.occurrences(from: Time.current, to: 60.days.from_now).first&.to_date || Date.today,
                          from: "show"),
              method: :post, title: "Generate next occurrence",
              class: "flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-[#D9DDE0] bg-white transition hover:border-[#A2E494] dark:border-white/10 dark:bg-white/5" do %>
            <%= icon("calendar-plus", css: "h-4 w-4") %>
          <% end %>
        <% end %>
        <%= button_to toggle_cancellation_event_series_path(event_series),
            method: :patch, title: event_series.cancelled_series? ? "Reactivate" : "Cancel series",
            class: "flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-[#D9DDE0] bg-white transition hover:border-[#A2E494] dark:border-white/10 dark:bg-white/5" do %>
          <%= icon(event_series.cancelled_series? ? "check" : "x", css: "h-4 w-4") %>
        <% end %>
      </div>
    </div>

    <div class="mt-1 px-6 pb-6">
      <%= render "event_series/stats", event_series: event_series %>
    </div>
  </div>
</div>
