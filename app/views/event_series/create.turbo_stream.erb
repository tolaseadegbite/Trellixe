<% if @event_series.persisted? %>
  <%= turbo_stream.replace "series-empty-state", "" %>
  <%= turbo_stream.prepend "event-series-list", partial: "event_series/event_series", locals: { event_series: @event_series } %>
  <turbo-stream action="dispatch_event" name="dialog:close"></turbo-stream>
<% else %>
  <%= turbo_stream.update "modal", partial: "event_series/form", locals: { event_series: @event_series } %>
<% end %>

<%= turbo_stream.update "flash_messages", partial: "shared/flash", locals: { notice: flash.now[:notice], alert: flash.now[:alert] } %>
