<%= form_with(model: event_series, html: { contents: true }) do |form| %>
  <% if event_series.errors.any? %>
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:bg-red-500/10 dark:border-red-500/30 dark:text-red-300" role="alert">
      <p class="font-semibold"><%= pluralize(event_series.errors.count, "error") %> stopped this series from saving:</p>
      <ul class="mt-1 list-disc pl-5"><% event_series.errors.each do |error| %><li><%= error.full_message %></li><% end %></ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "mb-1 block text-[13px] font-semibold" %>
    <%= form.text_field :name, autofocus: true, placeholder: "e.g. Sunday Service",
        class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm outline-none transition focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]" %>
  </div>

  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    <div>
      <%= form.label :starts_at, "First occurrence", class: "mb-1 block text-[13px] font-semibold" %>
      <%= form.datetime_field :starts_at,
          class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm tabular-nums outline-none transition focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]",
          data: { controller: "datepicker", datepicker_type_value: "datetime" } %>
    </div>
    <div>
      <%= form.label :duration_in_minutes, class: "mb-1 block text-[13px] font-semibold" %>
      <%= form.number_field :duration_in_minutes, placeholder: "e.g. 90",
          class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm tabular-nums outline-none transition focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]" %>
    </div>
  </div>

  <div class="mt-3" data-controller="visibility" data-visibility-show-value="weekly">
    <div>
      <%= form.label :recurrence_frequency, "Repeats", class: "mb-1 block text-[13px] font-semibold" %>
      <%= form.select :recurrence_frequency,
          [[ "Weekly", "weekly" ], [ "Monthly", "monthly" ]],
          { include_blank: true },
          { class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm dark:border-white/10 dark:bg-[#0C1210]",
            data: { visibility_target: "input", action: "change->visibility#toggle" } } %>
    </div>

    <div class="mt-3" data-visibility-target="toggleable"
         <%= "hidden" unless event_series.persisted? && event_series.recurrence_frequency == "weekly" %>>
      <span class="mb-1 block text-[13px] font-semibold">On</span>
      <div class="flex flex-wrap gap-3">
        <% Date::DAYNAMES.each_with_index do |name, i| %>
          <label class="flex cursor-pointer items-center gap-1.5 text-sm">
            <%= form.check_box :day_of_week, { multiple: true, checked: event_series.day_of_week&.include?(i.to_s) || event_series.day_of_week&.include?(i), class: "h-4 w-4 accent-[#13714C]" }, i, nil %>
            <%= name.first(3) %>
          </label>
        <% end %>
      </div>
    </div>
  </div>

  <div class="mt-3">
    <%= form.label :ends_on, "Ends on (optional)", class: "mb-1 block text-[13px] font-semibold" %>
    <%= form.date_field :ends_on,
        class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm tabular-nums outline-none transition focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]",
        data: { controller: "datepicker" } %>
  </div>

  <div class="mt-3">
    <%= form.label :tag_ids, "Auto-invite from tags", class: "mb-1 block text-[13px] font-semibold" %>
    <%= form.collection_select :tag_ids, Current.account.tags.order(:name), :id, :name, { include_hidden: false },
        { multiple: true, class: "w-full", data: { controller: "combobox" } } %>
  </div>

  <%= form.submit event_series.persisted? ? "Save changes" : "Create series",
      class: "mt-5 w-full cursor-pointer rounded-lg bg-algae-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-[#0f5c3e]" %>
<% end %>
