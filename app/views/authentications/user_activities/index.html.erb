<% content_for :title, "User activities" %>
<% content_for :page_header, "User Activities" %>

<%= turbo_frame_tag "settings_content" do %>
  <div class="p-4">

    <%# --- MOBILE-ONLY BACK BUTTON --- %>
    <%= render "shared/settings_back_button" %>

    <div class="w-full max-w-3xl">
      <h1 class="mb-4 text-2xl font-bold">Activity Log</h1>
      <p class="mb-6 text-[#6b7672] dark:text-[#9AA6A0]">A log of important security-related user_activities that have occurred on your account.</p>

      <div id="user_activities" class="flex flex-col gap-2.5">
        <% @user_activities.each do |user_activity| %>
          <div id="<%= dom_id user_activity %>" class="flex items-center justify-between gap-3 rounded-2xl border border-[#D9DDE0] bg-white p-4 dark:border-white/10 dark:bg-[#131B17]">
            <div class="flex min-w-0 flex-col gap-1">
              <p class="text-sm font-semibold capitalize"><%= user_activity.action.gsub("_", " ") %></p>
              <p class="truncate text-sm text-[#6b7672] dark:text-[#9AA6A0]"><%= user_activity.user_agent %></p>
              <p class="text-xs tabular-nums text-[#8a938d] dark:text-[#9AA6A0]"><%= user_activity.created_at.strftime("%b %d, %Y %I:%M %p") %> from <%= user_activity.ip_address %></p>
            </div>
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300"><%= icon("laptop", css: "h-4 w-4") %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
