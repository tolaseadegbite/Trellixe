<% overdue = task.due_at < Time.current %>
<div class="flex items-center gap-3 px-5 py-3.5" id="<%= dom_id(task) %>">
  <span class="h-9 w-1 shrink-0 rounded-full <%= overdue ? 'bg-red-500' : 'bg-algae-300' %>"></span>
  <div class="min-w-0 flex-1">
    <p class="truncate text-[14px] font-semibold"><%= task.invitation.contact.full_name %></p>
    <p class="truncate text-[13px] text-[#8a938d] dark:text-[#9AA6A0]">from <%= task.invitation.event.name %> · <span class="<%= overdue ? 'font-medium text-red-700 dark:text-red-400' : '' %>"><%= overdue ? "#{time_ago_in_words(task.due_at)} overdue" : "due #{l(task.due_at, format: :short)}" %></span></p>
  </div>
  <%= link_to "Log", new_follow_up_task_interaction_log_path(task), data: { turbo_frame: "modal" },
      class: "shrink-0 rounded-lg #{overdue ? 'bg-algae-900 text-white hover:bg-[#0f5c3e]' : 'border border-[#D9DDE0] hover:border-[#A2E494] hover:text-algae-900 dark:border-white/10 dark:hover:text-algae-300'} px-3 py-1.5 text-[13px] font-semibold transition" %>
</div>
