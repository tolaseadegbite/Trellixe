<% content_for :title, "Dashboard" %>

<% content_for :page_header do %>
  <h4 class="font-semibold">Dashboard</h4>
<% end %>

<% content_for :header_action_buttons do %>
  <div class="show@md">
    <div class="flex gap items-center">
      <%= link_to "New contact", new_contact_path,
                    class: "btn bg-blue-500 hover:bg-blue-600 border-0 text-gray-50 i-full",
                    data: { turbo_frame: "modal" } %>
      
      <%= link_to "New event", new_event_path,
                    class: "btn bg-blue-500 hover:bg-blue-600 border-0 text-gray-50 i-full",
                    data: { turbo_frame: "modal" } %>
    </div>
  </div>
<% end %>

<div class="absolute hide@md" style="bottom: 8.5rem; right: 1.8rem; z-index: 9999">
  <%= link_to new_contact_path, class: "btn bg-blue-500 hover:bg-blue-600 text-gray-50 p-5 border-0 rounded-full", data: { turbo_frame: "modal" } do %>
    <span class="icon icon--pen"></span>
  <% end %>
</div>

<div class="absolute hide@md" style="bottom: 4rem; right: 1.8rem; z-index: 9999">
  <%= link_to new_event_path, class: "btn bg-blue-500 hover:bg-blue-600 text-gray-50 p-5 border-0 rounded-full", data: { turbo_frame: "modal" } do %>
    <span class="icon icon--calendar-range"></span>
  <% end %>
</div>

<div class="p-4">
  <%# --- TIMEZONE STATUS BAR --- %>
  <div class="flex items-center justify-center gap-1 mbe-8 text-xs text-subtle bg-shade pi-4 pb-2 rounded-md border border-main" style="inline-size: fit-content; margin-inline: auto;">
    <span class="icon icon--globe opacity-75" style="--icon-size: 0.85rem"></span>
    <span>Timezone: <strong><%= Time.zone.name %></strong></span>
    <span class="mi-2 opacity-50">|</span>
    <span>Local time: <strong><%= l(Time.current, format: :short) %></strong></span>
  </div>

  <%# --- PENDING FOLLOW-UPS --- %>
  <div class="mbe-10">
    <h2 class="text-2xl font-semibold mbe-4 text-center">Pending Follow-Ups</h2>

    <% if @pending_follow_ups.any? %>
      <div id="dashboard_pending_follow_ups" class="grid grid-cols-1 grid-cols-2@sm grid-cols-2@md grid-cols-3@lg gap-4 mbe-4">
        <%= render partial: "dashboards/pending_follow_up", collection: @pending_follow_ups, as: :pending_follow_up %>
      </div>
    <% else %>
      <div class="card text-center mbe-5 p-5">
        <p class="text-subtle">You're all caught up! No pending follow-ups.</p>
      </div>
    <% end %>

    <div class="text-center">
      <%= link_to follow_up_tasks_path, class: "btn bg-blue-500 hover:bg-blue-600 border-0 text-gray-50" do %>
        <span>View all pending Follow-Ups</span>
        <span class="text-subtle mis-1">→</span>
      <% end %>
    </div>
  </div>

  <%# --- UPCOMING EVENTS --- %>
  <div>
    <h2 class="text-2xl font-semibold mbe-4 text-center">Upcoming Events</h2>

    <% if @upcoming_events.any? %>
      <div id="dashboard_upcoming_events" class="grid grid-cols-1 grid-cols-2@sm grid-cols-2@md grid-cols-3@lg gap-4 mbe-4">
        <%= render partial: "dashboards/upcoming_event", collection: @upcoming_events, as: :upcoming_event %>
      </div>
    <% else %>
      <div class="card text-center mbe-5 p-5">
        <p class="text-subtle">No upcoming events. Why not create one?</p>
      </div>
    <% end %>

    <div class="text-center">
      <%= link_to events_path(q: { starts_at_gteq: Time.current }), class: "btn bg-blue-500 hover:bg-blue-600 border-0 text-gray-50" do %>
        <span>View all upcoming events</span>
        <span class="text-subtle mis-1">→</span>
      <% end %>
    </div>
  </div>
</div>