<% content_for :title, "Dashboard" %>

<% content_for :page_header do %>
  <h4 class="font-semibold">Dashboard</h4>
<% end %>

<% content_for :header_action_buttons do %>
  <div class="show@md">
    <div class="flex gap items-center">
      <%= link_to new_contact_path,
                    class: "btn btn--icon btn--primary",
                    data: { turbo_frame: "modal" } do %>
        <span class="icon icon--user-round-pen"></span>
      <% end %>

      <%= link_to new_event_path,
                    class: "btn btn--icon btn--primary",
                    data: { turbo_frame: "modal" } do %>
        <span class="icon icon--calendar-plus"></span>
      <% end %>
    </div>
  </div>
<% end %>

<div class="absolute hide@md" style="bottom: 8.5rem; right: 1.8rem; z-index: 9999">
  <%= link_to new_contact_path, class: "btn btn--primary p-5 rounded-full", data: { turbo_frame: "modal" } do %>
    <span class="icon icon--pen"></span>
  <% end %>
</div>

<div class="absolute hide@md" style="bottom: 4rem; right: 1.8rem; z-index: 9999">
  <%= link_to new_event_path, class: "btn btn--primary p-5 rounded-full", data: { turbo_frame: "modal" } do %>
    <span class="icon icon--calendar-range"></span>
  <% end %>
</div>

<div class="container p-4">

  <%# --- TODAY'S AGENDA --- %>
  <div class="flex flex-wrap gap-4 justify-center mbe-8">
    <% overdue_count = @overdue.count %>
    <%= tag.div class: "card flex items-center gap-3 min-h-24 p-4 #{'border-l-4' if overdue_count > 0}",
                style: ("border-left-color: var(--color-negative);" if overdue_count > 0) do %>
      <span class="text-3xl font-bold <%= overdue_count > 0 ? 'text-red-600' : 'text-subtle' %>"><%= overdue_count %></span>
      <div>
        <p class="font-semibold">Overdue</p>
        <p class="text-sm text-subtle">Follow-ups past due</p>
      </div>
    <% end %>

    <% today_count = @due_today.count %>
    <%= tag.div class: "card flex items-center gap-3 min-h-24 p-4 #{'border-l-4' if today_count > 0}",
                style: ("border-left-color: #f59e0b;" if today_count > 0) do %>
      <span class="text-3xl font-bold <%= today_count > 0 ? 'text-amber-500' : 'text-subtle' %>"><%= today_count %></span>
      <div>
        <p class="font-semibold">Due Today</p>
        <p class="text-sm text-subtle">Need attention</p>
      </div>
    <% end %>

    <%= tag.div class: "card flex items-center gap-3 min-h-24 p-4 #{'border-l-4' if @events_today.any?}",
                style: ("border-left-color: #3b82f6;" if @events_today.any?) do %>
      <span class="text-3xl font-bold <%= @events_today.any? ? 'text-blue-500' : 'text-subtle' %>"><%= @events_today.count %></span>
      <div>
        <p class="font-semibold">Events Today</p>
        <p class="text-sm text-subtle"><%= @events_today.any? ? @events_today.first.name : "Nothing scheduled" %></p>
      </div>
    <% end %>
  </div>

  <%# --- PENDING FOLLOW-UPS (GROUPED BY URGENCY) --- %>
  <div class="mbe-10">
    <div class="flex items-center justify-between mbe-4">
      <h2 class="text-xl font-semibold">Pending Follow-Ups</h2>
      <%= link_to follow_up_tasks_path, class: "btn btn--subtle text-sm" do %>
        View all <span class="mis-1">→</span>
      <% end %>
    </div>

    <%= render "dashboards/follow_up_group", label: "Overdue", tasks: @overdue, color: "var(--color-negative)" %>
    <%= render "dashboards/follow_up_group", label: "Due Today", tasks: @due_today, color: "#f59e0b" %>
    <%= render "dashboards/follow_up_group", label: "Due This Week", tasks: @due_this_week, color: "#3b82f6" %>
  </div>

  <%# --- UPCOMING EVENTS --- %>
  <div class="mbe-10">
    <div class="flex items-center justify-between mbe-4">
      <h2 class="text-xl font-semibold">Upcoming Events</h2>
      <%= link_to events_path(view: "events-list", scope: "upcoming"), class: "btn btn--subtle text-sm" do %>
        View all <span class="mis-1">→</span>
      <% end %>
    </div>

    <% if @upcoming_events.any? %>
      <div class="grid grid-cols-1 grid-cols-2@sm grid-cols-3@lg gap-4">
        <%= render partial: "dashboards/upcoming_event", collection: @upcoming_events, as: :event %>
      </div>
    <% else %>
      <div class="card text-center p-5">
        <p class="text-subtle">No upcoming events. Why not create one?</p>
      </div>
    <% end %>
  </div>

  <%# --- CELL PULSE --- %>
  <div class="flex flex-wrap gap-4 justify-center">
    <div class="card flex flex-col items-center p-4" style="min-inline-size: 7rem;">
      <span class="text-2xl font-bold text-primary"><%= @contacts_count %></span>
      <span class="text-sm text-subtle">Contacts</span>
    </div>

    <div class="card flex flex-col items-center p-4" style="min-inline-size: 7rem;">
      <span class="text-2xl font-bold text-primary"><%= @pending_tasks %>/<%= @total_tasks %></span>
      <span class="text-sm text-subtle">Tasks pend/total</span>
    </div>

    <div class="card flex flex-col items-center p-4" style="min-inline-size: 7rem;">
      <span class="text-2xl font-bold <%= @task_completion >= 70 ? 'text-green-600' : 'text-amber-600' %>"><%= @task_completion %>%</span>
      <span class="text-sm text-subtle">Follow-up rate</span>
    </div>

    <div class="card flex flex-col items-center p-4" style="min-inline-size: 7rem;">
      <span class="text-2xl font-bold text-primary"><%= @events_this_month %></span>
      <span class="text-sm text-subtle">Events this month</span>
    </div>

    <div class="card flex flex-col items-center p-4" style="min-inline-size: 7rem;">
      <span class="text-2xl font-bold text-primary"><%= @team_count %></span>
      <span class="text-sm text-subtle">Team members</span>
    </div>
  </div>

</div>
