<% content_for :title, "Dashboard" %>
<% content_for :page_header, "Good #{Time.current.hour < 12 ? 'morning' : Time.current.hour < 17 ? 'afternoon' : 'evening'}, #{current_user.full_name.split.first}" %>
<% content_for :header_action_buttons do %>
  <%= link_to "New contact", new_contact_path, data: { turbo_frame: "modal" },
      class: "flex items-center gap-1.5 rounded-lg border border-[#D9DDE0] bg-white px-3 py-2 text-[13px] font-medium transition hover:border-algae-300 dark:border-white/10 dark:bg-white/5" %>
  <%= link_to "New event", new_event_path,
      class: "flex items-center gap-1.5 rounded-lg bg-algae-900 px-3 py-2 text-[13px] font-semibold text-white transition hover:bg-pine" %>
<% end %>

<div class="space-y-5">
  <div class="grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
    <div class="rounded-2xl border border-[#D9DDE0] bg-white p-4 dark:border-white/10 dark:bg-card">
      <p class="text-xs font-medium text-[#8a938d] dark:text-fog">Due follow-ups</p>
      <p class="mt-1 font-display text-[26px] font-bold tabular-nums tracking-tight <%= @overdue_count > 0 ? 'text-red-700 dark:text-red-400' : '' %>"><%= @pending_tasks.size %></p>
      <p class="mt-0.5 text-xs text-[#8a938d] dark:text-fog"><%= @overdue_count %> overdue</p>
    </div>
    <div class="rounded-2xl border border-[#D9DDE0] bg-white p-4 dark:border-white/10 dark:bg-card">
      <p class="text-xs font-medium text-[#8a938d] dark:text-fog">Due todos</p>
      <p class="mt-1 font-display text-[26px] font-bold tabular-nums tracking-tight <%= @todos_overdue_count > 0 ? 'text-red-700 dark:text-red-400' : '' %>"><%= @due_todos_count %></p>
      <p class="mt-0.5 text-xs text-[#8a938d] dark:text-fog"><%= @todos_overdue_count %> overdue</p>
    </div>
    <div class="rounded-2xl border border-[#D9DDE0] bg-white p-4 dark:border-white/10 dark:bg-card">
      <p class="text-xs font-medium text-[#8a938d] dark:text-fog">Contacts</p>
      <p class="mt-1 font-display text-[26px] font-bold tabular-nums tracking-tight"><%= @contacts_count %></p>
      <p class="mt-0.5 text-xs text-[#8a938d] dark:text-fog">+<%= @week_contacts %> this week</p>
    </div>
    <div class="rounded-2xl border border-[#D9DDE0] bg-white p-4 dark:border-white/10 dark:bg-card">
      <p class="text-xs font-medium text-[#8a938d] dark:text-fog">Upcoming events</p>
      <p class="mt-1 font-display text-[26px] font-bold tabular-nums tracking-tight"><%= @upcoming_events.size %></p>
      <p class="mt-0.5 text-xs text-[#8a938d] dark:text-fog"><%= @upcoming_events.first ? @upcoming_events.first.starts_at.strftime("%a, %b %-d") : "Nothing scheduled" %></p>
    </div>
    <div class="rounded-2xl border border-[#D9DDE0] bg-white p-4 dark:border-white/10 dark:bg-card">
      <p class="text-xs font-medium text-[#8a938d] dark:text-fog">Attendance rate</p>
      <p class="mt-1 font-display text-[26px] font-bold tabular-nums tracking-tight"><%= @attendance_rate %>%</p>
      <p class="mt-0.5 text-xs text-[#8a938d] dark:text-fog">invited → attended</p>
    </div>
    <div class="rounded-2xl border border-[#D9DDE0] bg-white p-4 dark:border-white/10 dark:bg-card">
      <p class="text-xs font-medium text-[#8a938d] dark:text-fog">Invite → follow-up</p>
      <p class="mt-1 font-display text-[26px] font-bold tabular-nums tracking-tight"><%= @follow_up_rate %>%</p>
      <p class="mt-0.5 text-xs tabular-nums text-[#8a938d] dark:text-fog"><%= @follow_ups_count %> of <%= @invites_count %> invited</p>
    </div>
  </div>

  <div class="grid gap-5 lg:grid-cols-6">
    <section class="min-w-0 rounded-2xl border border-[#D9DDE0] bg-white lg:col-span-2 dark:border-white/10 dark:bg-card">
      <div class="flex items-center justify-between gap-3 border-b border-[#E9EBED] px-5 py-3.5 dark:border-white/10">
        <div class="min-w-0">
          <h2 class="font-display text-[15px] font-semibold">Today's follow-ups</h2>
          <p class="text-[13px] text-[#8a938d] dark:text-fog">Call, text, or visit while the connection is warm.</p>
        </div>
        <%= link_to "View all", follow_up_tasks_path, class: "shrink-0 text-[13px] font-semibold text-algae-900 hover:underline dark:text-algae-300" %>
      </div>
      <div class="divide-y divide-[#E9EBED] dark:divide-white/10">
        <% if @pending_tasks.any? %>
          <%= render partial: "dashboards/follow_up_row", collection: @pending_tasks, as: :task %>
        <% else %>
          <div class="px-5 py-10 text-center">
            <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300"><%= icon("list-checks", css: "h-5 w-5") %></div>
            <p class="mt-3 text-sm font-semibold">All caught up</p>
            <p class="mx-auto mt-1 max-w-xs text-[13px] text-[#8a938d] dark:text-fog">Mark Sunday guests as attended and Trellixe will queue Monday's calls here.</p>
          </div>
        <% end %>
      </div>
    </section>

    <section class="min-w-0 rounded-2xl border border-[#D9DDE0] bg-white lg:col-span-2 dark:border-white/10 dark:bg-card">
      <div class="flex items-center justify-between gap-3 border-b border-[#E9EBED] px-5 py-3.5 dark:border-white/10">
        <div class="min-w-0">
          <h2 class="font-display text-[15px] font-semibold">Due soon</h2>
          <p class="text-[13px] text-[#8a938d] dark:text-fog">Your todos with dates, soonest first.</p>
        </div>
        <%= link_to "View all", todos_path, class: "shrink-0 text-[13px] font-semibold text-algae-900 hover:underline dark:text-algae-300" %>
      </div>
      <div class="divide-y divide-[#E9EBED] dark:divide-white/10">
        <% if @due_todos.any? %>
          <%= render partial: "dashboards/todo_row", collection: @due_todos, as: :todo %>
        <% else %>
          <div class="px-5 py-10 text-center">
            <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300"><%= icon("circle-check", css: "h-5 w-5") %></div>
            <p class="mt-3 text-sm font-semibold">Nothing due</p>
            <p class="mx-auto mt-1 max-w-xs text-[13px] text-[#8a938d] dark:text-fog">Dated todos assigned to you land here before they slip.</p>
          </div>
        <% end %>
      </div>
    </section>

    <section class="min-w-0 rounded-2xl border border-[#D9DDE0] bg-white lg:col-span-2 dark:border-white/10 dark:bg-card">
      <div class="flex items-center justify-between gap-3 border-b border-[#E9EBED] px-5 py-3.5 dark:border-white/10">
        <div class="min-w-0">
          <h2 class="font-display text-[15px] font-semibold">Up next</h2>
          <p class="text-[13px] text-[#8a938d] dark:text-fog">Services, outreaches, cell meetings.</p>
        </div>
        <%= link_to "Calendar", events_path(view: "calendar"), class: "shrink-0 text-[13px] font-semibold text-algae-900 hover:underline dark:text-algae-300" %>
      </div>
      <div class="divide-y divide-[#E9EBED] dark:divide-white/10">
        <% if @upcoming_events.any? %>
          <%= render partial: "dashboards/upcoming_event_row", collection: @upcoming_events, as: :event %>
        <% else %>
          <div class="px-5 py-10 text-center">
            <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-xl bg-algae-50 text-algae-900 dark:bg-algae-600/15 dark:text-algae-300"><%= icon("calendar-range", css: "h-5 w-5") %></div>
            <p class="mt-3 text-sm font-semibold">No events scheduled</p>
            <p class="mx-auto mt-1 max-w-xs text-[13px] text-[#8a938d] dark:text-fog">Create your Sunday service or weekly cell meeting to start inviting.</p>
            <%= link_to "Create event", new_event_path, class: "mt-4 inline-flex rounded-lg bg-algae-900 px-4 py-2 text-[13px] font-semibold text-white" %>
          </div>
        <% end %>
      </div>
    </section>
  </div>
</div>
