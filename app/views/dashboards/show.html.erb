<% content_for :title, "Dashboard" %>

<% content_for :page_header do %>
  <h4 class="font-semibold">Dashboard</h4>
<% end %>

<% content_for :header_action_buttons do %>
  <div class="show@md">
    <div class="flex gap items-center">
      <%= link_to "New contact", new_contact_path,
                    class: "btn btn--primary",
                    data: { turbo_frame: "modal" } %>
      
      <%= link_to "New event", new_event_path,
                    class: "btn btn--primary",
                    data: { turbo_frame: "modal" } %>
    </div>
  </div>
<% end %>

<div class="absolute hide@md" style="bottom: 8.5rem; right: 1.8rem; z-index: 9999">
  <%= link_to new_contact_path, class: "btn btn--primary rounded-full p-5 border-2 border-blue-500 new-btn", data: { turbo_frame: "modal" } do %>
    <span class="icon icon--pen"></span>
  <% end %>
</div>

<div class="absolute hide@md" style="bottom: 4rem; right: 1.8rem; z-index: 9999">
  <%= link_to new_event_path, class: "btn btn--primary rounded-full p-5 new-btn", data: { turbo_frame: "modal" } do %>
    <span class="icon icon--calendar-range"></span>
  <% end %>
</div>

<div class="p-4">

  <div class="mbe-8">
    <h2 class="text-2xl font-semibold mbe-4 text-center">Pending Follow-Ups</h2>

    <% if @pending_follow_ups.empty? %>
      <div id="dashboard_pending_follow_ups" class="grid grid-cols-1 grid-cols-2@sm grid-cols-2@md grid-cols-3@lg gap-4 mbe-4">
        <%= render partial: "dashboards/pending_follow_up", collection: @pending_follow_ups, as: :pending_follow_up %>
      </div>
    <% end %>

    <div class="card text-center mb-5 p-5">
      <p class="text-subtle">You're all caught up! No pending follow-ups.</p>
    </div>

    <div class="text-center">
      <%= link_to follow_up_tasks_path, class: "btn" do %>
        View all pending Follow-Ups
        <span class="text-subtle">→</span>
      <% end %>
    </div>
  </div>

  <div>

    <h2 class="text-2xl font-semibold mbe-4 text-center">Upcoming Events</h2>

    <div id="dashboard_upcoming_events" class="grid grid-cols-1 grid-cols-2@sm grid-cols-2@md grid-cols-3@lg gap-4 mbe-4">
      <%= render partial: "dashboards/upcoming_event", collection: @upcoming_events, as: :upcoming_event %>
    </div>

    <% if @upcoming_events.empty? %>
      <div class="card text-center mb-5 p-5 text-center">
        <p class="text-subtle">No upcoming events. Why not create one?</p>
      </div>
    <% end %>

    <div class="text-center">
      <%= link_to events_path(q: { starts_at_gteq: Time.current }), class: "btn" do %>
        View all upcoming events
        <span class="text-subtle">→</span>
      <% end %>
    </div>
  </div>
</div>