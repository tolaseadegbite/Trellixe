<%= link_to event, class: "card p-4 text-decoration-none hover:shadow-md transition block", data: { turbo_frame: "_top" } do %>
  <p class="font-semibold text-primary mbe-1"><%= event.name %></p>
  <div class="flex items-center gap-half text-sm text-subtle">
    <span class="icon icon--calendar-range" aria-hidden="true" style="--icon-size: 0.85rem;"></span>
    <span>
      <% if event.starts_at.to_date == event.ends_at.to_date %>
        <%= event.starts_at.strftime("%a, %b %d · %l:%M %p") %>
      <% else %>
        <%= event.starts_at.strftime("%b %d") %> - <%= event.ends_at.strftime("%b %d") %>
      <% end %>
    </span>
  </div>
<% end %>
