<% content_for :title, "Team Members" %>

<% content_for :page_header do %>
  <h4 class="font-semibold">Team</h4>
<% end %>

<%# --- MOBILE FAB --- %>
<% if current_role == "admin" %>
  <% unless Current.account.seat_limit_reached? %>
    <div class="absolute hide@md" style="bottom: 4rem; right: 1rem; z-index: 9999">
      <%= link_to new_team_invitation_path, class: "btn bg-blue-500 hover:bg-blue-600 text-gray-50 p-5 border-0 rounded-full", data: { turbo_frame: "modal" } do %>
        <span class="icon icon--plus"></span>
      <% end %>
    </div>
  <% end %>
<% end %>

<div class="i-full p-2 mi-auto container p-4">
  <div class="flex items-center justify-between mbe-6">
    <div>
      <h2 class="text-2xl font-bold">Team Members</h2>
      <div class="flex flex-col gap-2 text-sm text-subtle mts-1">
        <span>Manage access to <strong><%= Current.account.name %></strong>.</span>
        
        <%# Seat Counter %>
        <span class="bg-shade pi-2 pb-1 text-xs font-medium border rounded-md" style="inline-size: ;">
          <%= Current.account.seats_used %> / <%= Current.account.seat_limit %> Seats Used
        </span>
      </div>
    </div>

    <%# --- DESKTOP BUTTONS --- %>
    <div class="show@md">
      <% if current_role == "admin" %>
        <% if Current.account.seat_limit_reached? %>
          <%= link_to "#", class: "btn bg-purple-600 text-reversed hover:bg-purple-700 font-semibold rounded-md p-2 flex items-center gap-2" do %>
            <span class="icon icon--sparkles"></span>
            <span>Upgrade Plan</span>
          <% end %>
        <% else %>
          <%= link_to new_team_invitation_path, 
                      class: "btn bg-blue-500 border-0 text-gray-50 hover:bg-blue-600 font-semibold rounded-md p-2 flex items-center gap-2", 
                      data: { turbo_frame: "modal" } do %>
            <span class="icon icon--plus"></span>
            <span>Invite Member</span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <%# --- TABS COMPONENT --- %>
  <div class="tabs i-full" data-controller="tabs">
    <div class="tabs__list border-b border-main mbe-4" role="tablist">
      <button type="button" id="trigger_active" class="btn tabs__button" data-tabs-target="button" data-action="tabs#select" role="tab" aria-controls="tab_active" aria-selected="true">
        Active Members (<%= @active_memberships.count %>)
      </button>
      <button type="button" id="trigger_pending" class="btn tabs__button" data-tabs-target="button" data-action="tabs#select" role="tab" aria-controls="tab_pending">
        Pending Invites (<%= @pending_invitations.count %>)
      </button>
    </div>

    <%# --- TAB 1: ACTIVE MEMBERS --- %>
    <div id="tab_active" data-tabs-target="tab" role="tabpanel" aria-labelledby="trigger_active">
      
      <%# DESKTOP TABLE %>
      <div class="show@md relative i-full overflow-x-auto border border-main rounded-lg bg-main">
        <table class="table i-full text-left">
          <thead class="bg-shade font-semibold text-xs uppercase text-subtle">
            <tr>
              <th class="p-3">User</th>
              <th class="p-3">Role</th>
              <th class="p-3">Joined</th>
              <th class="p-3 text-end"></th>
            </tr>
          </thead>
          <tbody id="members-list">
            <%= render partial: "members/membership", collection: @active_memberships %>
          </tbody>
        </table>
      </div>

      <%# MOBILE CARDS %>
      <div class="hide@md flex flex-col gap-4">
        <% if @active_memberships.empty? %>
          <p class="text-subtle text-center p-8">No active members.</p>
        <% else %>
          <%# Render the new partial %>
          <%= render partial: "members/member_card", collection: @active_memberships, as: :membership %>
        <% end %>
      </div>
    </div>

    <%# --- TAB 2: PENDING INVITES --- %>
    <div hidden id="tab_pending" data-tabs-target="tab" role="tabpanel" aria-labelledby="trigger_pending">
      
      <%# DESKTOP TABLE %>
      <div class="show@md relative i-full overflow-x-auto border border-main rounded-lg bg-main">
        <table class="table i-full text-left">
          <thead class="bg-shade font-semibold text-xs uppercase text-subtle">
            <tr>
              <th class="p-3">Email</th>
              <th class="p-3">Role</th>
              <th class="p-3">Sent</th>
              <th class="p-3 text-end"></th>
            </tr>
          </thead>
          <tbody id="invitations-list">
            <% if @pending_invitations.any? %>
              <%= render partial: "team_invitations/team_invitation", collection: @pending_invitations %>
            <% else %>
              <%= render "shared/empty_state_desktop" %>
            <% end %>
          </tbody>
        </table>
      </div>

      <%# MOBILE CARDS %>
      <div id="invitations-cards" class="hide@md flex flex-col gap-4">
        <% if @pending_invitations.empty? %>
          <%= render "shared/empty_state_mobile" %>
        <% else %>
          <%= render partial: "team_invitations/invitation-card", collection: @pending_invitations, as: :invitation %>
        <% end %>
      </div>
    </div>
  </div>
</div>