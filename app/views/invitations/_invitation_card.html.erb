<div id="<%= dom_id(invitation, :card) %>" class="card bg-main p-3 flex items-center gap-4">
  <div class="flex items-center gap shrink-0">
    <% if invitation.event.starts_at <= Time.current %>
      <%= check_box_tag "invitation_ids[]", invitation.id, false, class: "input cursor-pointer", data: { action: "check-all#check", check_all_target: "dependant" } %>
    <% else %>
      <div class="flex items-center justify-center text-subtle opacity-50" style="inline-size: 1.25rem; block-size: 1.25rem;">
        <span class="icon icon--clock" aria-hidden="true"></span>
      </div>
    <% end %>
    <div class="flex items-center justify-center rounded-full bg-black text-reversed shrink-0 border-0" style="block-size: 2.5rem; inline-size: 2.5rem;">
      <span class="font-semibold"><%= invitation.contact.full_name.split.first(2).map(&:first).join.upcase %></span>
    </div>
  </div>
  <div class="flex flex-col grow min-i-0 gap-1">
    <div class="flex items-center justify-between gap-2">
      <div class="flex flex-col min-w-0">
        <span class="font-semibold text-sm truncate"><%= invitation.contact.full_name %></span>
        <span class="text-xs text-subtle truncate"><%= invitation.contact.email %></span>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <% status_color = invitation.attended? ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800" %>
        <span class="<%= status_color %> pi-2 pb-1 rounded-full text-xs font-medium capitalize"><%= invitation.status %></span>
        <%= link_to edit_invitation_path(invitation), class: "btn btn--icon btn--subtle", data: { turbo_frame: "modal" } do %>
          <span class="icon icon--pen" aria-hidden="true"></span>
        <% end %>
      </div>
    </div>
    <% if invitation.notes.present? %>
      <div class="text-xs text-subtle truncate"><%= invitation.notes.truncate(100) %></div>
    <% end %>
  </div>
</div>
