<% status_classes = case invitation.status
   when "attended" then "bg-[#A2E494] text-[#1c2420]"
   when "declined" then "bg-algae-900 text-white"
   else "bg-[#E9EBED] text-[#3d4742] dark:bg-white/10 dark:text-[#C6CFC9]"
   end %>
<div id="<%= dom_id(invitation, :card) %>" class="rounded-2xl border border-[#D9DDE0] bg-white p-3.5 dark:border-white/10 dark:bg-[#131B17]">
  <div class="flex items-center gap-3">
    <% if invitation.event.starts_at <= Time.current %>
      <%= check_box_tag "invitation_ids[]", invitation.id, false, class: "h-4 w-4 shrink-0 accent-[#13714C]", data: { action: "check-all#check", check_all_target: "dependant" } %>
    <% else %>
      <span class="flex h-5 w-5 shrink-0 items-center justify-center text-[#c3c9c5]" title="Attendance opens when the event starts"><%= icon("calendar-range", css: "h-4 w-4") %></span>
    <% end %>
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-algae-900 text-sm font-bold text-white">
      <%= invitation.contact.full_name.split.first(2).map(&:first).join.upcase %>
    </span>
    <div class="min-w-0 flex-1">
      <div class="flex items-center justify-between gap-2">
        <%= link_to invitation.contact.full_name, contact_path(invitation.contact), class: "truncate text-[14.5px] font-semibold hover:text-algae-900 dark:hover:text-algae-300", data: { turbo_frame: "_top" } %>
        <span class="flex shrink-0 items-center gap-1.5">
          <span class="rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize <%= status_classes %>"><%= invitation.status %></span>
          <%= link_to edit_invitation_path(invitation), data: { turbo_frame: "modal" }, title: "Edit", class: "flex h-8 w-8 items-center justify-center rounded-lg text-[#8a938d] transition hover:bg-[#E9EBED] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:bg-white/10 dark:hover:text-[#E7ECE9]" do %><%= icon("pen", css: "h-4 w-4") %><% end %>
        </span>
      </div>
      <p class="truncate text-[13px] text-[#8a938d] dark:text-[#9AA6A0]"><%= invitation.contact.email %></p>
      <% if invitation.notes.present? %>
        <p class="mt-0.5 truncate text-[13px] text-[#6b7672] dark:text-[#9AA6A0]"><%= invitation.notes.truncate(100) %></p>
      <% end %>
    </div>
  </div>

  <% task = invitation.follow_up_tasks.find { |t| t.user_id == current_user.id } %>
  <% if invitation.interaction_logs.any? || task %>
    <div class="mt-3 border-t border-[#E9EBED] pt-1.5 dark:border-white/10">
      <div id="<%= dom_id(invitation, :logs_mobile) %>" class="space-y-0.5">
        <% invitation.interaction_logs.order(created_at: :desc).limit(2).each do |log| %>
          <%= render "interaction_logs/log_invitation_row", log: log, prefix: :mobile %>
        <% end %>
      </div>
      <div class="mt-1 flex items-center gap-3">
        <% if invitation.interaction_logs.count > 2 %>
          <%= link_to "View all →", contact_path(invitation.contact), class: "text-xs font-semibold text-algae-900 hover:underline dark:text-algae-300", data: { turbo_frame: "_top" } %>
        <% end %>
        <% if task %>
          <%= link_to "Log follow-up", new_follow_up_task_interaction_log_path(task), class: "text-xs font-semibold text-algae-900 hover:underline dark:text-algae-300", data: { turbo_frame: "modal" } %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
