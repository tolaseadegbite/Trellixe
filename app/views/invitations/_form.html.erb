<%= form_with(model: [event, invitation], class: "flex flex-col items-start gap") do |form| %>

  <% if invitation.errors.any? %>
    <div class="text-negative">
      <%# Simplified error display %>
      <%= invitation.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="flex flex-col items-start gap-half i-full">
    <%#= form.label :contact_ids, "Select contacts to invite", class: "font-medium leading-none" %>
    <%= form.collection_select :contact_ids,
                                @available_contacts,
                                :id,
                                :full_name,
                                { include_blank: "Select contacts to invite" },
                                { class: "i-full mbs-2", multiple: true, data: { controller: "combobox" } }  %>
  </div>

  <div class="self-start">
    <%= form.submit "Add to Invitation List", class: "btn bg-blue-600 hover:bg-blue-700 border-0 text-gray-50 i-full" %>
  </div>
<% end %>