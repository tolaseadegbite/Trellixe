<%= form_with(model: invitation, data: { controller: "autosubmit" }) do |form| %>
  <div>
    <%= form.label :status, class: "mb-1 block text-[13px] font-semibold" %>
    <%= form.select :status, Invitation.statuses.keys.map { |s| [ s.humanize, s ] }, {},
        { class: "w-full cursor-pointer rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm outline-none transition focus:border-algae-600 focus:ring-2 focus:ring-algae-300/50 dark:border-white/10 dark:bg-night" } %>
  </div>
  <div class="mt-3">
    <%= form.label :notes, "Notes", class: "mb-1 block text-[13px] font-semibold" %>
    <%= form.text_area :notes, rows: 4, placeholder: "e.g. Bring a friend, needs a ride…",
        class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-sm outline-none transition placeholder:text-[#a7b0aa] focus:border-algae-600 focus:ring-2 focus:ring-algae-300/50 dark:border-white/10 dark:bg-night" %>
  </div>
  <div class="mt-5 flex justify-end gap-2">
    <button type="button" class="rounded-lg border border-[#D9DDE0] px-4 py-2 text-sm font-semibold transition hover:border-algae-300 dark:border-white/10" data-action="click->modal#close">Cancel</button>
    <%= form.submit "Save changes", class: "cursor-pointer rounded-lg bg-algae-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-pine" %>
  </div>
<% end %>
