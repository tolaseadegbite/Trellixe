<% status_classes = case invitation.status
   when "attended" then "bg-algae-300 text-[#1c2420]"
   when "declined" then "bg-algae-900 text-white"
   else "bg-[#E9EBED] text-[#3d4742] dark:bg-white/10 dark:text-clay"
   end %>
<%= link_to invitation.event, class: "block rounded-xl border border-[#D9DDE0] bg-white p-4 transition hover:border-algae-300 hover:bg-[#F6F9F7] dark:border-white/10 dark:bg-card dark:hover:bg-white/[0.04]", data: { turbo_frame: "_top" } do %>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <p class="truncate text-sm font-semibold text-algae-900 dark:text-algae-300"><%= invitation.event.name %></p>
      <p class="mt-0.5 text-[13px] tabular-nums text-[#8a938d] dark:text-fog"><%= invitation.event.starts_at.strftime("%B %d, %Y") %></p>
      <% if invitation.notes.present? %>
        <p class="mt-1.5 break-words text-[13px] text-[#6b7672] dark:text-fog"><span class="font-semibold text-[#1c2420] dark:text-ink">Note:</span> <%= invitation.notes %></p>
      <% end %>
    </div>
    <span class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize <%= status_classes %>"><%= invitation.status %></span>
  </div>
<% end %>
