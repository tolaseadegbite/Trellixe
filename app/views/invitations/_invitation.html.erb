<tr id="<%= dom_id(invitation) %>" class="border-b last:border-0 hover:bg-highlight transition">
  <%# 1. Checkbox for Bulk Actions %>
  <td class="p-3">
    <%= check_box_tag "invitation_ids[]", invitation.id, false, class: "input cursor-pointer", data: { action: "check-all#check", check_all_target: "dependant" } %>
  </td>

  <td class="p-3">
    <div class="font-medium text-primary"><%= invitation.contact.full_name %></div>
    <div class="text-xs text-subtle"><%= invitation.contact.email %></div>
  </td>
  
  <td class="p-3">
    <% status_color = invitation.attended? ? "bg-green-100 text-green-800" : "bg-gray-100 text-gray-800" %>
    <span class="<%= status_color %> pi-2 pb-1 rounded-full text-xs font-medium capitalize">
      <%= invitation.status %>
    </span>
  </td>

  <td class="p-3 text-sm text-subtle max-w-xs overflow-hidden text-ellipsis whitespace-nowrap" style="max-inline-size: 8rem;">
    <%= invitation.notes&.truncate(100).presence || "-" %>
  </td>

  <td class="p-3 text-end flex justify-end gap-2">
    <%# Keep your existing edit/delete buttons here %>
    <%= link_to edit_invitation_path(invitation), class: "btn btn--icon btn--subtle", data: { turbo_frame: "modal" } do %>
      <span class="icon icon--pen"></span>
    <% end %>
  </td>
</tr>