<div data-controller="search-filter" data-action="click@window->search-filter#closeOnClickOutside">
  <div class="flex flex-wrap items-center gap-2">
    <%= search_form_for(@invitations_search, url: event_path(@event),
        data: { turbo_frame: "guest_list", turbo_action: "advance", controller: "debounce" },
        html: { class: "flex min-w-0 flex-1 items-center gap-2" }) do |f| %>
      <span class="relative min-w-0 flex-1">
        <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-[#8a938d] dark:text-[#9AA6A0]"><%= icon("search", css: "h-4 w-4") %></span>
        <%= f.search_field :contact_first_name_or_contact_last_name_or_contact_email_cont,
            placeholder: "Search guests by name or email…",
            class: "w-full rounded-lg border border-[#D9DDE0] bg-white py-2.5 pl-9 pr-3 text-sm outline-none transition placeholder:text-[#a7b0aa] focus:border-[#3AB67D] focus:ring-2 focus:ring-[#A2E494]/50 dark:border-white/10 dark:bg-[#0C1210]",
            data: { action: "input->debounce#submit" } %>
      </span>
    <% end %>
    <button type="button" class="flex items-center gap-1.5 rounded-lg border border-[#D9DDE0] bg-white px-3 py-2.5 text-[13px] font-medium transition hover:border-[#A2E494] dark:border-white/10 dark:bg-[#131B17]" data-action="search-filter#toggle">
      <%= icon("search", css: "h-4 w-4") %> Filters
    </button>
  </div>

  <div class="hidden pt-3" data-search-filter-target="filters">
    <%= search_form_for(@invitations_search, url: event_path(@event),
        data: { turbo_frame: "guest_list", turbo_action: "advance", controller: "debounce" }) do |f| %>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <%= f.label :status_eq, "Status", class: "mb-1 block text-[11px] font-semibold uppercase tracking-wide text-[#8a938d] dark:text-[#9AA6A0]" %>
          <%= f.select :status_eq, Invitation.statuses.map { |name, value| [ name.humanize, value ] }, { include_blank: "Any status" },
              { class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2 text-sm dark:border-white/10 dark:bg-[#0C1210]", data: { action: "input->debounce#submit" } } %>
        </div>
        <div class="flex items-end">
          <%= link_to "Reset", event_path(@event), data: { turbo_frame: "guest_list" },
              class: "w-full rounded-lg border border-[#D9DDE0] bg-white px-3 py-2 text-center text-sm font-semibold transition hover:border-[#A2E494] dark:border-white/10 dark:bg-[#131B17]" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
