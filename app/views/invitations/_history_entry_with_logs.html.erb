<% status_classes = case invitation.status
   when "attended" then "bg-[#A2E494] text-[#1c2420]"
   when "declined" then "bg-algae-900 text-white"
   else "bg-[#E9EBED] text-[#3d4742] dark:bg-white/10 dark:text-[#C6CFC9]"
   end %>
<div class="rounded-xl border border-[#D9DDE0] bg-white p-4 dark:border-white/10 dark:bg-[#131B17]">
  <%= link_to invitation.event, class: "block transition", data: { turbo_frame: "_top" } do %>
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="truncate text-sm font-semibold text-algae-900 hover:underline dark:text-algae-300"><%= invitation.event.name %></p>
        <p class="mt-0.5 text-[13px] tabular-nums text-[#8a938d] dark:text-[#9AA6A0]"><%= invitation.event.starts_at.strftime("%B %d, %Y") %></p>
        <% if invitation.notes.present? %>
          <p class="mt-1.5 break-words text-[13px] text-[#6b7672] dark:text-[#9AA6A0]"><span class="font-semibold text-[#1c2420] dark:text-[#E7ECE9]">Invitation note:</span> <%= invitation.notes %></p>
        <% end %>
      </div>
      <span class="shrink-0 rounded-full px-2.5 py-0.5 text-xs font-semibold capitalize <%= status_classes %>"><%= invitation.status %></span>
    </div>
  <% end %>
</div>
