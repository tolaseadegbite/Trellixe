<%# Unified pending-invite row — the only one at every width.
    Locals: team_invitation. Resend + Revoke stay inline. %>
<div id="<%= dom_id(team_invitation) %>" class="flex min-h-16 flex-wrap items-center gap-x-3 gap-y-2 px-4 py-3">
  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-amber-100 text-amber-800">
    <%= icon("mail", css: "h-4 w-4") %>
  </span>
  <span class="min-w-0 flex-1 basis-40">
    <span class="block truncate text-[14.5px] font-semibold"><%= team_invitation.email %></span>
    <span class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[13px] text-[#8a938d] dark:text-[#9AA6A0]">
      <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2 py-px text-[11px] font-semibold capitalize text-amber-800"><%= team_invitation.role %> · Pending</span>
      <span class="tabular-nums"><%= time_ago_in_words(team_invitation.updated_at) %> ago</span>
    </span>
  </span>
  <% if can_manage_members? %>
    <span class="flex shrink-0 items-center gap-1.5">
      <%= button_to resend_team_invitation_path(team_invitation), method: :post,
          class: "cursor-pointer rounded-lg px-2.5 py-2 text-[13px] font-medium text-[#6b7672] transition hover:bg-[#E9EBED] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:bg-white/10 dark:hover:text-[#E7ECE9]",
          form: { data: { turbo_submits_with: "Sending..." } } do %>
        Resend
      <% end %>
      <%= button_to "Revoke", team_invitation_path(team_invitation), method: :delete,
          class: "cursor-pointer rounded-lg bg-red-700 px-3 py-2 text-xs font-semibold text-white transition hover:bg-red-800",
          form: { data: { turbo_confirm: "Revoke this invitation?" } } %>
    </span>
  <% end %>
</div>
