<tr id="<%= dom_id(team_invitation) %>" class="transition hover:bg-[#F6F9F7] dark:hover:bg-white/[0.04]">
  <td class="max-w-55 truncate px-4 py-3 text-sm font-medium">
    <%= team_invitation.email %>
  </td>

  <td class="px-3 py-3">
    <span class="inline-flex items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-xs font-semibold capitalize text-amber-800">
      <%= team_invitation.role %> · Pending
    </span>
  </td>

  <td class="whitespace-nowrap px-3 py-3 text-sm tabular-nums text-[#6b7672] dark:text-[#9AA6A0]">
    <%# Using updated_at to reflect resend times %>
    <%= time_ago_in_words(team_invitation.updated_at) %> ago
  </td>

  <td class="px-4 py-3">
    <% if can_manage_members? %>
      <span class="flex items-center justify-end gap-2">
        <%= button_to resend_team_invitation_path(team_invitation), method: :post,
            class: "cursor-pointer rounded-lg px-2.5 py-1.5 text-[13px] font-medium text-[#6b7672] transition hover:bg-[#E9EBED] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:bg-white/10 dark:hover:text-[#E7ECE9]",
            form: { data: { turbo_submits_with: "Sending..." } } do %>
          Resend
        <% end %>
        <%= button_to "Revoke", team_invitation_path(team_invitation), method: :delete,
            class: "cursor-pointer rounded-lg bg-red-700 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-red-800",
            form: { data: { turbo_confirm: "Revoke this invitation?" } } %>
      </span>
    <% end %>
  </td>
</tr>
