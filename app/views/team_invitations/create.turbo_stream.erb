<%= turbo_stream.update "flash_messages", partial: "shared/flash" %>

<%# Remove the empty state if present, then prepend to the single list %>
<%= turbo_stream.remove "empty_state" %>
<%= turbo_stream.prepend "invitations-list", partial: "team_invitations/team_invite_row", locals: { team_invitation: @invitation } %>

<%# Close the modal and update the counter %>
<%= turbo_stream.replace "modal", "" %>
<%= turbo_stream.update "trigger_pending", "Pending Invites (#{Current.account.team_invitations.count})" %>
