<div id="<%= dom_id(invitation, :card) %>" class="rounded-2xl border border-[#D9DDE0] bg-white p-4 dark:border-white/10 dark:bg-[#131B17]">
  <div class="flex items-start justify-between gap-3">
    <p class="min-w-0 break-all text-sm font-semibold leading-snug">
      <%= invitation.email %>
    </p>
    <span class="inline-flex shrink-0 items-center rounded-full border border-amber-200 bg-amber-50 px-2.5 py-0.5 text-xs font-semibold text-amber-800">
      Pending
    </span>
  </div>
  <div class="mt-2 flex items-center justify-between text-[13px]">
    <p>
      <span class="text-[#6b7672] dark:text-[#9AA6A0]">Role:</span>
      <span class="font-medium capitalize"><%= invitation.role %></span>
    </p>
    <p class="flex items-center gap-1.5 text-[#6b7672] dark:text-[#9AA6A0]">
      <%= icon("calendar-range", css: "h-4 w-4") %>
      <span class="tabular-nums"><%= time_ago_in_words(invitation.created_at) %> ago</span>
    </p>
  </div>
  <% if can_manage_members? %>
    <div class="mt-3 flex items-center justify-end gap-2 border-t border-[#E9EBED] pt-3 text-xs dark:border-white/10">
      <%= button_to resend_team_invitation_path(invitation), method: :post,
          class: "cursor-pointer rounded-lg px-2.5 py-1.5 text-[13px] font-medium text-[#6b7672] transition hover:bg-[#E9EBED] hover:text-[#1c2420] dark:text-[#9AA6A0] dark:hover:bg-white/10 dark:hover:text-[#E7ECE9]",
          form: { data: { turbo_submits_with: "Sending..." } } do %>
        Resend
      <% end %>
      <%= button_to "Revoke", team_invitation_path(invitation), method: :delete,
          class: "cursor-pointer rounded-lg bg-red-700 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-red-800",
          form: { data: { turbo_confirm: "Revoke this invitation?" } } %>
    </div>
  <% end %>
</div>
