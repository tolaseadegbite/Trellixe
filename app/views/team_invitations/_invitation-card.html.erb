<div class="card p-4 border rounded-md shadow-sm bg-surface flex flex-col gap-3">
    <div class="flex items-start justify-between">
    <div class="font-semibold leading-tight break-all">
        <%= invitation.email %>
    </div>
    <span class="bg-yellow-100 text-yellow-800 font-medium pi-2 pb-1 rounded-md text-xs uppercase">
        Pending
    </span>
    </div>
    <div class="flex items-center justify-between text-sm">
    <div>
        <span class="text-subtle">Role:</span>
        <span class="font-medium capitalize"><%= invitation.role %></span>
    </div>
    <div class="text-subtle">
        <%= time_ago_in_words(invitation.created_at) %> ago
    </div>
    </div>
    <div class="flex items-center justify-end text-xs gap-4 border-t pt-3 mt-1">
        <%# Resend %>
        <%= button_to resend_team_invitation_path(invitation), method: :post, class: "btn text-xs text-subtle hover:text-primary hover:underline", form: { data: { turbo_submits_with: "Sending..." } } do %>
          Resend
        <% end %>

        <%= button_to "Revoke Invitation", team_invitation_path(invitation), method: :delete, class: "text-red-600 font-medium hover:text-red-700 cursor-pointer" %>
    </div>
</div>