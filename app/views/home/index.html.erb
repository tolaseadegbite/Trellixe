<% content_for :title, "Settings" %>
<% content_for :page_header, "Settings" %>

<div class="hidden w-full lg:flex">

  <aside
    class="shrink-0 p-4"
    style="width: 280px;"
    data-controller="settings-sidebar">

    <nav class="flex flex-col gap-1">

      <%= link_to "Change name", edit_identity_name_path,
            class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] aria-[current=page]:bg-algae-50 aria-[current=page]:font-semibold aria-[current=page]:text-algae-900 dark:hover:bg-white/5 dark:aria-[current=page]:bg-algae-600/15 dark:aria-[current=page]:text-algae-300",
            data: { turbo_frame: "settings_content", action: "click->settings-sidebar#select", settings_sidebar_target: "link" } %>
      <%= link_to "Change password", edit_password_path,
            class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] aria-[current=page]:bg-algae-50 aria-[current=page]:font-semibold aria-[current=page]:text-algae-900 dark:hover:bg-white/5 dark:aria-[current=page]:bg-algae-600/15 dark:aria-[current=page]:text-algae-300",
            data: { turbo_frame: "settings_content", action: "click->settings-sidebar#select", settings_sidebar_target: "link" } %>
      <%= link_to "Change email address", edit_identity_email_path,
            class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] aria-[current=page]:bg-algae-50 aria-[current=page]:font-semibold aria-[current=page]:text-algae-900 dark:hover:bg-white/5 dark:aria-[current=page]:bg-algae-600/15 dark:aria-[current=page]:text-algae-300",
            data: { turbo_frame: "settings_content", action: "click->settings-sidebar#select", settings_sidebar_target: "link" } %>
      <%= link_to "Profile Photo", edit_identity_avatar_path,
            class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] aria-[current=page]:bg-algae-50 aria-[current=page]:font-semibold aria-[current=page]:text-algae-900 dark:hover:bg-white/5 dark:aria-[current=page]:bg-algae-600/15 dark:aria-[current=page]:text-algae-300",
            data: { turbo_frame: "settings_content", action: "click->settings-sidebar#select", settings_sidebar_target: "link" } %>
      <%#= link_to "Two-Factor Authentication", new_two_factor_authentication_profile_totp_path,
            class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] aria-[current=page]:bg-algae-50 aria-[current=page]:font-semibold aria-[current=page]:text-algae-900 dark:hover:bg-white/5 dark:aria-[current=page]:bg-algae-600/15 dark:aria-[current=page]:text-algae-300",
            data: { turbo_frame: "settings_content", action: "click->settings-sidebar#select", settings_sidebar_target: "link" } %>

      <%# if Current.user.otp_required_for_sign_in? %>
        <%#= link_to "Recovery Codes", two_factor_authentication_profile_recovery_codes_path, class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] aria-[current=page]:bg-algae-50 aria-[current=page]:font-semibold aria-[current=page]:text-algae-900 dark:hover:bg-white/5 dark:aria-[current=page]:bg-algae-600/15 dark:aria-[current=page]:text-algae-300", data: { turbo_frame: "settings_content", action: "click->settings-sidebar#select", settings_sidebar_target: "link" } %>
        <%#= link_to "Security keys", two_factor_authentication_profile_security_keys_path, class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] aria-[current=page]:bg-algae-50 aria-[current=page]:font-semibold aria-[current=page]:text-algae-900 dark:hover:bg-white/5 dark:aria-[current=page]:bg-algae-600/15 dark:aria-[current=page]:text-algae-300", data: { turbo_frame: "settings_content", action: "click->settings-sidebar#select", settings_sidebar_target: "link" } %>
      <%# end %>

      <%#= link_to "Send invitation", new_invitation_path,
            class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] aria-[current=page]:bg-algae-50 aria-[current=page]:font-semibold aria-[current=page]:text-algae-900 dark:hover:bg-white/5 dark:aria-[current=page]:bg-algae-600/15 dark:aria-[current=page]:text-algae-300",
            data: { turbo_frame: "settings_content", action: "click->settings-sidebar#select", settings_sidebar_target: "link" } %>

      <hr class="my-2 border-t border-[#E9EBED] dark:border-white/10" role="separator"/>

      <h2 class="mt-4 px-2 text-lg font-semibold">Access History</h2>
      <%= link_to "Devices & Sessions", sessions_path,
            class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] aria-[current=page]:bg-algae-50 aria-[current=page]:font-semibold aria-[current=page]:text-algae-900 dark:hover:bg-white/5 dark:aria-[current=page]:bg-algae-600/15 dark:aria-[current=page]:text-algae-300",
            data: { turbo_frame: "settings_content", action: "click->settings-sidebar#select", settings_sidebar_target: "link" } %>
      <%= link_to "Activity Log", authentications_user_activities_path,
            class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] aria-[current=page]:bg-algae-50 aria-[current=page]:font-semibold aria-[current=page]:text-algae-900 dark:hover:bg-white/5 dark:aria-[current=page]:bg-algae-600/15 dark:aria-[current=page]:text-algae-300",
            data: { turbo_frame: "settings_content", action: "click->settings-sidebar#select", settings_sidebar_target: "link" } %>

      <%# <div class="border-b border-[#E9EBED] mt-4 dark:border-white/10"></div> %>

      <%= button_to "Log out", Current.session, method: :delete, class: "w-full cursor-pointer rounded-lg bg-red-700 px-3 py-2 text-left text-sm font-semibold text-white transition hover:bg-red-800" %>
    </nav>
  </aside>

  <%# --- RIGHT COLUMN: DESKTOP DYNAMIC CONTENT AREA --- %>
  <main class="grow border-l border-[#E9EBED] dark:border-white/10">
    <%= turbo_frame_tag "settings_content", src: edit_identity_name_path do %>
      <div class="flex items-center gap-3 p-4">
        <h2 class="text-2xl">Loading settings</h2>
        <%= icon("loading", css: "h-8 w-8 animate-spin text-[#8a938d] dark:text-[#9AA6A0]") %>
      </div>
    <% end %>
  </main>
</div>




<%# --- MOBILE LAYOUT (Visible on small screens) --- %>
<div class="mx-auto w-full p-4 lg:hidden"> <%# Use the opposite breakpoint class %>
  <nav class="flex flex-col gap-1">

    <%# These are NORMAL links for full-page navigation on mobile. NO Turbo Frame attributes. %>
    <%= link_to "Change name", edit_identity_name_path, class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] dark:hover:bg-white/5" %>
    <%= link_to "Change password", edit_password_path, class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] dark:hover:bg-white/5" %>
    <%= link_to "Change email address", edit_identity_email_path, class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] dark:hover:bg-white/5" %>
    <%= link_to "Profile Photo", edit_identity_avatar_path, class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] dark:hover:bg-white/5" %>
    <%#= link_to "Two-Factor Authentication", new_two_factor_authentication_profile_totp_path, class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] dark:hover:bg-white/5" %>
    <%# if Current.user.otp_required_for_sign_in? %>
      <%#= link_to "Recovery Codes", two_factor_authentication_profile_recovery_codes_path, class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] dark:hover:bg-white/5" %>
      <%#= link_to "Security keys", two_factor_authentication_profile_security_keys_path, class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] dark:hover:bg-white/5" %>
    <%# end %>
    <%#= link_to "Send invitation", new_invitation_path, class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] dark:hover:bg-white/5" %>

    <hr class="my-2 border-t border-[#E9EBED] dark:border-white/10" role="separator"/>

    <h2 class="mt-4 px-2 text-lg font-semibold">Access History</h2>
    <%= link_to "Devices & Sessions", sessions_path, class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] dark:hover:bg-white/5" %>
    <%= link_to "Activity Log", authentications_user_activities_path, class: "flex w-full items-center rounded-lg px-3 py-2 text-left text-sm font-medium transition hover:bg-[#F1F4F2] dark:hover:bg-white/5" %>

    <%= button_to "Log out", Current.session, method: :delete, class: "w-full cursor-pointer rounded-lg bg-red-700 px-3 py-2 text-left text-sm font-semibold text-white transition hover:bg-red-800" %>
  </nav>
</div>
