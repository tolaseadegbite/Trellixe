<%= turbo_frame_tag "settings_content" do %>
  <div class="p-4">

    <%= render "shared/settings_back_button" %>

    <div class="w-full max-w-3xl">
      <h1 class="mb-4 text-2xl font-bold">Change your password</h1>
      <p class="mb-4 text-[#6b7672] dark:text-[#9AA6A0]">For your security, please choose a strong, unique password that you don't use for any other online account.</p>

      <div id="edit_password_form">
        <%# I'm using your provided form code. I noticed it's missing the model, which might cause errors. %>
        <%# The form_with should ideally be: form_with(model: @user, url: password_path, method: :patch) %>
        <%= render 'form', user: @user %>
      </div>
    </div>
  </div>

<% end %>
